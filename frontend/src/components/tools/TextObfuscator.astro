---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import TextArea from '../ui/TextArea.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Text Obfuscator',
    inputLabel: 'Input Text',
    inputPlaceholder: 'Enter text to obfuscate...',
    methodLabel: 'Method',
    apply: 'Apply',
    clear: 'Clear',
    copy: 'Copy',
    emptyState: 'Enter text and click Apply to obfuscate',
    note: 'All obfuscation happens locally in your browser.',
    rot13: 'ROT13',
    reverse: 'Reverse Text',
    unicodeEncode: 'Unicode Encode',
    unicodeDecode: 'Unicode Decode',
    base64Encode: 'Base64 Encode',
    base64Decode: 'Base64 Decode',
  },
  fa: {
    title: 'مبهم‌ساز متن',
    inputLabel: 'متن ورودی',
    inputPlaceholder: 'متن را برای مبهم‌سازی وارد کنید...',
    methodLabel: 'روش',
    apply: 'اعمال',
    clear: 'پاک کردن',
    copy: 'کپی',
    emptyState: 'متن را وارد کنید و روی Apply کلیک کنید',
    note: 'تمام مبهم‌سازی به صورت محلی در مرورگر شما انجام می‌شود.',
    rot13: 'ROT13',
    reverse: 'معکوس متن',
    unicodeEncode: 'کدگذاری یونیکد',
    unicodeDecode: 'رمزگشایی یونیکد',
    base64Encode: 'کدگذاری Base64',
    base64Decode: 'رمزگشایی Base64',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="to-tool">
    <TextArea id="to-input" label={copy[lang].inputLabel} placeholder={copy[lang].inputPlaceholder} rows={5} />
    <Select id="to-method" label={copy[lang].methodLabel} options={[
      { value: 'rot13', label: copy[lang].rot13 },
      { value: 'reverse', label: copy[lang].reverse },
      { value: 'unicode-encode', label: copy[lang].unicodeEncode },
      { value: 'unicode-decode', label: copy[lang].unicodeDecode },
      { value: 'base64-encode', label: copy[lang].base64Encode },
      { value: 'base64-decode', label: copy[lang].base64Decode },
    ]} />
    <div class="tool-toolbar">
      <ToolActionButton id="to-apply">{copy[lang].apply}</ToolActionButton>
      <Button id="to-clear" variant="secondary">{copy[lang].clear}</Button>
      <Button id="to-copy" variant="outline">{copy[lang].copy}</Button>
    </div>
    <div id="to-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>
    <div id="to-result" class="tool-output" style="display:none" role="status" aria-live="polite"></div>
    <div id="to-error" class="tool-error" style="display:none"></div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { rot13, reverseText, unicodeEncode, unicodeDecode, base64Encode, base64Decode } from './Phase9Utils.ts';

  const input = document.getElementById('to-input') as HTMLTextAreaElement;
  const method = document.getElementById('to-method') as HTMLSelectElement;
  const applyBtn = document.getElementById('to-apply') as HTMLButtonElement;
  const clearBtn = document.getElementById('to-clear') as HTMLButtonElement;
  const copyBtn = document.getElementById('to-copy') as HTMLButtonElement;
  const emptyEl = document.getElementById('to-empty')!;
  const resultEl = document.getElementById('to-result')!;
  const errorEl = document.getElementById('to-error')!;

  function doObfuscate() {
    const text = input.value;
    const m = method.value;
    if (!text) {
      errorEl.textContent = 'Please enter some text';
      errorEl.style.display = '';
      emptyEl.style.display = 'none';
      resultEl.style.display = 'none';
      return;
    }
    errorEl.style.display = 'none';
    try {
      let result = '';
      switch (m) {
        case 'rot13': result = rot13(text); break;
        case 'reverse': result = reverseText(text); break;
        case 'unicode-encode': result = unicodeEncode(text); break;
        case 'unicode-decode': result = unicodeDecode(text); break;
        case 'base64-encode': result = base64Encode(text); break;
        case 'base64-decode': result = base64Decode(text); break;
        default: throw new Error('Unknown method');
      }
      emptyEl.style.display = 'none';
      resultEl.style.display = '';
      resultEl.textContent = result;
    } catch (e: any) {
      errorEl.textContent = 'Error: ' + (e.message || String(e));
      errorEl.style.display = '';
      resultEl.style.display = 'none';
    }
  }

  applyBtn.addEventListener('click', doObfuscate);

  clearBtn.addEventListener('click', () => {
    input.value = '';
    emptyEl.style.display = '';
    resultEl.style.display = 'none';
    errorEl.style.display = 'none';
    input.focus();
  });

  copyBtn.addEventListener('click', () => {
    const text = resultEl.textContent || '';
    if (!text || resultEl.style.display === 'none') return;
    window.__belbooreTools.copyToClipboard(text, copyBtn, 1500);
  });

  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.ctrlKey) doObfuscate(); });
</script>

<style>
  .to-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .to-tool .tool-note { margin-top: 0; }
</style>
