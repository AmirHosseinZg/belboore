---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Emoji Search & Copy',
    searchPlaceholder: 'Search emojis by name or keyword...',
    all: 'All',
    emptyState: 'No emojis found matching your search.',
    note: 'Click any emoji to copy it to your clipboard. Search by name or keyword.',
    copied: 'Copied!',
    clickToCopy: 'Click to copy',
  },
  fa: {
    title: 'جستجو و کپی ایموجی',
    searchPlaceholder: 'جستجوی ایموجی با نام یا کلمه کلیدی...',
    all: 'همه',
    emptyState: 'هیچ ایموجی‌ای با جستجوی شما مطابقت ندارد.',
    note: 'روی هر ایموجی کلیک کنید تا در کلیپ‌بورد کپی شود. جستجو بر اساس نام یا کلمه کلیدی.',
    copied: 'کپی شد!',
    clickToCopy: 'برای کپی کلیک کنید',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="es-tool">
    <Input id="es-search" placeholder={copy[lang].searchPlaceholder} inputClassName="es-search-input" />
    <div id="es-categories" class="es-categories"></div>
    <div id="es-grid" class="es-grid" role="status" aria-live="polite">
      <div class="tool-output tool-output--empty" id="es-loading">Loading emojis...</div>
    </div>
    <div id="es-empty" class="tool-output tool-output--empty" style="display:none">{copy[lang].emptyState}</div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { EMOJI_DATA, EMOJI_CATEGORIES, searchEmojis } from './Phase9Utils.ts';

  const searchInput = document.getElementById('es-search') as HTMLInputElement;
  const categoriesEl = document.getElementById('es-categories')!;
  const gridEl = document.getElementById('es-grid')!;
  const emptyEl = document.getElementById('es-empty')!;

  let currentCategory = '';
  let allEmojis: typeof EMOJI_DATA = [];

  function renderCategories() {
    let html = '<button class="es-cat-btn es-cat-btn--active" data-cat="">All</button>';
    for (const cat of EMOJI_CATEGORIES) {
      html += `<button class="es-cat-btn" data-cat="${cat}">${cat}</button>`;
    }
    categoriesEl.innerHTML = html;
    categoriesEl.querySelectorAll('.es-cat-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        categoriesEl.querySelectorAll('.es-cat-btn').forEach(b => b.classList.remove('es-cat-btn--active'));
        btn.classList.add('es-cat-btn--active');
        currentCategory = (btn as HTMLElement).dataset.cat || '';
        renderGrid();
      });
    });
  }

  function renderGrid() {
    const query = searchInput.value;
    const results = searchEmojis(query, currentCategory);
    if (results.length === 0) {
      gridEl.style.display = 'none';
      emptyEl.style.display = '';
      return;
    }
    emptyEl.style.display = 'none';
    gridEl.style.display = '';
    let html = '';
    for (const emoji of results) {
      html += `<button class="es-emoji-btn" data-emoji="${emoji.emoji}" title="${emoji.name}">${emoji.emoji}</button>`;
    }
    gridEl.innerHTML = html;

    gridEl.querySelectorAll('.es-emoji-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const emoji = (btn as HTMLElement).dataset.emoji || '';
        if (!emoji) return;
        try {
          await navigator.clipboard.writeText(emoji);
          const orig = btn.innerHTML;
          btn.innerHTML = '<span style="font-size:var(--text-xs);color:var(--color-success)">Copied!</span>';
          btn.classList.add('es-emoji-btn--copied');
          setTimeout(() => {
            btn.innerHTML = orig;
            btn.classList.remove('es-emoji-btn--copied');
          }, 1000);
        } catch {}
      });
    });
  }

  searchInput.addEventListener('input', renderGrid);
  renderCategories();
  renderGrid();
</script>

<style>
  .es-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .es-tool .tool-note { margin-top: 0; }
  .es-search-input { width: 100%; }
  .es-categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .es-cat-btn {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    background: var(--surface-primary);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }
  .es-cat-btn:hover {
    background: var(--surface-tertiary);
    color: var(--text-primary);
  }
  .es-cat-btn--active {
    background: var(--color-tech-blue);
    color: white;
    border-color: var(--color-tech-blue);
  }
  .es-cat-btn--active:hover {
    background: var(--color-tech-blue-hover);
  }
  .es-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(48px, 1fr));
    gap: var(--space-2);
    max-height: 400px;
    overflow-y: auto;
  }
  .es-emoji-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    font-size: 1.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-primary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    padding: 0;
  }
  .es-emoji-btn:hover {
    background: var(--surface-tertiary);
    border-color: var(--color-tech-blue);
    transform: scale(1.1);
    z-index: 1;
  }
  .es-emoji-btn--copied {
    border-color: var(--color-success);
    background: var(--color-success-subtle);
  }
</style>
