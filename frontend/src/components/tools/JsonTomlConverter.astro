---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import { Copy, Trash2, FileJson } from '@lucide/astro';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import Button from '../ui/Button.astro';
import TextArea from '../ui/TextArea.astro';
import ConverterDirectionToggle from './ConverterDirectionToggle.astro';
import ConverterRelatedTools from './ConverterRelatedTools.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'JSON ↔ TOML Converter',
    inputLabel: 'Input',
    outputLabel: 'Output',
    inputHint: 'Paste JSON or TOML depending on selected direction.',
    outputHint: 'Converted output appears here.',
    convert: 'Convert',
    copy: 'Copy result',
    clear: 'Clear',
    loadExample: 'Load example',
    empty: 'Converted output will appear here',
    note: 'All processing happens in your browser. Your data is never uploaded.',
    copied: 'Copied!',
    jsonLabel: 'JSON',
    tomlLabel: 'TOML',
  },
  fa: {
    title: 'مبدل JSON ↔ TOML',
    inputLabel: 'ورودی',
    outputLabel: 'خروجی',
    inputHint: 'بسته به جهت انتخاب شده، JSON یا TOML را وارد کنید.',
    outputHint: 'خروجی تبدیل شده اینجا نمایش داده می‌شود.',
    convert: 'تبدیل',
    copy: 'کپی نتیجه',
    clear: 'پاک کردن',
    loadExample: 'نمونه',
    empty: 'خروجی تبدیل شده اینجا نمایش داده می‌شود',
    note: 'تمام پردازش‌ها در مرورگر شما انجام می‌شود. داده‌های شما آپلود نمی‌شود.',
    copied: 'کپی شد!',
    jsonLabel: 'JSON',
    tomlLabel: 'TOML',
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section
    class="converter-tool"
    dir={dir}
    data-empty={copy.empty}
    data-copied={copy.copied}
    data-json-label={copy.jsonLabel}
    data-toml-label={copy.tomlLabel}
    data-placeholder-json='{\n  "key": "value"\n}'
    data-placeholder-toml='# Enter TOML here\nkey = "value"\n[section]\nitem = 1'
  >
    <div class="converter-tool__controls">
      <ConverterDirectionToggle
        id="jt-swap"
        labelA={copy.jsonLabel}
        labelB={copy.tomlLabel}
        direction="a-to-b"
      />
      <div class="converter-tool__controls-actions">
        <Button id="jt-copy" variant="outline" className="converter-tool__icon-btn" aria-label={copy.copy} title={copy.copy}>
          <Copy size={17} />
        </Button>
        <Button id="jt-clear" variant="danger" className="converter-tool__icon-btn" aria-label={copy.clear} title={copy.clear}>
          <Trash2 size={17} />
        </Button>
        <Button id="jt-example" variant="secondary" className="converter-tool__icon-btn" aria-label={copy.loadExample} title={copy.loadExample}>
          <FileJson size={17} />
        </Button>
      </div>
    </div>

    <div class="converter-tool__grid">
      <div class="converter-tool__panel">
        <div class="converter-tool__panel-head">
          <label class="converter-tool__label" for="jt-input">{copy.inputLabel}</label>
          <p class="converter-tool__hint">{copy.inputHint}</p>
        </div>
        <div class="converter-tool__textarea-shell">
          <TextArea
            id="jt-input"
            className="converter-tool__textarea"
            placeholder={copy.jsonLabel === 'JSON' ? '{\n  "key": "value"\n}' : ''}
            rows={14}
            spellcheck="false"
          />
        </div>
      </div>

      <div class="converter-tool__panel">
        <div class="converter-tool__panel-head">
          <label class="converter-tool__label" for="jt-output">{copy.outputLabel}</label>
          <p class="converter-tool__hint">{copy.outputHint}</p>
        </div>
        <div class="converter-tool__textarea-shell">
          <textarea
            id="jt-output"
            class="converter-tool__textarea converter-tool__textarea--output"
            rows={14}
            readonly
            spellcheck="false"
            placeholder={copy.empty}
          ></textarea>
        </div>
      </div>
    </div>

    <div class="converter-tool__toolbar">
      <ToolActionButton id="jt-run">
        {copy.convert}
      </ToolActionButton>
    </div>

    <div id="jt-error" class="tool-error" style="display: none;" role="alert"></div>

    <ConverterRelatedTools lang={lang} currentSlug="json-toml-converter" />

    <div class="tool-note converter-tool__note">
      {copy.note}
    </div>
  </section>
</ToolWorkspace>

<script>
  import toml from '@iarna/toml';

  const root = document.querySelector('.converter-tool') as HTMLElement | null;
  const input = document.getElementById('jt-input') as HTMLTextAreaElement | null;
  const output = document.getElementById('jt-output') as HTMLTextAreaElement | null;
  const errorDiv = document.getElementById('jt-error') as HTMLDivElement | null;
  const runBtn = document.getElementById('jt-run') as HTMLButtonElement | null;
  const swapBtn = document.getElementById('jt-swap') as HTMLButtonElement | null;
  const copyBtn = document.getElementById('jt-copy') as HTMLButtonElement | null;
  const clearBtn = document.getElementById('jt-clear') as HTMLButtonElement | null;
  const exampleBtn = document.getElementById('jt-example') as HTMLButtonElement | null;

  let direction: 'a-to-b' | 'b-to-a' = 'a-to-b';

  const JSON_SAMPLE = JSON.stringify({
    title: "Belboore",
    version: 1.0,
    active: true,
    metadata: { author: "Developer", license: "MIT" },
    features: { items: ["json", "toml"], count: 2 }
  }, null, 2);

  const TOML_SAMPLE = `# Belboore config
title = "Belboore"
version = 1.0
active = true

[metadata]
author = "Developer"
license = "MIT"

[features]
items = ["json", "toml"]
count = 2`;

  function getData(key: string, fallback: string): string {
    return root?.dataset[key] || fallback;
  }

  function updateUI() {
    const fromLabel = direction === 'a-to-b' ? getData('json-label', 'JSON') : getData('toml-label', 'TOML');
    const toLabel = direction === 'a-to-b' ? getData('toml-label', 'TOML') : getData('json-label', 'JSON');
    const dirLabels = root?.querySelector('.converter-direction-toggle__labels');
    if (dirLabels) {
      const spans = dirLabels.querySelectorAll('.converter-direction-toggle__label');
      if (spans.length >= 2) { spans[0].textContent = fromLabel; spans[1].textContent = toLabel; }
    }
    const ph = direction === 'a-to-b' ? getData('placeholder-json', '{\n  "key": "value"\n}') : getData('placeholder-toml', '# Enter TOML here');
    if (input) input.placeholder = ph;
    if (output) { output.value = ''; output.placeholder = getData('empty', ''); }
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
  }

  function runConvert() {
    if (!input || !output) return;
    const val = input.value.trim();
    if (!val) {
      output.value = ''; output.placeholder = getData('empty', '');
      if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
      return;
    }
    try {
      let result: string;
      if (direction === 'a-to-b') {
        const parsed = JSON.parse(val);
        if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
          throw new Error('TOML requires a root object/table. The JSON input must be an object (not an array, string, number, boolean, or null).');
        }
        result = toml.stringify(parsed);
      } else {
        const parsed = toml.parse(val);
        result = JSON.stringify(parsed, null, 2);
      }
      output.value = result; output.placeholder = '';
      if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    } catch (e: any) {
      output.value = ''; output.placeholder = getData('empty', '');
      const prefix = direction === 'a-to-b' ? 'JSON to TOML error:' : 'TOML parse error:';
      if (errorDiv) { errorDiv.textContent = `${prefix} ${e?.message || 'Conversion failed'}`; errorDiv.style.display = ''; }
    }
  }

  runBtn?.addEventListener('click', runConvert);
  swapBtn?.addEventListener('click', () => {
    if (!input || !output) return;
    direction = direction === 'a-to-b' ? 'b-to-a' : 'a-to-b';
    const currentOutput = output.value;
    if (currentOutput) input.value = currentOutput;
    output.value = ''; output.placeholder = getData('empty', '');
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    updateUI(); input.focus();
  });
  copyBtn?.addEventListener('click', () => {
    if (!output || !output.value) return;
    navigator.clipboard.writeText(output.value).then(() => { copyBtn.classList.add('is-copied'); window.setTimeout(() => copyBtn.classList.remove('is-copied'), 1200); }).catch(() => {});
  });
  clearBtn?.addEventListener('click', () => {
    if (!input || !output) return;
    input.value = ''; output.value = ''; output.placeholder = getData('empty', '');
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    input.focus();
  });
  exampleBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = direction === 'a-to-b' ? JSON_SAMPLE : TOML_SAMPLE;
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    input.focus(); runConvert();
  });
  input?.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') { event.preventDefault(); runConvert(); }
  });
</script>

<style>
  .converter-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .converter-tool__controls { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
  .converter-tool__controls-actions { display: flex; gap: var(--space-2); align-items: center; }
  .converter-tool__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .converter-tool__panel { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding: var(--space-3) var(--space-4); border: 1px solid transparent; border-radius: calc(var(--radius-lg) - 4px); background: var(--surface-tertiary); transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
  .converter-tool__panel:focus-within { border-color: var(--color-tech-blue); box-shadow: 0 0 0 3px var(--color-tech-blue-subtle); }
  .converter-tool__panel-head { display: flex; flex-direction: column; gap: var(--space-1); }
  .converter-tool__label { color: var(--text-secondary); font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.06em; }
  .converter-tool__hint { margin: 0; color: var(--text-muted); font-size: var(--text-xs); line-height: var(--leading-snug); }
  .converter-tool__textarea { width: 100%; min-height: 240px; padding: var(--space-4); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.6; color: var(--text-primary); background: var(--surface-primary); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); resize: vertical; outline: none; transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
  .converter-tool__textarea:focus { border-color: var(--color-tech-blue); box-shadow: 0 0 0 3px var(--color-tech-blue-subtle); }
  .converter-tool__textarea::placeholder { color: var(--text-muted); }
  .converter-tool__textarea--output { background: var(--surface-secondary); resize: none; }
  .converter-tool__textarea--output:focus { border-color: var(--border-subtle); box-shadow: none; }
  .converter-tool__toolbar { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .converter-tool .tool-action-button { min-width: 148px; }
  .converter-tool__icon-btn.ui-button { min-width: 42px; min-height: 42px; padding: 0; gap: 0; }
  .converter-tool__note { margin-top: 0; }
  @media (max-width: 768px) { .converter-tool__grid { grid-template-columns: 1fr; } .converter-tool .tool-action-button { width: 100%; min-width: 0; } .converter-tool__controls { flex-direction: column; align-items: stretch; } .converter-tool__controls-actions { justify-content: center; } }
</style>
