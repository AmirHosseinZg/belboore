---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import TextArea from '../ui/TextArea.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Numeronym Generator',
    inputLabel: 'Input Text',
    inputPlaceholder: 'Enter words to convert to numeronyms...',
    minLenLabel: 'Min word length',
    generate: 'Generate',
    clear: 'Clear',
    copy: 'Copy',
    emptyState: 'Enter text and click Generate to create numeronyms',
    note: 'Numeronyms like "internationalization" \u2192 "i18n" are generated locally.',
    original: 'Original',
    numeronym: 'Numeronym',
    noWords: 'No words found matching the minimum length criteria.',
  },
  fa: {
    title: 'تولید Numeronym',
    inputLabel: 'متن ورودی',
    inputPlaceholder: 'کلمات را برای تبدیل به numeronym وارد کنید...',
    minLenLabel: 'حداقل طول کلمه',
    generate: 'تولید',
    clear: 'پاک کردن',
    copy: 'کپی',
    emptyState: 'متن را وارد کنید و روی Generate کلیک کنید',
    note: 'Numeronym هایی مانند "بین‌المللی" \u2192 "ب11ی" به صورت محلی تولید می‌شوند.',
    original: 'اصلی',
    numeronym: 'Numeronym',
    noWords: 'هیچ کلمه‌ای با حداقل طول مشخص شده یافت نشد.',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="ng-tool">
    <TextArea id="ng-input" label={copy[lang].inputLabel} placeholder={copy[lang].inputPlaceholder} rows={4} />
    <Input id="ng-minlen" label={copy[lang].minLenLabel} type="number" value="3" inputClassName="ng-minlen-input" />
    <div class="tool-toolbar">
      <ToolActionButton id="ng-generate">{copy[lang].generate}</ToolActionButton>
      <Button id="ng-clear" variant="secondary">{copy[lang].clear}</Button>
      <Button id="ng-copy" variant="outline">{copy[lang].copy}</Button>
    </div>
    <div id="ng-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>
    <div id="ng-result-card" class="ng-result-card" style="display:none">
      <div class="ng-result-header">
        <span class="ng-result-label">Numeronym Result</span>
      </div>
      <div id="ng-result" class="ng-result-value" role="status" aria-live="polite"></div>
    </div>
    <div id="ng-breakdown" class="ng-breakdown" style="display:none">
      <div class="ng-breakdown-header">Breakdown</div>
      <table class="ng-table">
        <thead><tr><th>{copy[lang].original}</th><th>{copy[lang].numeronym}</th></tr></thead>
        <tbody id="ng-tbody"></tbody>
      </table>
    </div>
    <div id="ng-error" class="tool-error" style="display:none"></div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { generateNumeronyms } from './Phase9Utils.ts';

  const input = document.getElementById('ng-input') as HTMLTextAreaElement;
  const minLen = document.getElementById('ng-minlen') as HTMLInputElement;
  const genBtn = document.getElementById('ng-generate') as HTMLButtonElement;
  const clearBtn = document.getElementById('ng-clear') as HTMLButtonElement;
  const copyBtn = document.getElementById('ng-copy') as HTMLButtonElement;
  const emptyEl = document.getElementById('ng-empty')!;
  const resultCard = document.getElementById('ng-result-card')!;
  const resultEl = document.getElementById('ng-result')!;
  const breakdownEl = document.getElementById('ng-breakdown')!;
  const tbodyEl = document.getElementById('ng-tbody')!;
  const errorEl = document.getElementById('ng-error')!;

  genBtn.addEventListener('click', () => {
    const text = input.value;
    const min = parseInt(minLen.value, 10) || 3;
    if (!text) {
      errorEl.textContent = 'Please enter some text';
      errorEl.style.display = '';
      emptyEl.style.display = 'none';
      resultCard.style.display = 'none';
      breakdownEl.style.display = 'none';
      return;
    }
    errorEl.style.display = 'none';
    try {
      const { result, breakdown } = generateNumeronyms(text, min);
      emptyEl.style.display = 'none';
      resultCard.style.display = '';
      resultEl.textContent = result;
      tbodyEl.innerHTML = '';
      let hasRows = false;
      for (const item of breakdown) {
        if (item.original !== item.numeronym) {
          hasRows = true;
          const tr = document.createElement('tr');
          tr.innerHTML = `<td>${item.original}</td><td><code>${item.numeronym}</code></td>`;
          tbodyEl.appendChild(tr);
        }
      }
      breakdownEl.style.display = hasRows ? '' : 'none';
      if (!hasRows) {
        emptyEl.style.display = '';
        emptyEl.textContent = text;
      }
    } catch (e: any) {
      errorEl.textContent = 'Error: ' + (e.message || String(e));
      errorEl.style.display = '';
      resultCard.style.display = 'none';
      breakdownEl.style.display = 'none';
    }
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    emptyEl.style.display = '';
    resultCard.style.display = 'none';
    breakdownEl.style.display = 'none';
    errorEl.style.display = 'none';
    input.focus();
  });

  copyBtn.addEventListener('click', () => {
    const text = resultEl.textContent || '';
    if (!text || resultCard.style.display === 'none') return;
    window.__belbooreTools.copyToClipboard(text, copyBtn, 1500);
  });
</script>

<style>
  .ng-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .ng-tool .tool-note { margin-top: 0; }
  .ng-minlen-input { width: 80px; }
  .ng-result-card {
    background: var(--surface-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ng-result-header {
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-primary);
  }
  .ng-result-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ng-result-value {
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    word-break: break-all;
    line-height: 1.6;
  }
  .ng-breakdown { margin-top: var(--space-4); }
  .ng-breakdown-header {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
    padding-inline: var(--space-1);
  }
  .ng-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .ng-table th, .ng-table td {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
  }
  .ng-table th {
    font-weight: var(--weight-semibold);
    color: var(--text-tertiary);
    text-transform: uppercase;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }
  .ng-table code {
    font-size: var(--text-sm);
    background: var(--surface-tertiary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }
</style>
