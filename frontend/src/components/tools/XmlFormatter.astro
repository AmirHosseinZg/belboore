---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import Button from '../ui/Button.astro';
import TextArea from '../ui/TextArea.astro';
import Select from '../ui/Select.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'XML Formatter / فرمت‌دهی XML',
    inputLabel: 'XML Input',
    outputLabel: 'Formatted XML',
    inputHint: 'Paste your XML here.',
    outputHint: 'Formatted XML will appear here.',
    format: 'Format',
    minify: 'Minify',
    copy: 'Copy',
    clear: 'Clear',
    loadExample: 'Load example',
    copied: 'Copied!',
    empty: 'Formatted XML will appear here',
    note: 'All processing happens in your browser. Your data is never uploaded.',
    error: 'XML validation error',
    indentSize: 'Indent size',
    exampleXml: '<?xml version="1.0" encoding="UTF-8"?><root><person><name>John</name><age>30</age><city>New York</city></person><person><name>Jane</name><age>25</age><city>London</city></person></root>',
  },
  fa: {
    title: 'فرمت‌دهی XML',
    inputLabel: 'ورودی XML',
    outputLabel: 'XML فرمت شده',
    inputHint: 'کد XML خود را اینجا وارد کنید.',
    outputHint: 'XML فرمت شده اینجا نمایش داده می‌شود.',
    format: 'فرمت',
    minify: 'فشرده‌سازی',
    copy: 'کپی',
    clear: 'پاک کردن',
    loadExample: 'نمونه',
    copied: 'کپی شد!',
    empty: 'XML فرمت شده اینجا نمایش داده می‌شود',
    note: 'تمام پردازش‌ها در مرورگر شما انجام می‌شود. داده‌های شما آپلود نمی‌شود.',
    error: 'خطای اعتبارسنجی XML',
    indentSize: 'اندازه تورفتگی',
    exampleXml: '<?xml version="1.0" encoding="UTF-8"?><root><person><name>John</name><age>30</age><city>New York</city></person><person><name>Jane</name><age>25</age><city>London</city></person></root>',
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section class="xml-tool" dir={dir} data-empty={copy.empty} data-copied={copy.copied} data-error={copy.error}>
    <div class="xml-tool__settings">
      <Select id="xml-indent" label={copy.indentSize} className="xml-tool__select xml-tool__select--sm" selectedValue="2" options={[
        { value: '2', label: '2' },
        { value: '4', label: '4' },
      ]} />
    </div>

    <div class="xml-tool__grid">
      <div class="xml-tool__panel">
        <div class="xml-tool__panel-head">
          <label class="xml-tool__label" for="xml-input">{copy.inputLabel}</label>
          <p class="xml-tool__hint">{copy.inputHint}</p>
        </div>
        <TextArea id="xml-input" className="xml-tool__textarea" placeholder={copy.exampleXml} rows={12} spellcheck="false" />
      </div>

      <div class="xml-tool__panel">
        <div class="xml-tool__panel-head">
          <label class="xml-tool__label" for="xml-output">{copy.outputLabel}</label>
          <p class="xml-tool__hint">{copy.outputHint}</p>
        </div>
        <textarea id="xml-output" class="xml-tool__textarea xml-tool__textarea--output" rows={12} readonly spellcheck="false" placeholder={copy.empty}></textarea>
      </div>
    </div>

    <div class="xml-tool__toolbar">
      <ToolActionButton id="xml-run">{copy.format}</ToolActionButton>
      <Button id="xml-minify" variant="secondary">{copy.minify}</Button>
      <Button id="xml-copy" variant="outline">{copy.copy}</Button>
      <Button id="xml-clear" variant="danger">{copy.clear}</Button>
      <Button id="xml-example" variant="secondary">{copy.loadExample}</Button>
    </div>

    <div id="xml-error" class="tool-error" style="display: none;" role="alert"></div>

    <div class="tool-note xml-tool__note">{copy.note}</div>
  </section>
</ToolWorkspace>

<script>
  const input = document.getElementById('xml-input') as HTMLTextAreaElement | null;
  const output = document.getElementById('xml-output') as HTMLTextAreaElement | null;
  const errorDiv = document.getElementById('xml-error') as HTMLDivElement | null;
  const runBtn = document.getElementById('xml-run') as HTMLButtonElement | null;
  const minifyBtn = document.getElementById('xml-minify') as HTMLButtonElement | null;
  const copyBtn = document.getElementById('xml-copy') as HTMLButtonElement | null;
  const clearBtn = document.getElementById('xml-clear') as HTMLButtonElement | null;
  const exampleBtn = document.getElementById('xml-example') as HTMLButtonElement | null;
  const indentSelect = document.getElementById('xml-indent') as HTMLSelectElement | null;

  const root = document.querySelector('.xml-tool') as HTMLElement | null;

  function getData(key: string, fallback: string): string {
    return root?.dataset[key] || fallback;
  }

  function formatXml(xml: string, indentSize: number): string {
    let formatted = '';
    let indent = 0;
    const tokens = xml.replace(/>\s*</g, '>\n<').split('\n');
    tokens.forEach(line => {
      const trimmed = line.trim();
      if (!trimmed) return;
      if (trimmed.startsWith('</')) {
        indent--;
      }
      formatted += ' '.repeat(indent * indentSize) + trimmed + '\n';
      if (trimmed.startsWith('<?') || (trimmed.startsWith('<') && trimmed.includes('/>') && !trimmed.startsWith('</'))) {
        return;
      }
      if (trimmed.startsWith('<') && !trimmed.startsWith('</') && !trimmed.endsWith('/>')) {
        indent++;
      }
    });
    return formatted.trim();
  }

  function validateXml(xml: string): boolean {
    const parser = new DOMParser();
    const doc = parser.parseFromString(xml, 'application/xml');
    const parseError = doc.querySelector('parsererror');
    return !parseError;
  }

  function getValidationError(xml: string): string {
    const parser = new DOMParser();
    const doc = parser.parseFromString(xml, 'application/xml');
    const parseError = doc.querySelector('parsererror');
    return parseError ? parseError.textContent || 'Unknown error' : '';
  }

  function runFormat() {
    if (!input || !output) return;
    const val = input.value.trim();
    if (!val) { output.value = ''; output.placeholder = getData('empty', ''); if (errorDiv) errorDiv.style.display = 'none'; return; }

    const indentSize = parseInt(indentSelect?.value || '2', 10);

    if (!validateXml(val)) {
      const errMsg = getValidationError(val);
      output.value = '';
      output.placeholder = getData('empty', '');
      if (errorDiv) { errorDiv.textContent = `${getData('error', 'XML validation error')}: ${errMsg}`; errorDiv.style.display = ''; }
      return;
    }

    try {
      const result = formatXml(val, indentSize);
      output.value = result;
      output.placeholder = '';
      if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    } catch (e: any) {
      output.value = '';
      output.placeholder = getData('empty', '');
      if (errorDiv) { errorDiv.textContent = `${getData('error', 'XML validation error')}: ${e?.message || ''}`; errorDiv.style.display = ''; }
    }
  }

  function runMinify() {
    if (!input || !output) return;
    const val = input.value.trim();
    if (!val) { output.value = ''; output.placeholder = getData('empty', ''); if (errorDiv) errorDiv.style.display = 'none'; return; }

    if (!validateXml(val)) {
      const errMsg = getValidationError(val);
      output.value = '';
      output.placeholder = getData('empty', '');
      if (errorDiv) { errorDiv.textContent = `${getData('error', 'XML validation error')}: ${errMsg}`; errorDiv.style.display = ''; }
      return;
    }

    try {
      const result = val.replace(/>\s+</g, '><').trim();
      output.value = result;
      output.placeholder = '';
      if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    } catch (e: any) {
      output.value = '';
      output.placeholder = getData('empty', '');
      if (errorDiv) { errorDiv.textContent = `${getData('error', 'XML validation error')}: ${e?.message || ''}`; errorDiv.style.display = ''; }
    }
  }

  runBtn?.addEventListener('click', runFormat);
  minifyBtn?.addEventListener('click', runMinify);

  input?.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') { event.preventDefault(); runFormat(); }
  });

  copyBtn?.addEventListener('click', () => {
    if (!output || !output.value) return;
    navigator.clipboard.writeText(output.value).then(() => {
      copyBtn.classList.add('is-copied');
      const orig = copyBtn.innerHTML;
      copyBtn.innerHTML = copy.copied;
      setTimeout(() => { copyBtn.innerHTML = orig; copyBtn.classList.remove('is-copied'); }, 1200);
    }).catch(() => {});
  });

  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    if (output) { output.value = ''; output.placeholder = getData('empty', ''); }
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    input?.focus();
  });

  exampleBtn?.addEventListener('click', () => {
    if (input) input.value = copy.exampleXml;
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    runFormat();
  });
</script>

<style>
  .xml-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .xml-tool__settings { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: flex-end; padding: var(--space-4); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-tertiary); }
  .xml-tool__select--sm { min-width: 100px; }
  .xml-tool__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .xml-tool__panel { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding: var(--space-3) var(--space-4); border: 1px solid transparent; border-radius: calc(var(--radius-lg) - 4px); background: var(--surface-tertiary); transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
  .xml-tool__panel:focus-within { border-color: var(--color-tech-blue); box-shadow: 0 0 0 3px var(--color-tech-blue-subtle); }
  .xml-tool__panel-head { display: flex; flex-direction: column; gap: var(--space-1); }
  .xml-tool__label { color: var(--text-secondary); font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.06em; }
  .xml-tool__hint { margin: 0; color: var(--text-muted); font-size: var(--text-xs); line-height: var(--leading-snug); }
  .xml-tool__textarea { width: 100%; min-height: 240px; padding: var(--space-4); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.6; color: var(--text-primary); background: var(--surface-primary); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); resize: vertical; outline: none; transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
  .xml-tool__textarea:focus { border-color: var(--color-tech-blue); box-shadow: 0 0 0 3px var(--color-tech-blue-subtle); }
  .xml-tool__textarea::placeholder { color: var(--text-muted); }
  .xml-tool__textarea--output { background: var(--surface-secondary); resize: none; }
  .xml-tool__textarea--output:focus { border-color: var(--border-subtle); box-shadow: none; }
  .xml-tool__toolbar { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .xml-tool .tool-action-button { min-width: 148px; }
  .xml-tool__note { margin-top: 0; }
  @media (max-width: 768px) { .xml-tool__grid { grid-template-columns: 1fr; } .xml-tool .tool-action-button { width: 100%; min-width: 0; } .xml-tool__settings { flex-direction: column; align-items: stretch; } .xml-tool__toolbar { flex-direction: column; } .xml-tool__toolbar .ui-button, .xml-tool__toolbar .tool-action-button { width: 100%; } }
</style>
