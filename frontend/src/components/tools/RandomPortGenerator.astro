---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Random Port Generator',
    countLabel: 'Count',
    minPortLabel: 'Min port',
    maxPortLabel: 'Max port',
    rangeLabel: 'Range',
    rangeDynamic: 'Dynamic/Private (49152-65535)',
    rangeRegistered: 'Registered (1024-49151)',
    rangeCustom: 'Custom',
    generate: 'Generate',
    copyAll: 'Copy All',
    clear: 'Clear',
    empty: 'Click Generate to create random ports',
    copied: 'Copied!',
    note: 'Generated ports are random suggestions. This tool does not check whether a port is currently available on your system.',
  },
  fa: {
    title: 'تولید پورت تصادفی',
    countLabel: 'تعداد',
    minPortLabel: 'حداقل پورت',
    maxPortLabel: 'حداکثر پورت',
    rangeLabel: 'محدوده',
    rangeDynamic: 'پویا/خصوصی (49152-65535)',
    rangeRegistered: 'ثبت‌شده (1024-49151)',
    rangeCustom: 'دلخواه',
    generate: 'تولید',
    copyAll: 'کپی همه',
    clear: 'پاک کردن',
    empty: 'برای تولید پورت تصادفی کلیک کنید',
    copied: 'کپی شد!',
    note: 'پورت‌های تولید شده پیشنهادات تصادفی هستند. این ابزار در دسترس بودن پورت در سیستم شما را بررسی نمی‌کند.',
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section class="rpg-tool" dir={dir} data-empty={copy.empty} data-copied={copy.copied}>
    <div class="rpg-tool__controls">
      <div class="rpg-tool__field-row">
        <Input id="rpg-count" label={copy.countLabel} type="number" className="rpg-tool__count-input" value="5" inputClassName="rpg-tool__num-field" />
        <Input id="rpg-min" label={copy.minPortLabel} type="number" className="rpg-tool__port-input" value="49152" inputClassName="rpg-tool__num-field" />
        <Input id="rpg-max" label={copy.maxPortLabel} type="number" className="rpg-tool__port-input" value="65535" inputClassName="rpg-tool__num-field" />
      </div>
      <div class="rpg-tool__actions">
        <Button id="rpg-copy-all" variant="outline">{copy.copyAll}</Button>
        <Button id="rpg-clear" variant="danger">{copy.clear}</Button>
      </div>
    </div>

    <div class="rpg-tool__range-presets">
      <span class="rpg-tool__range-label">{copy.rangeLabel}</span>
      <label class="rpg-tool__radio">
        <input type="radio" name="rpg-range" value="dynamic" checked />
        {copy.rangeDynamic}
      </label>
      <label class="rpg-tool__radio">
        <input type="radio" name="rpg-range" value="registered" />
        {copy.rangeRegistered}
      </label>
      <label class="rpg-tool__radio">
        <input type="radio" name="rpg-range" value="custom" />
        {copy.rangeCustom}
      </label>
    </div>

    <div class="rpg-tool__output-shell">
      <div id="rpg-output" class="tool-output tool-output--empty rpg-tool__output" role="status" aria-live="polite">{copy.empty}</div>
    </div>

    <div class="rpg-tool__toolbar">
      <ToolActionButton id="rpg-generate">{copy.generate}</ToolActionButton>
    </div>

    <div id="rpg-error" class="tool-error" style="display: none;" role="alert"></div>

    <div class="tool-note rpg-tool__note">{copy.note}</div>
  </section>
</ToolWorkspace>

<script>
  const countInput = document.getElementById('rpg-count') as HTMLInputElement | null;
  const minInput = document.getElementById('rpg-min') as HTMLInputElement | null;
  const maxInput = document.getElementById('rpg-max') as HTMLInputElement | null;
  const output = document.getElementById('rpg-output')!;
  const errorDiv = document.getElementById('rpg-error') as HTMLDivElement | null;
  const generateBtn = document.getElementById('rpg-generate') as HTMLButtonElement | null;
  const copyAllBtn = document.getElementById('rpg-copy-all') as HTMLButtonElement | null;
  const clearBtn = document.getElementById('rpg-clear') as HTMLButtonElement | null;
  const rangeRadios = document.querySelectorAll<HTMLInputElement>('input[name="rpg-range"]');
  const root = document.querySelector('.rpg-tool') as HTMLElement | null;
  const emptyText = root?.dataset.empty || 'Click Generate to create random ports';

  const RANGES: Record<string, [number, number]> = {
    dynamic: [49152, 65535],
    registered: [1024, 49151],
  };

  function getRange(): [number, number] {
    let selected = 'dynamic';
    rangeRadios.forEach(r => { if (r.checked) selected = r.value; });
    if (selected === 'custom') {
      return [parseInt(minInput?.value || '1', 10) || 1, parseInt(maxInput?.value || '65535', 10) || 65535];
    }
    return RANGES[selected] || RANGES.dynamic;
  }

  function applyPreset() {
    let selected = 'dynamic';
    rangeRadios.forEach(r => { if (r.checked) selected = r.value; });
    if (selected !== 'custom') {
      const [lo, hi] = RANGES[selected] || RANGES.dynamic;
      if (minInput) minInput.value = String(lo);
      if (maxInput) maxInput.value = String(hi);
    }
  }

  function getCount(): number {
    let c = parseInt(countInput?.value || '5', 10);
    if (isNaN(c) || c < 1) c = 1;
    if (c > 50) c = 50;
    if (countInput) countInput.value = String(c);
    return c;
  }

  function generatePort(min: number, max: number): number {
    const range = max - min + 1;
    const array = new Uint32Array(1);
    crypto.getRandomValues(array);
    return min + (array[0] % range);
  }

  function renderResult(ports: number[]) {
    output.classList.remove('tool-output--empty', 'tool-output--error');
    output.textContent = ports.map(p => String(p)).join('\n');
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
  }

  function showEmpty() {
    window.__belbooreTools.showEmpty(output, emptyText);
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
  }

  function showError(msg: string) {
    if (errorDiv) { errorDiv.textContent = msg; errorDiv.style.display = ''; }
    window.__belbooreTools.showError(output, msg);
  }

  generateBtn?.addEventListener('click', () => {
    try {
      applyPreset();
      const count = getCount();
      const [min, max] = getRange();
      if (min >= max) {
        showError('Min port must be less than max port');
        return;
      }
      if (min < 1 || max > 65535) {
        showError('Ports must be between 1 and 65535');
        return;
      }
      const ports: number[] = [];
      for (let i = 0; i < count; i++) {
        ports.push(generatePort(min, max));
      }
      renderResult(ports);
    } catch (e: any) {
      showError(e?.message || 'Generation failed');
    }
  });

  copyAllBtn?.addEventListener('click', () => {
    const text = output.textContent || '';
    if (!text || output.classList.contains('tool-output--empty')) return;
    window.__belbooreTools.copyToClipboard(text, copyAllBtn!, 1500);
  });

  clearBtn?.addEventListener('click', () => {
    if (countInput) countInput.value = '5';
    if (minInput) minInput.value = '49152';
    if (maxInput) maxInput.value = '65535';
    rangeRadios.forEach(r => { r.checked = r.value === 'dynamic'; });
    showEmpty();
  });

  rangeRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      const isCustom = radio.value === 'custom';
      if (minInput) minInput.disabled = !isCustom;
      if (maxInput) maxInput.disabled = !isCustom;
      if (!isCustom) applyPreset();
    });
  });

  countInput?.addEventListener('blur', getCount);
</script>

<style>
  .rpg-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .rpg-tool__controls { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .rpg-tool__field-row { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: flex-end; }
  .rpg-tool__count-input { max-width: 100px; }
  .rpg-tool__port-input { max-width: 140px; }
  .rpg-tool__num-field { text-align: center; }
  .rpg-tool__actions { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; }
  .rpg-tool__range-presets { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-4); padding: var(--space-3) var(--space-4); background: var(--surface-tertiary); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); align-items: center; }
  .rpg-tool__range-label { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; }
  .rpg-tool__radio { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--text-secondary); cursor: pointer; }
  .rpg-tool__radio input { accent-color: var(--color-tech-blue); }
  .rpg-tool__output-shell { min-height: 0; }
  .rpg-tool__output { min-height: 160px; padding: var(--space-4); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.8; white-space: pre-wrap; word-break: break-all; overflow-x: auto; max-height: 400px; overflow-y: auto; }
  .rpg-tool__toolbar { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .rpg-tool .tool-action-button { min-width: 148px; }
  .rpg-tool__note { margin-top: 0; }
  @media (max-width: 768px) { .rpg-tool__controls { flex-direction: column; align-items: stretch; } .rpg-tool__actions { justify-content: center; } .rpg-tool .tool-action-button { width: 100%; min-width: 0; } .rpg-tool__range-presets { flex-direction: column; align-items: flex-start; } }
</style>
