---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';
import { getTimezoneList } from './Phase10Utils.ts';
const timezoneOptions = getTimezoneList();

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Date-Time Converter',
    modeLabel: 'Input Type',
    inputLabel: 'Value',
    inputTsPlaceholder: 'Enter Unix timestamp...',
    inputIsoPlaceholder: 'Enter ISO 8601 date...',
    inputLocalPlaceholder: 'Enter date and time...',
    timezoneLabel: 'Timezone',
    now: 'Now',
    convert: 'Convert',
    clear: 'Clear',
    emptyState: 'Enter a timestamp, ISO date, or local date-time',
    note: 'Convert between Unix timestamps, ISO 8601, UTC, local time, and selected timezones. All processing is client-side.',
    iso8601: 'ISO 8601',
    unixSeconds: 'Unix Timestamp (seconds)',
    unixMs: 'Unix Timestamp (milliseconds)',
    utc: 'UTC',
    local: 'Local',
    tz: 'Selected Timezone',
    relative: 'Relative Time',
    copy: 'Copy',
    isoMode: 'ISO 8601',
    unixMode: 'Unix Timestamp',
    localMode: 'Local Date-Time',
    seconds: 'Seconds',
    milliseconds: 'Milliseconds',
  },
  fa: {
    title: 'مبدل تاریخ-زمان',
    modeLabel: 'نوع ورودی',
    inputLabel: 'مقدار',
    inputTsPlaceholder: 'Timestamp یونیکس را وارد کنید...',
    inputIsoPlaceholder: 'تاریخ ISO 8601 را وارد کنید...',
    inputLocalPlaceholder: 'تاریخ و زمان را وارد کنید...',
    timezoneLabel: 'منطقه زمانی',
    now: 'اکنون',
    convert: 'تبدیل',
    clear: 'پاک کردن',
    emptyState: 'یک timestamp، تاریخ ISO یا تاریخ محلی وارد کنید',
    note: 'تبدیل بین timestamp های یونیکس، ISO 8601، UTC، زمان محلی و مناطق زمانی انتخاب شده. تمام پردازش در سمت کاربر است.',
    iso8601: 'ISO 8601',
    unixSeconds: 'Timestamp یونیکس (ثانیه)',
    unixMs: 'Timestamp یونیکس (میلی‌ثانیه)',
    utc: 'UTC',
    local: 'محلی',
    tz: 'منطقه زمانی انتخاب شده',
    relative: 'زمان نسبی',
    copy: 'کپی',
    isoMode: 'ISO 8601',
    unixMode: 'Timestamp یونیکس',
    localMode: 'تاریخ-زمان محلی',
    seconds: 'ثانیه',
    milliseconds: 'میلی‌ثانیه',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="dc-tool">
    <div class="dc-mode-row">
      <Select id="dc-mode" label={copy[lang].modeLabel} options={[
        { value: 'unix', label: copy[lang].unixMode },
        { value: 'iso', label: copy[lang].isoMode },
        { value: 'local', label: copy[lang].localMode },
      ]} />
      <div id="dc-unit-group">
        <Select id="dc-ts-unit" label={copy[lang].seconds} options={[
          { value: 's', label: copy[lang].seconds },
          { value: 'ms', label: copy[lang].milliseconds },
        ]} className="dc-unit-select" />
      </div>
    </div>
    <Input id="dc-input" label={copy[lang].inputLabel} placeholder={copy[lang].inputTsPlaceholder} inputClassName="dc-input" spellcheck={false} />
    <Select id="dc-tz" label={copy[lang].timezoneLabel} options={timezoneOptions} selectClassName="dc-tz-select" />
    <div class="tool-toolbar">
      <ToolActionButton id="dc-convert">{copy[lang].convert}</ToolActionButton>
      <Button id="dc-now" variant="secondary">{copy[lang].now}</Button>
      <Button id="dc-clear" variant="secondary">{copy[lang].clear}</Button>
    </div>
    <div id="dc-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>
    <div id="dc-output-card" class="dc-output-card" style="display:none">
      <div class="dc-output-header">
        <span class="dc-output-label">Output</span>
        <button id="dc-copy-all" class="dc-copy-all-btn" type="button">Copy All</button>
      </div>
      <div class="dc-output-rows">
        <div class="dc-row"><span class="dc-label">{copy[lang].iso8601}</span><span id="dc-iso" class="dc-value"></span><Button className="dc-row-copy" data-target="dc-iso">{copy[lang].copy}</Button></div>
        <div class="dc-row"><span class="dc-label">{copy[lang].unixSeconds}</span><span id="dc-ts-s" class="dc-value"></span><Button className="dc-row-copy" data-target="dc-ts-s">{copy[lang].copy}</Button></div>
        <div class="dc-row"><span class="dc-label">{copy[lang].unixMs}</span><span id="dc-ts-ms" class="dc-value"></span><Button className="dc-row-copy" data-target="dc-ts-ms">{copy[lang].copy}</Button></div>
        <div class="dc-row"><span class="dc-label">{copy[lang].utc}</span><span id="dc-utc" class="dc-value"></span><Button className="dc-row-copy" data-target="dc-utc">{copy[lang].copy}</Button></div>
        <div class="dc-row"><span class="dc-label">{copy[lang].local}</span><span id="dc-local" class="dc-value"></span><Button className="dc-row-copy" data-target="dc-local">{copy[lang].copy}</Button></div>
        <div class="dc-row"><span class="dc-label">{copy[lang].tz}</span><span id="dc-tz-val" class="dc-value"></span><Button className="dc-row-copy" data-target="dc-tz-val">{copy[lang].copy}</Button></div>
        <div class="dc-row"><span class="dc-label">{copy[lang].relative}</span><span id="dc-relative" class="dc-value"></span></div>
      </div>
    </div>
    <div id="dc-error" class="tool-error" style="display:none"></div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { formatRelativeTime, formatInTimezone } from './Phase10Utils.ts';

  const modeSelect = document.getElementById('dc-mode') as HTMLSelectElement;
  const unitSelect = document.getElementById('dc-ts-unit') as HTMLSelectElement;
  const unitGroup = document.getElementById('dc-unit-group')!;
  const input = document.getElementById('dc-input') as HTMLInputElement;
  const tzSelect = document.getElementById('dc-tz') as HTMLSelectElement;
  const convertBtn = document.getElementById('dc-convert') as HTMLButtonElement;
  const nowBtn = document.getElementById('dc-now') as HTMLButtonElement;
  const clearBtn = document.getElementById('dc-clear') as HTMLButtonElement;
  const emptyEl = document.getElementById('dc-empty')!;
  const outputCard = document.getElementById('dc-output-card')!;
  const errorEl = document.getElementById('dc-error')!;
  const isoEl = document.getElementById('dc-iso')!;
  const tsSEl = document.getElementById('dc-ts-s')!;
  const tsMsEl = document.getElementById('dc-ts-ms')!;
  const utcEl = document.getElementById('dc-utc')!;
  const localEl = document.getElementById('dc-local')!;
  const tzValEl = document.getElementById('dc-tz-val')!;
  const relativeEl = document.getElementById('dc-relative')!;

  tzSelect.value = Intl.DateTimeFormat().resolvedOptions().timeZone;

  modeSelect.addEventListener('change', () => {
    const mode = modeSelect.value;
    input.placeholder = mode === 'unix' ? 'Enter Unix timestamp...' : mode === 'iso' ? 'Enter ISO 8601 date...' : 'Enter date and time...';
    input.type = mode === 'local' ? 'datetime-local' : 'text';
    const showUnit = mode === 'unix';
    unitGroup.style.display = showUnit ? '' : 'none';
  });

  function updateOutput(date: Date) {
    const ts = Math.floor(date.getTime() / 1000);
    const tz = tzSelect.value;
    isoEl.textContent = date.toISOString();
    tsSEl.textContent = String(ts);
    tsMsEl.textContent = String(date.getTime());
    utcEl.textContent = date.toUTCString();
    localEl.textContent = date.toLocaleString();
    tzValEl.textContent = formatInTimezone(date, tz);
    relativeEl.textContent = formatRelativeTime(date);
    emptyEl.style.display = 'none';
    outputCard.style.display = '';
    errorEl.style.display = 'none';
  }

  function doConvert() {
    const mode = modeSelect.value;
    const val = input.value.trim();
    if (!val) {
      errorEl.textContent = 'Please enter a value';
      errorEl.style.display = '';
      outputCard.style.display = 'none';
      return;
    }
    try {
      let date: Date;
      if (mode === 'unix') {
        const unit = unitSelect.value;
        const ts = parseFloat(val);
        if (isNaN(ts)) throw new Error('Invalid timestamp');
        date = new Date(unit === 'ms' ? ts : ts * 1000);
      } else if (mode === 'iso') {
        date = new Date(val);
      } else {
        date = new Date(val);
      }
      if (isNaN(date.getTime())) throw new Error('Invalid date');
      updateOutput(date);
    } catch (e: any) {
      errorEl.textContent = e.message || 'Invalid input';
      errorEl.style.display = '';
      outputCard.style.display = 'none';
    }
  }

  convertBtn.addEventListener('click', doConvert);

  nowBtn.addEventListener('click', () => {
    const now = new Date();
    input.value = String(Math.floor(now.getTime() / 1000));
    modeSelect.value = 'unix';
    unitSelect.value = 's';
    updateOutput(now);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    emptyEl.style.display = '';
    outputCard.style.display = 'none';
    errorEl.style.display = 'none';
  });

  document.querySelectorAll('.dc-row-copy').forEach(btn => {
    btn.addEventListener('click', function() {
      const targetId = (this as HTMLElement).dataset.target;
      if (!targetId) return;
      const el = document.getElementById(targetId);
      if (!el) return;
      const text = el.textContent || '';
      if (!text) return;
      window.__belbooreTools.copyToClipboard(text, this as HTMLElement, 1500);
    });
  });

  document.getElementById('dc-copy-all')!.addEventListener('click', () => {
    const parts: string[] = [];
    document.querySelectorAll('.dc-row').forEach(row => {
      const label = row.querySelector('.dc-label')?.textContent || '';
      const val = row.querySelector('.dc-value')?.textContent || '';
      if (label && val) parts.push(`${label}: ${val}`);
    });
    if (parts.length === 0) return;
    window.__belbooreTools.copyToClipboard(parts.join('\n'), document.getElementById('dc-copy-all') as HTMLElement, 1500);
  });

  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') doConvert(); });
</script>

<style>
  .dc-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .dc-tool .tool-note { margin-top: 0; }
  .dc-mode-row { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: flex-start; }
  .dc-mode-row .ui-select:first-child { flex: 1; min-width: 200px; }
  .dc-tz-select { flex: 1; }
  .dc-input { width: 100%; font-family: var(--font-mono); }

  .dc-output-card {
    background: var(--surface-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-top: var(--space-4);
  }
  .dc-output-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-primary);
  }
  .dc-output-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .dc-copy-all-btn {
    background: none;
    border: 1px solid var(--border-subtle);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }
  .dc-copy-all-btn:hover { color: var(--text-primary); border-color: var(--border-strong); }
  .dc-output-rows { padding: var(--space-2) var(--space-4); }
  .dc-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .dc-row:last-child { border-bottom: none; }
  .dc-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-tertiary);
    min-width: 180px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  .dc-value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-primary);
    word-break: break-all;
    flex: 1;
  }
  .dc-row-copy {
    flex-shrink: 0;
    font-size: var(--text-xs) !important;
    padding: var(--space-1) var(--space-2) !important;
  }
  @media (max-width: 640px) {
    .dc-mode-row { flex-direction: column; }
    .dc-mode-row .ui-select:first-child { min-width: 100%; }
    .dc-row { flex-wrap: wrap; gap: var(--space-1); }
    .dc-label { min-width: 100%; margin-bottom: var(--space-1); }
    .dc-output-rows { padding: var(--space-2) var(--space-3); }
  }
</style>
