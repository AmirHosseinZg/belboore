---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import Button from '../ui/Button.astro';
import TextArea from '../ui/TextArea.astro';
import Select from '../ui/Select.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'SQL Prettify / زیباسازی SQL',
    inputLabel: 'SQL Input',
    outputLabel: 'Formatted SQL',
    inputHint: 'Paste your SQL query here.',
    outputHint: 'Formatted SQL will appear here.',
    format: 'Format',
    copy: 'Copy',
    clear: 'Clear',
    loadExample: 'Load example',
    copied: 'Copied!',
    empty: 'Formatted SQL will appear here',
    note: 'All processing happens in your browser. Your data is never uploaded.',
    error: 'SQL format error',
    dialect: 'Dialect',
    uppercase: 'Uppercase keywords',
    indentSize: 'Indent size',
    exampleSql: 'SELECT id, name, email FROM users WHERE active = 1 ORDER BY name ASC LIMIT 10',
  },
  fa: {
    title: 'زیباسازی SQL',
    inputLabel: 'ورودی SQL',
    outputLabel: 'SQL فرمت شده',
    inputHint: 'کد SQL خود را اینجا وارد کنید.',
    outputHint: 'SQL فرمت شده اینجا نمایش داده می‌شود.',
    format: 'فرمت',
    copy: 'کپی',
    clear: 'پاک کردن',
    loadExample: 'نمونه',
    copied: 'کپی شد!',
    empty: 'SQL فرمت شده اینجا نمایش داده می‌شود',
    note: 'تمام پردازش‌ها در مرورگر شما انجام می‌شود. داده‌های شما آپلود نمی‌شود.',
    error: 'خطا در فرمت SQL',
    dialect: 'گویش',
    uppercase: 'حروف بزرگ برای کلیدواژه‌ها',
    indentSize: 'اندازه تورفتگی',
    exampleSql: 'SELECT id, name, email FROM users WHERE active = 1 ORDER BY name ASC LIMIT 10',
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section class="sql-tool" dir={dir} data-empty={copy.empty} data-copied={copy.copied} data-error={copy.error}>
    <div class="sql-tool__settings">
      <Select id="sql-dialect" label={copy.dialect} className="sql-tool__select" selectedValue="sql" options={[
        { value: 'sql', label: 'SQL' },
        { value: 'mysql', label: 'MySQL' },
        { value: 'postgresql', label: 'PostgreSQL' },
        { value: 'sqlite', label: 'SQLite' },
        { value: 'mariadb', label: 'MariaDB' },
        { value: 'bigquery', label: 'BigQuery' },
        { value: 'transactsql', label: 'Transact-SQL' },
      ]} />
      <Select id="sql-indent" label={copy.indentSize} className="sql-tool__select sql-tool__select--sm" selectedValue="2" options={[
        { value: '2', label: '2' },
        { value: '4', label: '4' },
      ]} />
      <label class="sql-tool__checkbox"><input type="checkbox" id="sql-uppercase" /> {copy.uppercase}</label>
    </div>

    <div class="sql-tool__grid">
      <div class="sql-tool__panel">
        <div class="sql-tool__panel-head">
          <label class="sql-tool__label" for="sql-input">{copy.inputLabel}</label>
          <p class="sql-tool__hint">{copy.inputHint}</p>
        </div>
        <TextArea id="sql-input" className="sql-tool__textarea" placeholder={copy.exampleSql} rows={12} spellcheck="false" />
      </div>

      <div class="sql-tool__panel">
        <div class="sql-tool__panel-head">
          <label class="sql-tool__label" for="sql-output">{copy.outputLabel}</label>
          <p class="sql-tool__hint">{copy.outputHint}</p>
        </div>
        <textarea id="sql-output" class="sql-tool__textarea sql-tool__textarea--output" rows={12} readonly spellcheck="false" placeholder={copy.empty}></textarea>
      </div>
    </div>

    <div class="sql-tool__toolbar">
      <ToolActionButton id="sql-run">{copy.format}</ToolActionButton>
      <Button id="sql-copy" variant="outline">{copy.copy}</Button>
      <Button id="sql-clear" variant="danger">{copy.clear}</Button>
      <Button id="sql-example" variant="secondary">{copy.loadExample}</Button>
    </div>

    <div id="sql-error" class="tool-error" style="display: none;" role="alert"></div>

    <div class="tool-note sql-tool__note">{copy.note}</div>
  </section>
</ToolWorkspace>

<script>
  import { format } from 'sql-formatter';

  const input = document.getElementById('sql-input') as HTMLTextAreaElement | null;
  const output = document.getElementById('sql-output') as HTMLTextAreaElement | null;
  const errorDiv = document.getElementById('sql-error') as HTMLDivElement | null;
  const runBtn = document.getElementById('sql-run') as HTMLButtonElement | null;
  const copyBtn = document.getElementById('sql-copy') as HTMLButtonElement | null;
  const clearBtn = document.getElementById('sql-clear') as HTMLButtonElement | null;
  const exampleBtn = document.getElementById('sql-example') as HTMLButtonElement | null;
  const dialectSelect = document.getElementById('sql-dialect') as HTMLSelectElement | null;
  const indentSelect = document.getElementById('sql-indent') as HTMLSelectElement | null;
  const uppercaseCb = document.getElementById('sql-uppercase') as HTMLInputElement | null;

  const root = document.querySelector('.sql-tool') as HTMLElement | null;

  function getData(key: string, fallback: string): string {
    return root?.dataset[key] || fallback;
  }

  function runFormat() {
    if (!input || !output) return;
    const val = input.value;
    if (!val) { output.value = ''; output.placeholder = getData('empty', ''); if (errorDiv) errorDiv.style.display = 'none'; return; }
    try {
      const dialect = dialectSelect?.value || 'sql';
      const indent = parseInt(indentSelect?.value || '2', 10);
      const uppercase = uppercaseCb?.checked ?? false;
      const result = format(val, { language: dialect as any, tabWidth: indent, uppercase });
      output.value = result;
      output.placeholder = '';
      if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    } catch (e: any) {
      output.value = '';
      output.placeholder = getData('empty', '');
      if (errorDiv) { errorDiv.textContent = `${getData('error', 'SQL format error')}: ${e?.message || ''}`; errorDiv.style.display = ''; }
    }
  }

  runBtn?.addEventListener('click', runFormat);

  input?.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') { event.preventDefault(); runFormat(); }
  });

  copyBtn?.addEventListener('click', () => {
    if (!output || !output.value) return;
    navigator.clipboard.writeText(output.value).then(() => {
      copyBtn.classList.add('is-copied');
      const orig = copyBtn.innerHTML;
      copyBtn.innerHTML = copy.copied;
      setTimeout(() => { copyBtn.innerHTML = orig; copyBtn.classList.remove('is-copied'); }, 1200);
    }).catch(() => {});
  });

  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    if (output) { output.value = ''; output.placeholder = getData('empty', ''); }
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    input?.focus();
  });

  exampleBtn?.addEventListener('click', () => {
    if (input) input.value = copy.exampleSql;
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    runFormat();
  });
</script>

<style>
  .sql-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .sql-tool__settings { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: flex-end; padding: var(--space-4); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-tertiary); }
  .sql-tool__select { min-width: 180px; }
  .sql-tool__select--sm { min-width: 100px; }
  .sql-tool__checkbox { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--text-secondary); cursor: pointer; }
  .sql-tool__checkbox input { accent-color: var(--color-tech-blue); width: 16px; height: 16px; }
  .sql-tool__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .sql-tool__panel { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding: var(--space-3) var(--space-4); border: 1px solid transparent; border-radius: calc(var(--radius-lg) - 4px); background: var(--surface-tertiary); transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
  .sql-tool__panel:focus-within { border-color: var(--color-tech-blue); box-shadow: 0 0 0 3px var(--color-tech-blue-subtle); }
  .sql-tool__panel-head { display: flex; flex-direction: column; gap: var(--space-1); }
  .sql-tool__label { color: var(--text-secondary); font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.06em; }
  .sql-tool__hint { margin: 0; color: var(--text-muted); font-size: var(--text-xs); line-height: var(--leading-snug); }
  .sql-tool__textarea { width: 100%; min-height: 240px; padding: var(--space-4); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.6; color: var(--text-primary); background: var(--surface-primary); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); resize: vertical; outline: none; transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
  .sql-tool__textarea:focus { border-color: var(--color-tech-blue); box-shadow: 0 0 0 3px var(--color-tech-blue-subtle); }
  .sql-tool__textarea::placeholder { color: var(--text-muted); }
  .sql-tool__textarea--output { background: var(--surface-secondary); resize: none; }
  .sql-tool__textarea--output:focus { border-color: var(--border-subtle); box-shadow: none; }
  .sql-tool__toolbar { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .sql-tool .tool-action-button { min-width: 148px; }
  .sql-tool__note { margin-top: 0; }
  @media (max-width: 768px) { .sql-tool__grid { grid-template-columns: 1fr; } .sql-tool .tool-action-button { width: 100%; min-width: 0; } .sql-tool__settings { flex-direction: column; align-items: stretch; } .sql-tool__select { width: 100%; min-width: 0; } .sql-tool__toolbar { flex-direction: column; } .sql-tool__toolbar .ui-button, .sql-tool__toolbar .tool-action-button { width: 100%; } }
</style>
