---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'SVG Placeholder Generator',
    width: 'Width',
    height: 'Height',
    label: 'Label Text',
    bgColor: 'Background Color',
    textColor: 'Text Color',
    fontSize: 'Font Size',
    cornerRadius: 'Corner Radius',
    generate: 'Generate',
    copySvg: 'Copy SVG',
    copyDataUri: 'Copy Data URI',
    download: 'Download SVG',
    reset: 'Reset to Defaults',
    preview: 'Preview',
    svgSource: 'SVG Source',
    dataUri: 'Data URI',
    sourceSize: 'Source Size',
    emptyState: 'Configure dimensions and style, then click Generate',
    note: 'SVG generation happens entirely in your browser. No data is sent anywhere.',
    pixel: 'px',
  },
  fa: {
    title: 'تولید SVG placeholder',
    width: 'عرض',
    height: 'ارتفاع',
    label: 'متن برچسب',
    bgColor: 'رنگ پس‌زمینه',
    textColor: 'رنگ متن',
    fontSize: 'اندازه فونت',
    cornerRadius: 'شعاع گوشه',
    generate: 'تولید',
    copySvg: 'کپی SVG',
    copyDataUri: 'کپی Data URI',
    download: 'دانلود SVG',
    reset: 'بازنشانی به پیش‌فرض',
    preview: 'پیش‌نمایش',
    svgSource: 'کد SVG',
    dataUri: 'Data URI',
    sourceSize: 'حجم منبع',
    emptyState: 'ابعاد و استایل را تنظیم کنید و روی Generate کلیک کنید',
    note: 'تولید SVG کاملاً در مرورگر شما انجام می‌شود. هیچ داده‌ای ارسال نمی‌شود.',
    pixel: 'پیکسل',
  },
};

const defaults = { width: 800, height: 400, label: '', bgColor: '#e5e7eb', textColor: '#374151', fontSize: 48, cornerRadius: 0 };
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="svgp-tool">
    <div class="svgp-layout">
      <div class="svgp-settings">
        <div class="svgp-section">
          <span class="svgp-section-title">{copy[lang].width} &amp; {copy[lang].height}</span>
          <div class="svgp-dim-row">
            <Input id="svgp-width" label={copy[lang].width} type="number" inputmode="numeric" value={String(defaults.width)} inputClassName="svgp-num-input" />
            <Input id="svgp-height" label={copy[lang].height} type="number" inputmode="numeric" value={String(defaults.height)} inputClassName="svgp-num-input" />
          </div>
        </div>
        <div class="svgp-section">
          <span class="svgp-section-title">{copy[lang].label}</span>
          <Input id="svgp-label" label={copy[lang].label} placeholder="800 × 400" spellcheck={false} />
        </div>
        <div class="svgp-section">
          <span class="svgp-section-title">{copy[lang].bgColor} &amp; {copy[lang].textColor}</span>
          <div class="svgp-color-row">
            <div class="svgp-color-field">
              <label class="svgp-color-label" for="svgp-bg">{copy[lang].bgColor}</label>
              <div class="svgp-color-input-wrap">
                <input id="svgp-bg" type="color" value={defaults.bgColor} class="svgp-color-input" />
                <input id="svgp-bg-text" type="text" value={defaults.bgColor} class="svgp-color-text" aria-label={copy[lang].bgColor} />
              </div>
            </div>
            <div class="svgp-color-field">
              <label class="svgp-color-label" for="svgp-text-clr">{copy[lang].textColor}</label>
              <div class="svgp-color-input-wrap">
                <input id="svgp-text-clr" type="color" value={defaults.textColor} class="svgp-color-input" />
                <input id="svgp-text-clr-text" type="text" value={defaults.textColor} class="svgp-color-text" aria-label={copy[lang].textColor} />
              </div>
            </div>
          </div>
        </div>
        <div class="svgp-section">
          <span class="svgp-section-title">{copy[lang].fontSize} &amp; {copy[lang].cornerRadius}</span>
          <div class="svgp-dim-row">
            <Input id="svgp-font-size" label={copy[lang].fontSize} type="number" inputmode="numeric" value={String(defaults.fontSize)} inputClassName="svgp-num-input" />
            <Input id="svgp-radius" label={copy[lang].cornerRadius} type="number" inputmode="numeric" value={String(defaults.cornerRadius)} inputClassName="svgp-num-input" />
          </div>
        </div>
        <div class="tool-toolbar">
          <ToolActionButton id="svgp-generate">{copy[lang].generate}</ToolActionButton>
          <Button id="svgp-reset" variant="secondary">{copy[lang].reset}</Button>
        </div>
      </div>
      <div class="svgp-output">
        <div class="svgp-section">
          <span class="svgp-section-title">{copy[lang].preview}</span>
          <div id="svgp-preview-wrap" class="svgp-preview-wrap">
            <img id="svgp-preview" class="svgp-preview" alt="SVG Placeholder Preview" />
          </div>
        </div>
        <div id="svgp-result-area" style="display:none">
          <div class="svgp-section">
            <div class="svgp-section-row">
              <span class="svgp-section-title">{copy[lang].svgSource}</span>
              <span id="svgp-size" class="svgp-size-badge"></span>
            </div>
            <pre id="svgp-source" class="svgp-source" readonly aria-label={copy[lang].svgSource}></pre>
          </div>
          <div class="tool-toolbar">
            <Button id="svgp-copy-svg" variant="outline">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              {copy[lang].copySvg}
            </Button>
            <Button id="svgp-copy-uri" variant="outline">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              {copy[lang].copyDataUri}
            </Button>
            <Button id="svgp-download" variant="secondary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {copy[lang].download}
            </Button>
          </div>
        </div>
      </div>
    </div>
    <div id="svgp-error" class="tool-error" style="display:none" role="alert"></div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { generateSvgPlaceholder, svgToDataUri, downloadTextFile } from './mediaUtils.ts';

  const widthInput = document.getElementById('svgp-width') as HTMLInputElement;
  const heightInput = document.getElementById('svgp-height') as HTMLInputElement;
  const labelInput = document.getElementById('svgp-label') as HTMLInputElement;
  const bgInput = document.getElementById('svgp-bg') as HTMLInputElement;
  const bgText = document.getElementById('svgp-bg-text') as HTMLInputElement;
  const textClrInput = document.getElementById('svgp-text-clr') as HTMLInputElement;
  const textClrText = document.getElementById('svgp-text-clr-text') as HTMLInputElement;
  const fontSizeInput = document.getElementById('svgp-font-size') as HTMLInputElement;
  const radiusInput = document.getElementById('svgp-radius') as HTMLInputElement;
  const generateBtn = document.getElementById('svgp-generate')!;
  const resetBtn = document.getElementById('svgp-reset')!;
  const preview = document.getElementById('svgp-preview') as HTMLImageElement;
  const sourceEl = document.getElementById('svgp-source')!;
  const sizeEl = document.getElementById('svgp-size')!;
  const resultArea = document.getElementById('svgp-result-area')!;
  const errorEl = document.getElementById('svgp-error')!;
  const copySvgBtn = document.getElementById('svgp-copy-svg')!;
  const copyUriBtn = document.getElementById('svgp-copy-uri')!;
  const downloadBtn = document.getElementById('svgp-download')!;

  const defaults = { width: 800, height: 400, label: '', bgColor: '#e5e7eb', textColor: '#374151', fontSize: 48, radius: 0 };

  function syncColorInputs() {
    bgText.value = bgInput.value;
    textClrText.value = textClrInput.value;
  }

  bgInput.addEventListener('input', syncColorInputs);
  textClrInput.addEventListener('input', syncColorInputs);
  bgText.addEventListener('input', () => { if (/^#[0-9a-f]{6}$/i.test(bgText.value)) bgInput.value = bgText.value; });
  textClrText.addEventListener('input', () => { if (/^#[0-9a-f]{6}$/i.test(textClrText.value)) textClrInput.value = textClrText.value; });

  let currentSvg = '';

  function doGenerate() {
    const w = parseInt(widthInput.value, 10);
    const h = parseInt(heightInput.value, 10);
    const fs = parseInt(fontSizeInput.value, 10);
    const r = parseInt(radiusInput.value, 10);

    if (isNaN(w) || w < 1 || w > 4096) {
      errorEl.textContent = 'Width must be between 1 and 4096.';
      errorEl.style.display = '';
      return;
    }
    if (isNaN(h) || h < 1 || h > 4096) {
      errorEl.textContent = 'Height must be between 1 and 4096.';
      errorEl.style.display = '';
      return;
    }
    if (isNaN(fs) || fs < 4 || fs > 512) {
      errorEl.textContent = 'Font size must be between 4 and 512.';
      errorEl.style.display = '';
      return;
    }
    if (isNaN(r) || r < 0 || r > 200) {
      errorEl.textContent = 'Corner radius must be between 0 and 200.';
      errorEl.style.display = '';
      return;
    }

    errorEl.style.display = 'none';
    const label = labelInput.value.trim() || `${w} \u00d7 ${h}`;
    currentSvg = generateSvgPlaceholder(w, h, label, bgInput.value, textClrInput.value, fs, r);
    const dataUri = svgToDataUri(currentSvg);
    preview.src = dataUri;
    preview.alt = `SVG Placeholder: ${label}`;
    sourceEl.textContent = currentSvg;
    const svgBytes = new TextEncoder().encode(currentSvg).length;
    sizeEl.textContent = formatSize(svgBytes);
    resultArea.style.display = '';
  }

  function formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    return (bytes / 1024).toFixed(1) + ' KB';
  }

  generateBtn.addEventListener('click', doGenerate);

  resetBtn.addEventListener('click', () => {
    widthInput.value = String(defaults.width);
    heightInput.value = String(defaults.height);
    labelInput.value = defaults.label;
    bgInput.value = defaults.bgColor;
    bgText.value = defaults.bgColor;
    textClrInput.value = defaults.textColor;
    textClrText.value = defaults.textColor;
    fontSizeInput.value = String(defaults.fontSize);
    radiusInput.value = String(defaults.radius);
    resultArea.style.display = 'none';
    preview.src = '';
    sourceEl.textContent = '';
    errorEl.style.display = 'none';
    doGenerate();
  });

  copySvgBtn.addEventListener('click', () => {
    if (currentSvg) window.__belbooreTools.copyToClipboard(currentSvg, copySvgBtn, 1500);
  });

  copyUriBtn.addEventListener('click', () => {
    if (currentSvg) {
      const uri = svgToDataUri(currentSvg);
      window.__belbooreTools.copyToClipboard(uri, copyUriBtn, 1500);
    }
  });

  downloadBtn.addEventListener('click', () => {
    if (currentSvg) {
      const w = parseInt(widthInput.value, 10) || 800;
      const h = parseInt(heightInput.value, 10) || 400;
      downloadTextFile(currentSvg, `placeholder-${w}x${h}.svg`, 'image/svg+xml');
    }
  });

  doGenerate();
</script>

<style>
  .svgp-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .svgp-tool .tool-note { margin-top: 0; }
  .svgp-layout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: start; }
  .svgp-settings, .svgp-output { display: flex; flex-direction: column; gap: var(--space-5); }
  .svgp-section { display: flex; flex-direction: column; gap: var(--space-3); }
  .svgp-section-title { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; }
  .svgp-dim-row, .svgp-color-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .svgp-num-input { max-width: 120px; text-align: center; }
  .svgp-color-field { display: flex; flex-direction: column; gap: var(--space-1); }
  .svgp-color-label { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; }
  .svgp-color-input-wrap { display: flex; gap: var(--space-2); align-items: center; }
  .svgp-color-input { width: 40px; height: 40px; border: 1px solid var(--border-default); border-radius: var(--radius-md); padding: 2px; cursor: pointer; background: none; }
  .svgp-color-text { width: 100%; padding: var(--space-2) var(--space-3); font-family: var(--font-mono); font-size: var(--text-sm); border: 1px solid var(--border-default); border-radius: var(--radius-md); background: var(--surface-primary); color: var(--text-primary); outline: none; }
  .svgp-color-text:focus { border-color: var(--color-tech-blue); box-shadow: 0 0 0 3px var(--color-tech-blue-subtle); }
  .svgp-preview-wrap { background: repeating-conic-gradient(#e5e7eb 0% 25%, transparent 0% 50%) 50% / 20px 20px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); overflow: hidden; min-height: 200px; display: flex; align-items: center; justify-content: center; }
  .svgp-preview { max-width: 100%; max-height: 360px; display: block; }
  .svgp-section-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .svgp-size-badge { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); background: var(--surface-tertiary); padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); }
  .svgp-source { width: 100%; min-height: 120px; max-height: 300px; overflow: auto; padding: var(--space-4); font-family: var(--font-mono); font-size: var(--text-xs); line-height: 1.5; background: var(--surface-tertiary); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); color: var(--text-primary); white-space: pre; margin: 0; }
  @media (max-width: 768px) { .svgp-layout { grid-template-columns: 1fr; } }
</style>
