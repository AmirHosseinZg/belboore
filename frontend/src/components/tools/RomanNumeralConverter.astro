---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Roman Numeral Converter',
    inputLabel: 'Input',
    inputPlaceholderNumber: 'Enter a number (1-3999)...',
    inputPlaceholderRoman: 'Enter a Roman numeral...',
    directionLabel: 'Direction',
    convert: 'Convert',
    clear: 'Clear',
    copy: 'Copy',
    emptyStateNumber: 'Enter a number and click Convert',
    emptyStateRoman: 'Enter a Roman numeral and click Convert',
    note: 'Supports numbers from 1 to 3999. Uses standard Roman numeral symbols: I, V, X, L, C, D, M.',
    arabicToRoman: 'Number \u2192 Roman',
    romanToArabic: 'Roman \u2192 Number',
  },
  fa: {
    title: 'مبدل اعداد رومی',
    inputLabel: 'ورودی',
    inputPlaceholderNumber: 'یک عدد وارد کنید (۱-۳۹۹۹)...',
    inputPlaceholderRoman: 'یک عدد رومی وارد کنید...',
    directionLabel: 'جهت',
    convert: 'تبدیل',
    clear: 'پاک کردن',
    copy: 'کپی',
    emptyStateNumber: 'یک عدد وارد کنید و روی Convert کلیک کنید',
    emptyStateRoman: 'یک عدد رومی وارد کنید و روی Convert کلیک کنید',
    note: 'پشتیبانی از اعداد ۱ تا ۳۹۹۹. از نمادهای استاندارد اعداد رومی استفاده می‌کند: I, V, X, L, C, D, M.',
    arabicToRoman: 'عدد \u2192 رومی',
    romanToArabic: 'رومی \u2192 عدد',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="rc-tool">
    <Select id="rc-direction" label={copy[lang].directionLabel} options={[
      { value: 'ar', label: copy[lang].arabicToRoman },
      { value: 'ra', label: copy[lang].romanToArabic },
    ]} />
    <Input id="rc-input" label={copy[lang].inputLabel} placeholder={copy[lang].inputPlaceholderNumber} spellcheck={false} />
    <div class="tool-toolbar">
      <ToolActionButton id="rc-convert">{copy[lang].convert}</ToolActionButton>
      <Button id="rc-clear" variant="secondary">{copy[lang].clear}</Button>
      <Button id="rc-copy" variant="outline">{copy[lang].copy}</Button>
    </div>
    <div id="rc-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyStateNumber}</div>
    <div id="rc-result" class="tool-output" style="display:none;font-size:var(--text-2xl);text-align:center;padding:var(--space-6)" role="status" aria-live="polite"></div>
    <div id="rc-error" class="tool-error" style="display:none"></div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { arabicToRoman, romanToArabic } from './Phase9Utils.ts';

  const dirSelect = document.getElementById('rc-direction') as HTMLSelectElement;
  const input = document.getElementById('rc-input') as HTMLInputElement;
  const convertBtn = document.getElementById('rc-convert') as HTMLButtonElement;
  const clearBtn = document.getElementById('rc-clear') as HTMLButtonElement;
  const copyBtn = document.getElementById('rc-copy') as HTMLButtonElement;
  const emptyEl = document.getElementById('rc-empty')!;
  const resultEl = document.getElementById('rc-result')!;
  const errorEl = document.getElementById('rc-error')!;

  function updatePlaceholder() {
    input.placeholder = dirSelect.value === 'ar'
      ? input.getAttribute('data-ph-number') || 'Enter a number (1-3999)...'
      : input.getAttribute('data-ph-roman') || 'Enter a Roman numeral...';
  }

  input.dataset.phNumber = 'Enter a number (1-3999)...';
  input.dataset.phRoman = 'Enter a Roman numeral...';

  dirSelect.addEventListener('change', () => {
    input.placeholder = dirSelect.value === 'ar' ? 'Enter a number (1-3999)...' : 'Enter a Roman numeral...';
    emptyEl.textContent = dirSelect.value === 'ar' ? 'Enter a number and click Convert' : 'Enter a Roman numeral and click Convert';
    input.value = '';
    resultEl.style.display = 'none';
    errorEl.style.display = 'none';
    emptyEl.style.display = '';
    input.focus();
  });

  function doConvert() {
    const val = input.value.trim();
    const dir = dirSelect.value;
    if (!val) {
      errorEl.textContent = 'Please enter a value';
      errorEl.style.display = '';
      emptyEl.style.display = 'none';
      resultEl.style.display = 'none';
      return;
    }
    errorEl.style.display = 'none';
    try {
      let result = '';
      if (dir === 'ar') {
        const num = parseInt(val, 10);
        if (isNaN(num)) throw new Error('Invalid number');
        result = arabicToRoman(num);
      } else {
        result = String(romanToArabic(val));
      }
      emptyEl.style.display = 'none';
      resultEl.style.display = '';
      resultEl.textContent = result;
    } catch (e: any) {
      errorEl.textContent = 'Error: ' + (e.message || String(e));
      errorEl.style.display = '';
      resultEl.style.display = 'none';
    }
  }

  convertBtn.addEventListener('click', doConvert);

  clearBtn.addEventListener('click', () => {
    input.value = '';
    emptyEl.style.display = '';
    resultEl.style.display = 'none';
    errorEl.style.display = 'none';
    input.focus();
  });

  copyBtn.addEventListener('click', () => {
    const text = resultEl.textContent || '';
    if (!text || resultEl.style.display === 'none') return;
    window.__belbooreTools.copyToClipboard(text, copyBtn, 1500);
  });

  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') doConvert(); });
</script>

<style>
  .rc-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .rc-tool .tool-note { margin-top: 0; }
</style>
