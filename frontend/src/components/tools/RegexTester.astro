---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import TextArea from '../ui/TextArea.astro';
import Button from '../ui/Button.astro';
import Checkbox from '../ui/Checkbox.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const dir = languages[lang].dir;
---

<ToolWorkspace title={t['tools.regexTester.title']}>
  <ToolPrimitives />
  <ToolUtils />

  <section class="regex-tester" dir={dir}
    data-enter-pattern={t['tools.regexTester.enterPattern']}
    data-no-match={t['tools.regexTester.noMatch']}
    data-match-count={t['tools.regexTester.matchCount']}
    data-invalid-regex={t['tools.regexTester.invalidRegex']}
  >
    <div class="tool-field">
      <label class="tool-field__label" for="rt-pattern">{t['tools.regexTester.pattern']}</label>
      <input id="rt-pattern" class="tool-input tool-input--mono" type="text" placeholder={t['tools.regexTester.patternPlaceholder']} autocomplete="off" spellcheck="false" />
    </div>

    <div class="tool-field">
      <label class="tool-field__label">{t['tools.regexTester.flags']}</label>
      <div class="regex-tester__flags">
        <Checkbox id="rt-flag-g">{t['tools.regexTester.global']}</Checkbox>
        <Checkbox id="rt-flag-i">{t['tools.regexTester.caseInsensitive']}</Checkbox>
        <Checkbox id="rt-flag-m">{t['tools.regexTester.multiline']}</Checkbox>
        <Checkbox id="rt-flag-s">{t['tools.regexTester.dotAll']}</Checkbox>
        <Checkbox id="rt-flag-u">{t['tools.regexTester.unicode']}</Checkbox>
        <Checkbox id="rt-flag-y">{t['tools.regexTester.sticky']}</Checkbox>
      </div>
    </div>

    <div class="tool-field">
      <label class="tool-field__label" for="rt-text">{t['tools.regexTester.testText']}</label>
      <TextArea id="rt-text" className="tool-textarea--mono regex-tester__textarea" placeholder={t['tools.regexTester.testPlaceholder']} />
    </div>

    <div class="tool-toolbar">
      <Button id="rt-sample" variant="secondary">{t['tools.regexTester.sample']}</Button>
      <Button id="rt-copy" variant="primary">{t['tools.regexTester.copyMatches']}</Button>
    </div>

    <div id="rt-error" class="tool-error" style="display: none;" role="alert"></div>

    <div class="regex-tester__output-shell">
      <div class="regex-tester__output-head">
        <span class="tool-field__label">{t['tools.regexTester.result']}</span>
        <span id="rt-summary" class="regex-tester__summary"></span>
      </div>
      <div id="rt-output" class="tool-output tool-output--empty regex-tester__output" role="status" aria-live="polite">
        {t['tools.regexTester.enterPattern']}
      </div>
    </div>

    <div class="tool-note">
      <span class="tool-note__icon">i</span>
      {t['tools.regexTester.note']}
    </div>
  </section>
</ToolWorkspace>

<script>
  var root = document.querySelector('.regex-tester');
  var patternInput = document.getElementById('rt-pattern');
  var textArea = document.getElementById('rt-text');
  var output = document.getElementById('rt-output');
  var errorDiv = document.getElementById('rt-error');
  var summary = document.getElementById('rt-summary');
  var copyBtn = document.getElementById('rt-copy');
  var sampleBtn = document.getElementById('rt-sample');

  var flagIds = ['g','i','m','s','u','y'];

  function getFlags(){return flagIds.filter(function(f){var cb=document.getElementById('rt-flag-'+f);return cb&&cb.checked;}).join('');}
  function setError(msg){if(!errorDiv)return;window.__belbooreTools.setErrorBox(errorDiv,msg);}
  function clearError(){if(!errorDiv)return;window.__belbooreTools.clearErrorBox(errorDiv);}

  function escapeHtml(str){var d=document.createElement('div');d.textContent=str;return d.innerHTML;}

  function runTest(){
    if(!patternInput||!textArea||!output||!summary||!root) return;
    var pattern=patternInput.value;
    var text=textArea.value;

    if(!pattern&&!text){
      clearError();
      output.textContent=root.getAttribute('data-enter-pattern')||'Enter a pattern and test text to see matches';
      output.classList.add('tool-output--empty');
      summary.textContent='';
      return;
    }
    if(!pattern){
      clearError();
      output.textContent=root.getAttribute('data-enter-pattern')||'Enter a pattern and test text to see matches';
      output.classList.add('tool-output--empty');
      summary.textContent='';
      return;
    }

    var regex;
    try{regex=new RegExp(pattern,getFlags());}catch(e){
      setError(e.message||(root.getAttribute('data-invalid-regex')||'Invalid regex pattern'));
      output.textContent='';
      output.classList.add('tool-output--empty');
      summary.textContent='';
      return;
    }

    clearError();
    var matches=[];
    var m;
    regex.lastIndex=0;

    if(regex.flags.includes('g')){
      while((m=regex.exec(text))!==null){matches.push(m);if(m.index===regex.lastIndex)regex.lastIndex++;}
    }else{m=regex.exec(text);if(m)matches.push(m);}

    if(matches.length===0){
      summary.textContent=root.getAttribute('data-no-match')||'No matches found';
      output.textContent=root.getAttribute('data-no-match')||'No matches found';
      output.classList.add('tool-output--empty');
      return;
    }

    var modeLabel = root.getAttribute('data-match-count')||'{count} match(es) found';
    summary.textContent=modeLabel.replace('{count}',String(matches.length));

    var lines=[];
    matches.forEach(function(match,idx){
      var escaped=escapeHtml(match[0]);
      lines.push('['+idx+'] "'+escaped+'" — index '+match.index);
      if(match.length>1){
        for(var g=1;g<match.length;g++){
          if(match[g]!==undefined) lines.push('  Group '+g+': "'+escapeHtml(match[g])+'"');
        }
      }
    });

    output.textContent=lines.join('\n');
    output.classList.remove('tool-output--empty');
  }

  var debouncedTest=window.__belbooreTools.debounce(runTest,200);
  patternInput.addEventListener('input',debouncedTest);
  textArea.addEventListener('input',debouncedTest);

  flagIds.forEach(function(f){
    var cb=document.getElementById('rt-flag-'+f);
    if(cb) cb.addEventListener('change',debouncedTest);
  });

  sampleBtn.addEventListener('click',function(){
    if(!patternInput||!textArea) return;
    patternInput.value='(\\w+)@(\\w+\\.\\w+)';
    textArea.value='user@example.com\nadmin@test.org\nsupport@belboore.ir';
    var gcb=document.getElementById('rt-flag-g');
    if(gcb&&!gcb.checked) gcb.click();
    runTest();
  });

  copyBtn.addEventListener('click',function(){
    if(!output) return;
    var text=output.textContent||'';
    if(!text||output.classList.contains('tool-output--empty')) return;
    window.__belbooreTools.copyToClipboard(text,copyBtn,1500);
  });
</script>

<style>
  .regex-tester{display:flex;flex-direction:column;gap:var(--space-5);}
  .regex-tester__flags{display:flex;flex-wrap:wrap;gap:var(--space-2);}
  .regex-tester__textarea{min-height:160px;}
  .regex-tester__output-shell{display:flex;flex-direction:column;gap:var(--space-3);padding:var(--space-4);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);background:radial-gradient(circle at top right,rgba(0,82,255,0.08),transparent 34%),linear-gradient(180deg,var(--surface-primary),var(--surface-secondary));box-shadow:var(--shadow-sm);}
  .regex-tester__output-head{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);flex-wrap:wrap;}
  .regex-tester__summary{font-size:var(--text-xs);font-weight:var(--weight-semibold);color:var(--color-tech-blue);}
  .regex-tester__output{min-height:140px;white-space:pre-wrap;word-break:break-word;font-family:var(--font-mono);direction:ltr;text-align:left;}
</style>
