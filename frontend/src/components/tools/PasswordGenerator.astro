---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import Checkbox from '../ui/Checkbox.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Password Generator',
    length: 'Length',
    generate: 'Generate',
    copy: 'Copy',
    regenerate: 'Regenerate',
    empty: 'Click Generate to create a password',
    excludeAmbiguous: 'Exclude ambiguous (0OIl1)',
    strength: 'Strength',
    note: 'Passwords are generated entirely in your browser using <code>crypto.getRandomValues</code>. They are never stored or sent anywhere.',
    entropy: 'Entropy',
    bits: 'bits',
    pool: 'Character pool',
    chars: 'chars',
  },
  fa: {
    title: 'تولید رمز عبور',
    length: 'طول',
    generate: 'تولید',
    copy: 'کپی',
    regenerate: 'تولید مجدد',
    empty: 'برای ایجاد رمز عبور روی Generate کلیک کنید',
    excludeAmbiguous: 'حذف کاراکترهای مبهم (0OIl1)',
    strength: 'قدرت',
    note: 'رمزهای عبور کاملاً در مرورگر شما با <code>crypto.getRandomValues</code> تولید می‌شوند. آنها هرگز ذخیره یا ارسال نمی‌شوند.',
    entropy: 'آنتروپی',
    bits: 'بیت',
    pool: 'مجموعه کاراکتر',
    chars: 'کاراکتر',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="pw-tool">
    <div class="pw-controls">
      <div class="pw-controls__length">
        <Input id="pw-length" label={copy[lang].length} type="number" inputmode="numeric" value={16} inputClassName="pw-length-input" />
      </div>
      <div class="pw-controls__charsets">
        <Checkbox id="pw-uppercase" checked>A-Z</Checkbox>
        <Checkbox id="pw-lowercase" checked>a-z</Checkbox>
        <Checkbox id="pw-numbers" checked>0-9</Checkbox>
        <Checkbox id="pw-symbols">!@#$</Checkbox>
        <Checkbox id="pw-ambiguous">{copy[lang].excludeAmbiguous}</Checkbox>
      </div>
    </div>
    <div class="tool-toolbar">
      <ToolActionButton id="pw-generate">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        {copy[lang].generate}
      </ToolActionButton>
      <Button id="pw-copy" variant="outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        {copy[lang].copy}
      </Button>
      <Button id="pw-regenerate" variant="secondary" className="pw-regen-btn" style="display:none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        {copy[lang].regenerate}
      </Button>
    </div>
    <div id="pw-result-card" class="tool-result" style="display:none;" role="status" aria-live="polite">
      <div id="pw-display" class="tool-result__value"></div>
      <div class="pw-strength-bar-wrap">
        <div id="pw-strength-bar" class="pw-strength-bar" style="width:0%"></div>
      </div>
      <div id="pw-strength" class="tool-result__label"></div>
      <div id="pw-entropy" class="pw-entropy"></div>
    </div>
    <div id="pw-empty" class="tool-output tool-output--empty">{copy[lang].empty}</div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span set:html={copy[lang].note} />
    </div>
  </div>
</ToolWorkspace>

<script>
  const lengthInput = document.getElementById('pw-length') as HTMLInputElement;
  const uppercaseCb = document.getElementById('pw-uppercase') as HTMLInputElement;
  const lowercaseCb = document.getElementById('pw-lowercase') as HTMLInputElement;
  const numbersCb = document.getElementById('pw-numbers') as HTMLInputElement;
  const symbolsCb = document.getElementById('pw-symbols') as HTMLInputElement;
  const ambiguousCb = document.getElementById('pw-ambiguous') as HTMLInputElement;
  const resultCard = document.getElementById('pw-result-card')!;
  const pwDisplay = document.getElementById('pw-display')!;
  const pwStrength = document.getElementById('pw-strength')!;
  const pwStrengthBar = document.getElementById('pw-strength-bar')!;
  const pwEntropy = document.getElementById('pw-entropy')!;
  const emptyState = document.getElementById('pw-empty')!;
  const generateBtn = document.getElementById('pw-generate')!;
  const copyBtn = document.getElementById('pw-copy')!;
  const regenerateBtn = document.getElementById('pw-regenerate')!;

  const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const DIGITS = '0123456789';
  const SYMBOLS = '!@#$%^&*()_+-=[]{}|;:,.<>?';
  const AMBIGUOUS = '0OIl1';

  function getCharset(): { charset: string; description: string[] } {
    const parts: string[] = [];
    let charset = '';
    if (uppercaseCb.checked) { charset += UPPER; parts.push('A-Z'); }
    if (lowercaseCb.checked) { charset += LOWER; parts.push('a-z'); }
    if (numbersCb.checked) { charset += DIGITS; parts.push('0-9'); }
    if (symbolsCb.checked) { charset += SYMBOLS; parts.push('!@#$'); }
    if (ambiguousCb.checked) {
      for (const ch of AMBIGUOUS) {
        charset = charset.replace(ch, '');
      }
    }
    return { charset, description: parts };
  }

  function clampLength() {
    let len = parseInt(lengthInput.value, 10);
    if (isNaN(len) || len < 6) len = 6;
    if (len > 64) len = 64;
    lengthInput.value = String(len);
    return len;
  }

  lengthInput.addEventListener('blur', clampLength);

  function generatePassword(length: number, charset: string): string {
    const array = new Uint32Array(length);
    crypto.getRandomValues(array);
    let result = '';
    for (let i = 0; i < length; i++) {
      result += charset[array[i] % charset.length];
    }
    return result;
  }

  function getStrength(length: number, poolSize: number): { label: string; score: number; color: string } {
    const entropy = length * Math.log2(poolSize);
    if (entropy < 40) return { label: 'Weak', score: 20, color: '#ef4444' };
    if (entropy < 60) return { label: 'Fair', score: 40, color: '#f97316' };
    if (entropy < 80) return { label: 'Good', score: 60, color: '#eab308' };
    if (entropy < 100) return { label: 'Strong', score: 80, color: '#22c55e' };
    return { label: 'Very Strong', score: 100, color: '#16a34a' };
  }

  function doGenerate() {
    const length = clampLength();
    const { charset, description } = getCharset();

    if (!charset || description.length === 0) {
      emptyState.textContent = 'Select at least one character set';
      emptyState.style.display = '';
      resultCard.style.display = 'none';
      regenerateBtn.style.display = 'none';
      return;
    }

    const password = generatePassword(length, charset);
    const poolSize = new Set(charset).size;
    const strength = getStrength(length, poolSize);
    const entropy = length * Math.log2(poolSize);

    pwDisplay.textContent = password;
    pwStrength.textContent = 'Strength: ' + strength.label + ' \u2014 ' + description.join(', ');
    pwStrengthBar.style.width = strength.score + '%';
    pwStrengthBar.style.background = strength.color;
    pwEntropy.textContent = 'Entropy: ' + entropy.toFixed(1) + ' bits \u2014 Pool: ' + poolSize + ' chars';
    emptyState.style.display = 'none';
    resultCard.style.display = '';
    regenerateBtn.style.display = '';
  }

  generateBtn.addEventListener('click', doGenerate);
  regenerateBtn.addEventListener('click', doGenerate);

  copyBtn.addEventListener('click', () => {
    const text = pwDisplay.textContent || '';
    if (!text) return;
    window.__belbooreTools.copyToClipboard(text, copyBtn, 1500);
  });
</script>

<style>
  .pw-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .pw-tool .tool-note {
    margin-top: 0;
  }
  .pw-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .pw-controls__length {
    max-width: 120px;
  }
  .pw-length-input {
    text-align: center;
    font-weight: var(--weight-semibold);
  }
  .pw-controls__charsets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pw-strength-bar-wrap {
    height: 6px;
    background: var(--surface-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin: var(--space-3) 0 var(--space-1);
  }
  .pw-strength-bar {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.3s ease, background 0.3s ease;
  }
  .pw-entropy {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    margin-top: var(--space-1);
  }
  .pw-regen-btn { display: none; }
  @media (max-width: 640px) {
    .pw-controls__charsets { flex-direction: column; }
  }
</style>
