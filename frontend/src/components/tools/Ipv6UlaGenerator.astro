---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'IPv6 ULA Generator',
    generate: 'Generate',
    copyPrefix: 'Copy Prefix',
    copyAddress: 'Copy Address',
    regenerate: 'Regenerate',
    emptyState: 'Click Generate to create a ULA prefix',
    note: 'ULAs use fd00::/8 with a randomly generated 40-bit Global ID. All generation uses cryptographically secure randomness.',
    prefix: 'ULA Prefix',
    subnetZero: 'First /64 Subnet',
    prefixFormat: 'fdXX:XXXX:XXXX::/48',
    subnetFormat: 'fdXX:XXXX:XXXX::/64',
    howToUse: 'This prefix can be used for internal networks. The /48 prefix gives you 65536 /64 subnets.',
  },
  fa: {
    title: 'تولید ULA IPv6',
    generate: 'تولید',
    copyPrefix: 'کپی پیشوند',
    copyAddress: 'کپی آدرس',
    regenerate: 'تولید مجدد',
    emptyState: 'روی Generate کلیک کنید تا پیشوند ULA ساخته شود',
    note: 'ULA ها از محدوده fd00::/8 با Global ID 40 بیتی تصادفی استفاده می‌کنند. تمام تولید با اعداد تصادفی امن رمزنگاری انجام می‌شود.',
    prefix: 'پیشوند ULA',
    subnetZero: 'اولین زیرشبکه /64',
    prefixFormat: 'fdXX:XXXX:XXXX::/48',
    subnetFormat: 'fdXX:XXXX:XXXX::/64',
    howToUse: 'این پیشوند می‌تواند برای شبکه‌های داخلی استفاده شود. پیشوند /48 به شما ۶۵۵۳۶ زیرشبکه /64 می‌دهد.',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="ula-tool">
    <div class="tool-toolbar">
      <ToolActionButton id="ula-generate">{copy[lang].generate}</ToolActionButton>
      <Button id="ula-regenerate" variant="secondary" className="ula-regen-btn" style="display:none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        {copy[lang].regenerate}
      </Button>
    </div>
    <div id="ula-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>
    <div id="ula-result-card" style="display:none">
      <div class="ula-result">
        <div class="ula-item">
          <span class="ula-item-label">{copy[lang].prefix}</span>
          <div class="ula-item-row">
            <span id="ula-prefix" class="ula-item-value"></span>
            <button id="ula-copy-prefix" class="ula-copy-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </div>
        <div class="ula-item">
          <span class="ula-item-label">{copy[lang].subnetZero}</span>
          <div class="ula-item-row">
            <span id="ula-subnet" class="ula-item-value"></span>
            <button id="ula-copy-subnet" class="ula-copy-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="ula-note-text">{copy[lang].howToUse}</div>
    </div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { generateIpv6UlaPrefix } from './networkUtils.ts';

  const generateBtn = document.getElementById('ula-generate')!;
  const regenerateBtn = document.getElementById('ula-regenerate')!;
  const emptyEl = document.getElementById('ula-empty')!;
  const resultCard = document.getElementById('ula-result-card')!;
  const prefixEl = document.getElementById('ula-prefix')!;
  const subnetEl = document.getElementById('ula-subnet')!;
  const copyPrefixBtn = document.getElementById('ula-copy-prefix')!;
  const copySubnetBtn = document.getElementById('ula-copy-subnet')!;

  function doGenerate() {
    const prefix = generateIpv6UlaPrefix();
    const subnet = prefix.replace('::/48', ':0000::/64');
    prefixEl.textContent = prefix;
    subnetEl.textContent = subnet;
    emptyEl.style.display = 'none';
    resultCard.style.display = '';
    regenerateBtn.style.display = '';
  }

  generateBtn.addEventListener('click', doGenerate);
  regenerateBtn.addEventListener('click', doGenerate);

  copyPrefixBtn.addEventListener('click', () => {
    const text = prefixEl.textContent || '';
    if (!text) return;
    window.__belbooreTools.copyToClipboard(text, copyPrefixBtn, 1500);
  });

  copySubnetBtn.addEventListener('click', () => {
    const text = subnetEl.textContent || '';
    if (!text) return;
    window.__belbooreTools.copyToClipboard(text, copySubnetBtn, 1500);
  });
</script>

<style>
  .ula-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .ula-tool .tool-note { margin-top: 0; }
  .ula-regen-btn { display: none; }
  .ula-result { display: flex; flex-direction: column; gap: var(--space-3); }
  .ula-item {
    background: var(--surface-secondary); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); padding: var(--space-3) var(--space-4);
    display: flex; flex-direction: column; gap: var(--space-1);
  }
  .ula-item-label { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; }
  .ula-item-row { display: flex; align-items: center; gap: var(--space-2); }
  .ula-item-value { font-family: var(--font-mono); font-size: var(--text-sm); word-break: break-all; color: var(--text-primary); line-height: 1.4; flex: 1; }
  .ula-copy-btn {
    background: none; border: none; cursor: pointer; color: var(--text-tertiary); padding: var(--space-1); border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .ula-copy-btn:hover { color: var(--color-tech-blue); background: var(--color-tech-blue-subtle); }
  .ula-note-text { font-size: var(--text-xs); color: var(--text-tertiary); padding: var(--space-2) var(--space-1); }
</style>
