---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Crontab Generator / تولید Crontab',
    everyMinute: 'Every minute',
    everyN: 'Every N minutes',
    hourly: 'Hourly',
    daily: 'Daily at time',
    weekly: 'Weekly on days',
    monthly: 'Monthly on day and time',
    minutes: 'Minutes',
    time: 'Time',
    dayOfMonth: 'Day of month',
    dayOfWeek: 'Day of week',
    sun: 'Sun',
    mon: 'Mon',
    tue: 'Tue',
    wed: 'Wed',
    thu: 'Thu',
    fri: 'Fri',
    sat: 'Sat',
    generatedCron: 'Generated Cron Expression',
    explanation: 'Description',
    copy: 'Copy',
    clear: 'Clear',
    copied: 'Copied!',
    empty: 'Select a mode to generate a cron expression',
    note: 'All processing happens in your browser. Your data is never uploaded.',
    error: 'Invalid configuration',
  },
  fa: {
    title: 'تولید Crontab',
    everyMinute: 'هر دقیقه',
    everyN: 'هر N دقیقه',
    hourly: 'هر ساعت',
    daily: 'روزانه در ساعت',
    weekly: 'هفتگی در روزهای',
    monthly: 'ماهانه در روز و ساعت',
    minutes: 'دقیقه',
    time: 'ساعت',
    dayOfMonth: 'روز ماه',
    dayOfWeek: 'روز هفته',
    sun: 'یک',
    mon: 'دو',
    tue: 'سه',
    wed: 'چهار',
    thu: 'پنج',
    fri: 'جمعه',
    sat: 'شنبه',
    generatedCron: 'عبارت Cron تولید شده',
    explanation: 'توضیح',
    copy: 'کپی',
    clear: 'پاک کردن',
    copied: 'کپی شد!',
    empty: 'یک حالت انتخاب کنید تا عبارت cron ساخته شود',
    note: 'تمام پردازش‌ها در مرورگر شما انجام می‌شود. داده‌های شما آپلود نمی‌شود.',
    error: 'تنظیمات نامعتبر',
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section class="cg-tool" dir={dir} data-empty={copy.empty} data-copied={copy.copied} data-error={copy.error}>
    <div class="cg-tool__controls">
      <div class="cg-tool__mode-group" role="radiogroup" aria-label="Cron mode">
        <button id="cg-mode-every-minute" class="cg-tool__mode-btn is-active" type="button" data-mode="every-minute">{copy.everyMinute}</button>
        <button id="cg-mode-every-n" class="cg-tool__mode-btn" type="button" data-mode="every-n">{copy.everyN}</button>
        <button id="cg-mode-hourly" class="cg-tool__mode-btn" type="button" data-mode="hourly">{copy.hourly}</button>
        <button id="cg-mode-daily" class="cg-tool__mode-btn" type="button" data-mode="daily">{copy.daily}</button>
        <button id="cg-mode-weekly" class="cg-tool__mode-btn" type="button" data-mode="weekly">{copy.weekly}</button>
        <button id="cg-mode-monthly" class="cg-tool__mode-btn" type="button" data-mode="monthly">{copy.monthly}</button>
      </div>
    </div>

    <div id="cg-params" class="cg-tool__params">
      <div id="cg-params-every-n" class="cg-tool__param-group" style="display:none;">
        <Input id="cg-n-minutes" label={copy.minutes} type="number" className="cg-tool__input" value="5" min="1" max="59" />
      </div>
      <div id="cg-params-daily" class="cg-tool__param-group" style="display:none;">
        <Input id="cg-daily-time" label={copy.time} type="time" className="cg-tool__input" value="00:00" />
      </div>
      <div id="cg-params-weekly" class="cg-tool__param-group" style="display:none;">
        <fieldset class="cg-tool__day-checkboxes">
          <legend class="cg-tool__legend">{copy.dayOfWeek}</legend>
          <label class="cg-tool__day-cb"><input type="checkbox" id="cg-day-0" value="0" /> {copy.sun}</label>
          <label class="cg-tool__day-cb"><input type="checkbox" id="cg-day-1" value="1" /> {copy.mon}</label>
          <label class="cg-tool__day-cb"><input type="checkbox" id="cg-day-2" value="2" /> {copy.tue}</label>
          <label class="cg-tool__day-cb"><input type="checkbox" id="cg-day-3" value="3" /> {copy.wed}</label>
          <label class="cg-tool__day-cb"><input type="checkbox" id="cg-day-4" value="4" /> {copy.thu}</label>
          <label class="cg-tool__day-cb"><input type="checkbox" id="cg-day-5" value="5" /> {copy.fri}</label>
          <label class="cg-tool__day-cb"><input type="checkbox" id="cg-day-6" value="6" /> {copy.sat}</label>
        </fieldset>
        <Input id="cg-weekly-time" label={copy.time} type="time" className="cg-tool__input" value="00:00" />
      </div>
      <div id="cg-params-monthly" class="cg-tool__param-group" style="display:none;">
        <Input id="cg-month-day" label={copy.dayOfMonth} type="number" className="cg-tool__input" value="1" min="1" max="31" />
        <Input id="cg-monthly-time" label={copy.time} type="time" className="cg-tool__input" value="00:00" />
      </div>
    </div>

    <div class="cg-tool__output-shell">
      <div class="cg-tool__output-head">
        <span class="cg-tool__label">{copy.generatedCron}</span>
        <Button id="cg-copy" variant="outline">{copy.copy}</Button>
      </div>
      <div id="cg-expression" class="cg-tool__expression">* * * * *</div>
      <div class="cg-tool__explanation-head">
        <span class="cg-tool__label">{copy.explanation}</span>
      </div>
      <div id="cg-explanation" class="cg-tool__explanation">Run every minute</div>
    </div>

    <div id="cg-error" class="tool-error" style="display: none;" role="alert"></div>

    <div class="tool-note cg-tool__note">{copy.note}</div>
  </section>
</ToolWorkspace>

<script>
  let activeMode = 'every-minute';

  const modeBtns = document.querySelectorAll('.cg-tool__mode-btn');
  const expressionEl = document.getElementById('cg-expression');
  const explanationEl = document.getElementById('cg-explanation');
  const errorDiv = document.getElementById('cg-error');
  const copyBtn = document.getElementById('cg-copy');

  const DAY_NAMES_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const DAY_NAMES_FA = ['یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنج‌شنبه', 'جمعه', 'شنبه'];
  const isFa = document.querySelector('.cg-tool')?.getAttribute('dir') === 'rtl';
  const DAY_NAMES = isFa ? DAY_NAMES_FA : DAY_NAMES_EN;

  function paramGroup(id: string): HTMLElement | null {
    return document.getElementById(id);
  }

  function setMode(mode: string) {
    activeMode = mode;
    modeBtns.forEach(btn => btn.classList.toggle('is-active', btn.dataset.mode === mode));

    const groups = ['cg-params-every-n', 'cg-params-daily', 'cg-params-weekly', 'cg-params-monthly'];
    groups.forEach(id => { const el = paramGroup(id); if (el) el.style.display = 'none'; });

    if (mode === 'every-n') { const el = paramGroup('cg-params-every-n'); if (el) el.style.display = 'flex'; }
    else if (mode === 'daily') { const el = paramGroup('cg-params-daily'); if (el) el.style.display = 'flex'; }
    else if (mode === 'weekly') { const el = paramGroup('cg-params-weekly'); if (el) el.style.display = 'flex'; }
    else if (mode === 'monthly') { const el = paramGroup('cg-params-monthly'); if (el) el.style.display = 'flex'; }

    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    generate();
  }

  function generate() {
    if (!expressionEl || !explanationEl) return;
    try {
      let cron = '';
      let explanation = '';

      switch (activeMode) {
        case 'every-minute':
          cron = '* * * * *';
          explanation = isFa ? 'هر دقیقه اجرا شود' : 'Run every minute';
          break;
        case 'every-n': {
          const nInput = document.getElementById('cg-n-minutes') as HTMLInputElement | null;
          const n = parseInt(nInput?.value || '5', 10);
          if (isNaN(n) || n < 1 || n > 59) throw new Error(isFa ? 'عدد معتبر بین ۱ تا ۵۹ وارد کنید' : 'Enter a valid number between 1 and 59');
          cron = `*/${n} * * * *`;
          explanation = (isFa ? `هر ${n} دقیقه اجرا شود` : `Run every ${n} minutes`);
          break;
        }
        case 'hourly':
          cron = '0 * * * *';
          explanation = isFa ? 'هر ساعت اجرا شود (دقیقه ۰)' : 'Run every hour (at minute 0)';
          break;
        case 'daily': {
          const timeInput = document.getElementById('cg-daily-time') as HTMLInputElement | null;
          const timeVal = timeInput?.value || '00:00';
          const [h, m] = timeVal.split(':');
          cron = `${parseInt(m, 10)} ${parseInt(h, 10)} * * *`;
          explanation = (isFa ? `روزانه در ساعت ${h}:${m} اجرا شود` : `Run daily at ${h}:${m}`);
          break;
        }
        case 'weekly': {
          const timeInput = document.getElementById('cg-weekly-time') as HTMLInputElement | null;
          const timeVal = timeInput?.value || '00:00';
          const [h, m] = timeVal.split(':');
          const checkedDays: number[] = [];
          for (let d = 0; d <= 6; d++) {
            const cb = document.getElementById(`cg-day-${d}`) as HTMLInputElement | null;
            if (cb?.checked) checkedDays.push(d);
          }
          if (checkedDays.length === 0) throw new Error(isFa ? 'حداقل یک روز هفته را انتخاب کنید' : 'Select at least one day of the week');
          const dayLabels = checkedDays.map(d => DAY_NAMES[d]);
          cron = `${parseInt(m, 10)} ${parseInt(h, 10)} * * ${checkedDays.join(',')}`;
          explanation = (isFa ? `هفتگی در ${dayLabels.join('، ')} ساعت ${h}:${m}` : `Run weekly on ${dayLabels.join(', ')} at ${h}:${m}`);
          break;
        }
        case 'monthly': {
          const dayInput = document.getElementById('cg-month-day') as HTMLInputElement | null;
          const timeInput = document.getElementById('cg-monthly-time') as HTMLInputElement | null;
          const dayVal = parseInt(dayInput?.value || '1', 10);
          const timeVal = timeInput?.value || '00:00';
          const [h, m] = timeVal.split(':');
          if (isNaN(dayVal) || dayVal < 1 || dayVal > 31) throw new Error(isFa ? 'روز معتبر بین ۱ تا ۳۱ وارد کنید' : 'Enter a valid day between 1 and 31');
          cron = `${parseInt(m, 10)} ${parseInt(h, 10)} ${dayVal} * *`;
          explanation = (isFa ? `ماهانه در روز ${dayVal} ساعت ${h}:${m}` : `Run monthly on day ${dayVal} at ${h}:${m}`);
          break;
        }
      }

      expressionEl.textContent = cron;
      explanationEl.textContent = explanation;
      if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    } catch (e: any) {
      if (expressionEl) expressionEl.textContent = '';
      if (explanationEl) explanationEl.textContent = '';
      if (errorDiv) { errorDiv.textContent = e?.message || copy.error; errorDiv.style.display = ''; }
    }
  }

  modeBtns.forEach(btn => btn.addEventListener('click', () => setMode(btn.dataset.mode || 'every-minute')));

  document.querySelectorAll('.cg-tool__params input, .cg-tool__params select').forEach(el => {
    el.addEventListener('input', generate);
    el.addEventListener('change', generate);
  });

  copyBtn?.addEventListener('click', () => {
    if (!expressionEl || !expressionEl.textContent) return;
    navigator.clipboard.writeText(expressionEl.textContent).then(() => {
      copyBtn.classList.add('is-copied');
      const orig = copyBtn.innerHTML;
      copyBtn.innerHTML = copy.copied;
      setTimeout(() => { copyBtn.innerHTML = orig; copyBtn.classList.remove('is-copied'); }, 1200);
    }).catch(() => {});
  });

  generate();
</script>

<style>
  .cg-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .cg-tool__controls { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .cg-tool__mode-group { display: inline-flex; flex-wrap: wrap; gap: var(--space-1); padding: var(--space-1); background: var(--surface-tertiary); border: 1px solid var(--border-subtle); border-radius: var(--radius-xl); }
  .cg-tool__mode-btn { border: 0; border-radius: var(--radius-lg); padding: var(--space-2) var(--space-4); font: inherit; font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--text-tertiary); background: transparent; cursor: pointer; transition: all var(--duration-fast) var(--ease-out); }
  .cg-tool__mode-btn.is-active { color: var(--color-tech-blue); background: var(--surface-primary); box-shadow: var(--shadow-sm); }
  .cg-tool__mode-btn:focus-visible { outline: 2px solid var(--color-tech-blue); outline-offset: 2px; }
  .cg-tool__params { display: flex; flex-wrap: wrap; gap: var(--space-4); padding: var(--space-4); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: var(--surface-tertiary); }
  .cg-tool__param-group { display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: flex-end; width: 100%; }
  .cg-tool__input { min-width: 120px; max-width: 200px; }
  .cg-tool__legend { color: var(--text-secondary); font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2); }
  .cg-tool__day-checkboxes { border: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; }
  .cg-tool__day-cb { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-sm); color: var(--text-secondary); cursor: pointer; }
  .cg-tool__day-cb input { accent-color: var(--color-tech-blue); width: 16px; height: 16px; }
  .cg-tool__output-shell { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-5); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); background: radial-gradient(circle at top right, rgba(0, 82, 255, 0.1), transparent 35%), linear-gradient(180deg, var(--surface-primary), var(--surface-secondary)); box-shadow: var(--shadow-sm); }
  .cg-tool__output-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
  .cg-tool__label { color: var(--text-secondary); font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.06em; }
  .cg-tool__expression { font-family: var(--font-mono); font-size: var(--text-xl); font-weight: var(--weight-bold); color: var(--color-tech-blue); padding: var(--space-4); background: var(--surface-primary); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); text-align: center; letter-spacing: 0.1em; }
  .cg-tool__explanation-head { margin-top: var(--space-2); }
  .cg-tool__explanation { font-size: var(--text-base); color: var(--text-secondary); padding: var(--space-3) 0; }
  .cg-tool__note { margin-top: 0; }
  @media (max-width: 768px) { .cg-tool__mode-group { width: 100%; } .cg-tool__mode-btn { flex: 1 1 auto; text-align: center; } .cg-tool__input { min-width: 0; width: 100%; max-width: none; } .cg-tool__params { flex-direction: column; } }
</style>
