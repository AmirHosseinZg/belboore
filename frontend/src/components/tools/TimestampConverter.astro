---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Timestamp Converter',
    tsLabel: 'Unix Timestamp (seconds)',
    tsPlaceholder: 'e.g. 1717171200',
    dateLabel: 'Human-readable Date',
    now: 'Now',
    emptyState: 'Enter a timestamp or pick a date',
    note: 'Convert between Unix timestamps and human-readable dates. All processing is client-side.',
    unixTimestamp: 'Unix Timestamp',
    iso8601: 'ISO 8601',
    local: 'Local',
    utc: 'UTC',
    relative: 'Relative',
    copy: 'Copy',
  },
  fa: {
    title: 'مبدل Timestamp',
    tsLabel: 'Timestamp یونیکس (ثانیه)',
    tsPlaceholder: 'مثلاً 1717171200',
    dateLabel: 'تاریخ قابل خواندن',
    now: 'اکنون',
    emptyState: 'یک timestamp یا تاریخ وارد کنید',
    note: 'تبدیل بین timestamp های یونیکس و تاریخ‌های قابل خواندن. تمام پردازش در سمت کاربر است.',
    unixTimestamp: 'Timestamp یونیکس',
    iso8601: 'ISO 8601',
    local: 'محلی',
    utc: 'UTC',
    relative: 'نسبی',
    copy: 'کپی',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="tc-tool">
    <div class="tc-input-row">
      <Input id="tc-ts" label={copy[lang].tsLabel} type="number" placeholder={copy[lang].tsPlaceholder} inputClassName="tc-mono-input" />
      <Input id="tc-date" label={copy[lang].dateLabel} type="datetime-local" inputClassName="tc-mono-input" />
      <ToolActionButton id="tc-now">{copy[lang].now}</ToolActionButton>
    </div>

    <div id="tc-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>

    <div id="tc-result-card" class="tc-result-card" style="display:none">
      <div class="tc-result-header">
        <span class="tc-result-label">Output</span>
        <Button id="tc-copy" variant="outline" className="tc-copy-btn">{copy[lang].copy}</Button>
      </div>
      <div class="tc-result-rows">
        <div class="tc-row"><span class="tc-label">{copy[lang].unixTimestamp}</span><span id="tc-r-ts" class="tc-value"></span></div>
        <div class="tc-row"><span class="tc-label">{copy[lang].iso8601}</span><span id="tc-r-iso" class="tc-value"></span></div>
        <div class="tc-row"><span class="tc-label">{copy[lang].utc}</span><span id="tc-r-utc" class="tc-value"></span></div>
        <div class="tc-row"><span class="tc-label">{copy[lang].local}</span><span id="tc-r-local" class="tc-value"></span></div>
        <div class="tc-row"><span class="tc-label">{copy[lang].relative}</span><span id="tc-r-rel" class="tc-value"></span></div>
      </div>
    </div>

    <div id="tc-error" class="tool-error" style="display:none"></div>

    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  const tcTs = document.getElementById('tc-ts') as HTMLInputElement;
  const tcDate = document.getElementById('tc-date') as HTMLInputElement;
  const tcNow = document.getElementById('tc-now') as HTMLButtonElement;
  const emptyEl = document.getElementById('tc-empty')!;
  const resultCard = document.getElementById('tc-result-card')!;
  const rTs = document.getElementById('tc-r-ts')!;
  const rIso = document.getElementById('tc-r-iso')!;
  const rUtc = document.getElementById('tc-r-utc')!;
  const rLocal = document.getElementById('tc-r-local')!;
  const rRel = document.getElementById('tc-r-rel')!;
  const copyBtn = document.getElementById('tc-copy') as HTMLButtonElement;
  const errorEl = document.getElementById('tc-error')!;

  let debounceTimer: ReturnType<typeof setTimeout> | null = null;

  function pad(n: number) { return n < 10 ? '0' + n : '' + n; }

  function toLocalISO(d: Date) {
    const off = d.getTimezoneOffset();
    const sign = off <= 0 ? '+' : '-';
    const abs = Math.abs(off);
    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
      'T' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()) +
      sign + pad(Math.floor(abs / 60)) + ':' + pad(abs % 60);
  }

  function relativeTime(d: Date) {
    const now = new Date();
    const diff = now.getTime() - d.getTime();
    const abs = Math.abs(diff);
    const sec = Math.floor(abs / 1000);
    if (sec < 5) return 'just now';
    if (sec < 60) return sec + ' second' + (sec === 1 ? '' : 's') + (diff > 0 ? ' ago' : ' from now');
    const min = Math.floor(sec / 60);
    if (min < 60) return min + ' minute' + (min === 1 ? '' : 's') + (diff > 0 ? ' ago' : ' from now');
    const hr = Math.floor(min / 60);
    if (hr < 24) return hr + ' hour' + (hr === 1 ? '' : 's') + (diff > 0 ? ' ago' : ' from now');
    const days = Math.floor(hr / 24);
    if (days < 30) return days + ' day' + (days === 1 ? '' : 's') + (diff > 0 ? ' ago' : ' from now');
    const months = Math.floor(days / 30);
    if (months < 12) return months + ' month' + (months === 1 ? '' : 's') + (diff > 0 ? ' ago' : ' from now');
    const years = Math.floor(days / 365);
    return years + ' year' + (years === 1 ? '' : 's') + (diff > 0 ? ' ago' : ' from now');
  }

  function renderOutput(ts: number, d: Date) {
    rTs.textContent = String(ts);
    rIso.textContent = d.toISOString();
    rUtc.textContent = d.toUTCString();
    rLocal.textContent = d.toLocaleString();
    rRel.textContent = relativeTime(d);
    emptyEl.style.display = 'none';
    resultCard.style.display = '';
    errorEl.style.display = 'none';
  }

  function updateFromTimestamp() {
    const val = tcTs.value.trim();
    if (!val) {
      if (!tcDate.value) { emptyEl.style.display = ''; resultCard.style.display = 'none'; }
      return;
    }
    const ts = parseInt(val, 10);
    if (isNaN(ts)) { showError(); return; }
    const d = new Date(ts * 1000);
    if (isNaN(d.getTime())) { showError(); return; }
    tcDate.value = toLocalISO(d).slice(0, 16);
    renderOutput(ts, d);
  }

  function updateFromDate() {
    const val = tcDate.value;
    if (!val) return;
    const d = new Date(val);
    if (isNaN(d.getTime())) return;
    const ts = Math.floor(d.getTime() / 1000);
    tcTs.value = String(ts);
    renderOutput(ts, d);
  }

  function showError() {
    emptyEl.style.display = '';
    resultCard.style.display = 'none';
    errorEl.textContent = 'Enter a timestamp or pick a date';
    errorEl.style.display = '';
  }

  function debounced(fn: () => void) {
    return () => {
      clearTimeout(debounceTimer as number);
      debounceTimer = setTimeout(fn, 150);
    };
  }

  tcTs.addEventListener('input', debounced(updateFromTimestamp));
  tcDate.addEventListener('input', debounced(updateFromDate));
  tcDate.addEventListener('change', debounced(updateFromDate));

  tcNow.addEventListener('click', () => {
    const d = new Date();
    const ts = Math.floor(d.getTime() / 1000);
    tcTs.value = String(ts);
    tcDate.value = toLocalISO(d).slice(0, 16);
    renderOutput(ts, d);
  });

  copyBtn.addEventListener('click', () => {
    const text = `Unix Timestamp: ${rTs.textContent}\nISO 8601: ${rIso.textContent}\nUTC: ${rUtc.textContent}\nLocal: ${rLocal.textContent}\nRelative: ${rRel.textContent}`;
    if (!text || resultCard.style.display === 'none') return;
    window.__belbooreTools.copyToClipboard(text, copyBtn, 1500);
  });
</script>

<style>
  .tc-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .tc-tool .tool-note { margin-top: 0; }
  .tc-input-row { display: flex; gap: var(--space-3); align-items: flex-end; flex-wrap: wrap; }
  .tc-input-row .ui-input-field { flex: 1; min-width: 200px; }
  .tc-mono-input { font-family: var(--font-mono); }

  .tc-result-card {
    background: var(--surface-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .tc-result-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-primary);
  }
  .tc-result-label {
    font-size: var(--text-xs); font-weight: var(--weight-semibold);
    color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em;
  }
  .tc-copy-btn { font-size: var(--text-xs) !important; padding: var(--space-1) var(--space-3) !important; }
  .tc-result-rows { padding: var(--space-2) var(--space-4); }
  .tc-row {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .tc-row:last-child { border-bottom: none; }
  .tc-label {
    font-size: var(--text-xs); font-weight: var(--weight-semibold);
    color: var(--text-tertiary); min-width: 140px;
    text-transform: uppercase; letter-spacing: 0.04em; flex-shrink: 0;
  }
  .tc-value {
    font-family: var(--font-mono); font-size: var(--text-sm);
    color: var(--text-primary); word-break: break-all; flex: 1;
  }

  @media (max-width: 640px) {
    .tc-input-row { flex-direction: column; }
    .tc-input-row .ui-input-field { min-width: 100%; }
    .tc-row { flex-wrap: wrap; gap: var(--space-1); }
    .tc-label { min-width: 100%; margin-bottom: var(--space-1); }
    .tc-result-rows { padding: var(--space-2) var(--space-3); }
  }
</style>
