---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import Button from '../ui/Button.astro';
import Select from '../ui/Select.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'BIP39 Passphrase Generator',
    wordCountLabel: 'Word count',
    generate: 'Generate',
    copy: 'Copy',
    clear: 'Clear',
    empty: 'Click Generate to create a mnemonic phrase',
    copied: 'Copied!',
    note: 'All processing happens in your browser. Your data is never uploaded.',
    securityWarning: 'This tool generates mnemonic phrases locally in your browser. Do not use a mnemonic for real funds unless you trust the device, browser, and implementation. Never share your phrase with anyone.',
  },
  fa: {
    title: 'تولید عبارت BIP39',
    wordCountLabel: 'تعداد کلمات',
    generate: 'تولید',
    copy: 'کپی',
    clear: 'پاک کردن',
    empty: 'برای تولید عبارت کلیک کنید',
    copied: 'کپی شد!',
    note: 'تمام پردازش‌ها در مرورگر شما انجام می‌شود. داده‌های شما آپلود نمی‌شود.',
    securityWarning: 'این ابزار عبارات یادآور را به صورت محلی در مرورگر شما تولید می‌کند. از عبارت یادآور برای وجوه واقعی استفاده نکنید مگر اینکه به دستگاه، مرورگر و پیاده‌سازی اعتماد دارید. هرگز عبارت خود را با کسی به اشتراک نگذارید.',
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section class="bpg-tool" dir={dir} data-empty={copy.empty} data-copied={copy.copied}>
    <div class="bpg-tool__controls">
      <Select id="bpg-word-count" label={copy.wordCountLabel} className="bpg-tool__select" selectedValue="12" options={[
        { value: '12', label: '12' },
        { value: '15', label: '15' },
        { value: '18', label: '18' },
        { value: '21', label: '21' },
        { value: '24', label: '24' },
      ]} />
      <div class="bpg-tool__actions">
        <Button id="bpg-copy" variant="outline">{copy.copy}</Button>
        <Button id="bpg-clear" variant="danger">{copy.clear}</Button>
      </div>
    </div>

    <div class="bpg-tool__output-shell">
      <div id="bpg-output" class="tool-output tool-output--empty bpg-tool__output" role="status" aria-live="polite">{copy.empty}</div>
    </div>

    <div class="bpg-tool__toolbar">
      <ToolActionButton id="bpg-generate">{copy.generate}</ToolActionButton>
    </div>

    <div id="bpg-error" class="tool-error" style="display: none;" role="alert"></div>

    <div class="bpg-tool__security">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy.securityWarning}
    </div>

    <div class="tool-note bpg-tool__note">{copy.note}</div>
  </section>
</ToolWorkspace>

<script>
  import { generateMnemonic } from 'bip39';

  const wordCountSelect = document.getElementById('bpg-word-count') as HTMLSelectElement | null;
  const output = document.getElementById('bpg-output')!;
  const errorDiv = document.getElementById('bpg-error') as HTMLDivElement | null;
  const generateBtn = document.getElementById('bpg-generate') as HTMLButtonElement | null;
  const copyBtn = document.getElementById('bpg-copy') as HTMLButtonElement | null;
  const clearBtn = document.getElementById('bpg-clear') as HTMLButtonElement | null;
  const root = document.querySelector('.bpg-tool') as HTMLElement | null;
  const emptyText = root?.dataset.empty || 'Click Generate to create a mnemonic phrase';

  function getWordCount(): number {
    const val = parseInt(wordCountSelect?.value || '12', 10);
    const valid = [12, 15, 18, 21, 24];
    return valid.includes(val) ? val : 12;
  }

  function renderMnemonic(words: string[]) {
    output.classList.remove('tool-output--empty', 'tool-output--error');
    output.textContent = '';
    const container = document.createElement('div');
    container.className = 'bpg-tool__chips';
    words.forEach((word, i) => {
      const chip = document.createElement('span');
      chip.className = 'bpg-tool__chip';
      const num = document.createElement('span');
      num.className = 'bpg-tool__chip-num';
      num.textContent = String(i + 1);
      const text = document.createElement('span');
      text.textContent = word;
      chip.appendChild(num);
      chip.appendChild(text);
      container.appendChild(chip);
    });
    output.appendChild(container);
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
  }

  function showEmpty() {
    window.__belbooreTools.showEmpty(output, emptyText);
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
  }

  function showError(msg: string) {
    if (errorDiv) { errorDiv.textContent = msg; errorDiv.style.display = ''; }
    window.__belbooreTools.showError(output, msg);
  }

  generateBtn?.addEventListener('click', () => {
    try {
      const strength = getWordCount();
      const entropy = strength === 12 ? 128 : strength === 15 ? 160 : strength === 18 ? 192 : strength === 21 ? 224 : 256;
      const mnemonic = generateMnemonic(entropy);
      const words = mnemonic.split(' ');
      renderMnemonic(words);
    } catch (e: any) {
      showError(e?.message || 'Generation failed');
    }
  });

  copyBtn?.addEventListener('click', () => {
    if (output.classList.contains('tool-output--empty')) return;
    const text = Array.from(output.querySelectorAll('.bpg-tool__chip')).map(chip => chip.textContent?.trim()).filter(Boolean).join(' ');
    if (!text) return;
    window.__belbooreTools.copyToClipboard(text, copyBtn!, 1500);
  });

  clearBtn?.addEventListener('click', () => {
    showEmpty();
  });
</script>

<style>
  .bpg-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .bpg-tool__controls { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  .bpg-tool__select { min-width: 180px; }
  .bpg-tool__actions { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; }
  .bpg-tool__output-shell { min-height: 0; }
  .bpg-tool__output { min-height: 120px; padding: var(--space-4); }
  .bpg-tool__output.tool-output--empty { display: flex; align-items: center; justify-content: center; }
  .bpg-tool__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .bpg-tool__chip { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3); background: var(--surface-tertiary); border: 1px solid var(--border-subtle); border-radius: var(--radius-full); font-family: var(--font-mono); font-size: var(--text-sm); color: var(--text-primary); }
  .bpg-tool__chip-num { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: var(--radius-full); background: var(--color-tech-blue); color: white; font-size: var(--text-xs); font-weight: var(--weight-bold); }
  .bpg-tool__toolbar { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .bpg-tool .tool-action-button { min-width: 148px; }
  .bpg-tool__security { display: flex; align-items: flex-start; gap: var(--space-2); padding: var(--space-3) var(--space-4); background: var(--color-error-subtle); border: 1px solid var(--color-error-border); border-radius: var(--radius-md); color: var(--color-error); font-size: var(--text-xs); line-height: var(--leading-normal); }
  .bpg-tool__security svg { flex-shrink: 0; margin-top: 2px; }
  .bpg-tool__note { margin-top: 0; }
  @media (max-width: 768px) { .bpg-tool__controls { flex-direction: column; align-items: stretch; } .bpg-tool__actions { justify-content: center; } .bpg-tool .tool-action-button { width: 100%; min-width: 0; } .bpg-tool__select { min-width: 0; } }
</style>
