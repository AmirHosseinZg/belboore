---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'IPv4 Address Converter',
    inputLabel: 'IPv4 Address',
    inputPlaceholder: 'e.g. 192.168.1.1',
    convert: 'Convert',
    clear: 'Clear',
    copy: 'Copy',
    emptyState: 'Enter an IPv4 address and click Convert',
    note: 'All processing happens in your browser. No data is sent anywhere.',
    decimal: 'Decimal',
    hex: 'Hexadecimal',
    binary: 'Binary',
    octets: 'Octets',
    ipClass: 'IP Class',
    reversePtr: 'Reverse DNS (PTR)',
    arpa: 'in-addr.arpa',
  },
  fa: {
    title: 'مبدل آدرس IPv4',
    inputLabel: 'آدرس IPv4',
    inputPlaceholder: 'مثال 192.168.1.1',
    convert: 'تبدیل',
    clear: 'پاک کردن',
    copy: 'کپی',
    emptyState: 'یک آدرس IPv4 وارد کنید و روی Convert کلیک کنید',
    note: 'تمام پردازش در مرورگر شما انجام می‌شود. هیچ داده‌ای ارسال نمی‌شود.',
    decimal: 'دهدهی',
    hex: 'هگزادسیمال',
    binary: 'دودویی',
    octets: 'Octet ها',
    ipClass: 'کلاس IP',
    reversePtr: 'DNS معکوس (PTR)',
    arpa: 'in-addr.arpa',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="ipv4c-tool">
    <Input id="ipv4c-input" label={copy[lang].inputLabel} placeholder={copy[lang].inputPlaceholder} spellcheck={false} inputClassName="ipv4c-input" />
    <div class="tool-toolbar">
      <ToolActionButton id="ipv4c-convert">{copy[lang].convert}</ToolActionButton>
      <Button id="ipv4c-clear" variant="secondary">{copy[lang].clear}</Button>
    </div>
    <div id="ipv4c-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>
    <div id="ipv4c-result-card" style="display:none">
      <div class="ipv4c-grid">
        <div class="ipv4c-item">
          <span class="ipv4c-item-label">{copy[lang].decimal}</span>
          <span id="ipv4c-decimal" class="ipv4c-item-value"></span>
          <button class="ipv4c-copy-btn" data-copy="ipv4c-decimal" title="Copy">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
        <div class="ipv4c-item">
          <span class="ipv4c-item-label">{copy[lang].hex}</span>
          <span id="ipv4c-hex" class="ipv4c-item-value"></span>
          <button class="ipv4c-copy-btn" data-copy="ipv4c-hex" title="Copy">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
        <div class="ipv4c-item">
          <span class="ipv4c-item-label">{copy[lang].binary}</span>
          <span id="ipv4c-binary" class="ipv4c-item-value"></span>
          <button class="ipv4c-copy-btn" data-copy="ipv4c-binary" title="Copy">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
        <div class="ipv4c-item">
          <span class="ipv4c-item-label">{copy[lang].ipClass}</span>
          <span id="ipv4c-class" class="ipv4c-item-value"></span>
        </div>
        <div class="ipv4c-item ipv4c-item--wide">
          <span class="ipv4c-item-label">{copy[lang].reversePtr}</span>
          <span id="ipv4c-ptr" class="ipv4c-item-value"></span>
          <button class="ipv4c-copy-btn" data-copy="ipv4c-ptr" title="Copy">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
        </div>
      </div>
    </div>
    <div id="ipv4c-error" class="tool-error" style="display:none"></div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { parseIpv4Address, integerToIpv4, formatIpv4Binary, formatIpv4Hex, classifyIpv4Address } from './networkUtils.ts';

  const input = document.getElementById('ipv4c-input') as HTMLInputElement;
  const convertBtn = document.getElementById('ipv4c-convert') as HTMLButtonElement;
  const clearBtn = document.getElementById('ipv4c-clear') as HTMLButtonElement;
  const emptyEl = document.getElementById('ipv4c-empty')!;
  const resultCard = document.getElementById('ipv4c-result-card')!;
  const errorEl = document.getElementById('ipv4c-error')!;
  const decimalEl = document.getElementById('ipv4c-decimal')!;
  const hexEl = document.getElementById('ipv4c-hex')!;
  const binaryEl = document.getElementById('ipv4c-binary')!;
  const classEl = document.getElementById('ipv4c-class')!;
  const ptrEl = document.getElementById('ipv4c-ptr')!;

  function doConvert() {
    const val = input.value.trim();
    if (!val) {
      errorEl.textContent = 'Please enter an IPv4 address';
      errorEl.style.display = '';
      emptyEl.style.display = 'none';
      resultCard.style.display = 'none';
      return;
    }
    const ip = parseIpv4Address(val);
    if (ip === null) {
      errorEl.textContent = 'Invalid IPv4 address. Expected format: x.x.x.x where each octet is 0-255';
      errorEl.style.display = '';
      emptyEl.style.display = 'none';
      resultCard.style.display = 'none';
      return;
    }
    errorEl.style.display = 'none';
    emptyEl.style.display = 'none';
    resultCard.style.display = '';
    decimalEl.textContent = String(ip);
    hexEl.textContent = formatIpv4Hex(val);
    binaryEl.textContent = formatIpv4Binary(val);
    classEl.textContent = classifyIpv4Address(ip);
    ptrEl.textContent = val.split('.').reverse().join('.') + '.in-addr.arpa';
  }

  convertBtn.addEventListener('click', doConvert);
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') doConvert(); });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    emptyEl.style.display = '';
    resultCard.style.display = 'none';
    errorEl.style.display = 'none';
    input.focus();
  });

  document.querySelectorAll('.ipv4c-copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).getAttribute('data-copy');
      if (!targetId) return;
      const el = document.getElementById(targetId);
      if (!el) return;
      const text = el.textContent || '';
      window.__belbooreTools.copyToClipboard(text, btn as HTMLElement, 1500);
    });
  });
</script>

<style>
  .ipv4c-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .ipv4c-tool .tool-note { margin-top: 0; }
  .ipv4c-input { font-family: var(--font-mono); }
  .ipv4c-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .ipv4c-item {
    display: flex; flex-direction: column; gap: var(--space-1);
    background: var(--surface-secondary); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); padding: var(--space-3) var(--space-4); position: relative;
  }
  .ipv4c-item--wide { grid-column: 1 / -1; }
  .ipv4c-item-label { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; }
  .ipv4c-item-value { font-family: var(--font-mono); font-size: var(--text-sm); word-break: break-all; color: var(--text-primary); line-height: 1.4; }
  .ipv4c-copy-btn {
    position: absolute; top: var(--space-2); right: var(--space-2);
    background: none; border: none; cursor: pointer; color: var(--text-tertiary); padding: var(--space-1); border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
  }
  .ipv4c-copy-btn:hover { color: var(--color-tech-blue); background: var(--color-tech-blue-subtle); }
  [dir="rtl"] .ipv4c-copy-btn { right: auto; left: var(--space-2); }
  @media (max-width: 640px) { .ipv4c-grid { grid-template-columns: 1fr; } }
</style>
