---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Base Converter',
    inputLabel: 'Number',
    inputPlaceholder: 'Enter a number...',
    fromLabel: 'From base',
    toLabel: 'To base',
    convert: 'Convert',
    swap: 'Swap',
    clear: 'Clear',
    copy: 'Copy',
    emptyState: 'Enter a number and click Convert',
    note: 'Supports bases from 2 to 36. Uses BigInt for large numbers.',
    presetLabel: 'Presets',
  },
  fa: {
    title: 'مبدل مبنا',
    inputLabel: 'عدد',
    inputPlaceholder: 'یک عدد وارد کنید...',
    fromLabel: 'از مبنا',
    toLabel: 'به مبنا',
    convert: 'تبدیل',
    swap: 'جابجایی',
    clear: 'پاک کردن',
    copy: 'کپی',
    emptyState: 'یک عدد وارد کنید و روی Convert کلیک کنید',
    note: 'پشتیبانی از مبناهای ۲ تا ۳۶. از BigInt برای اعداد بزرگ استفاده می‌کند.',
    presetLabel: 'پیش‌تنظیمات',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="bc-tool">
    <Input id="bc-input" label={copy[lang].inputLabel} placeholder={copy[lang].inputPlaceholder} spellcheck={false} />
    <div class="bc-base-row">
      <Select id="bc-from" label={copy[lang].fromLabel} options={[
        { value: '2', label: 'Binary (2)' },
        { value: '8', label: 'Octal (8)' },
        { value: '10', label: 'Decimal (10)' },
        { value: '16', label: 'Hex (16)' },
      ]} selectedValue="10" selectClassName="bc-base-select" />
      <Button id="bc-swap" variant="outline" className="bc-swap-btn" title={copy[lang].swap}>&harr;</Button>
      <Select id="bc-to" label={copy[lang].toLabel} options={[
        { value: '2', label: 'Binary (2)' },
        { value: '8', label: 'Octal (8)' },
        { value: '10', label: 'Decimal (10)' },
        { value: '16', label: 'Hex (16)' },
      ]} selectedValue="16" selectClassName="bc-base-select" />
    </div>
    <div class="tool-toolbar">
      <ToolActionButton id="bc-convert">{copy[lang].convert}</ToolActionButton>
      <Button id="bc-clear" variant="secondary">{copy[lang].clear}</Button>
      <Button id="bc-copy" variant="outline">{copy[lang].copy}</Button>
    </div>
    <div id="bc-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>
    <div id="bc-result" class="tool-output" style="display:none" role="status" aria-live="polite"></div>
    <div id="bc-detail" class="bc-detail" style="display:none"></div>
    <div id="bc-error" class="tool-error" style="display:none"></div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { convertBase, validateBaseInput } from './Phase9Utils.ts';

  const input = document.getElementById('bc-input') as HTMLInputElement;
  const fromSelect = document.getElementById('bc-from') as HTMLSelectElement;
  const toSelect = document.getElementById('bc-to') as HTMLSelectElement;
  const swapBtn = document.getElementById('bc-swap') as HTMLButtonElement;
  const convertBtn = document.getElementById('bc-convert') as HTMLButtonElement;
  const clearBtn = document.getElementById('bc-clear') as HTMLButtonElement;
  const copyBtn = document.getElementById('bc-copy') as HTMLButtonElement;
  const emptyEl = document.getElementById('bc-empty')!;
  const resultEl = document.getElementById('bc-result')!;
  const detailEl = document.getElementById('bc-detail')!;
  const errorEl = document.getElementById('bc-error')!;

  function doConvert() {
    const val = input.value.trim();
    const from = parseInt(fromSelect.value, 10);
    const to = parseInt(toSelect.value, 10);
    if (!val) {
      errorEl.textContent = 'Please enter a number';
      errorEl.style.display = '';
      emptyEl.style.display = 'none';
      resultEl.style.display = 'none';
      detailEl.style.display = 'none';
      return;
    }
    if (!validateBaseInput(val, from)) {
      errorEl.textContent = `Invalid input for base ${from}. Valid digits: 0-9, a-z`;
      errorEl.style.display = '';
      emptyEl.style.display = 'none';
      resultEl.style.display = 'none';
      detailEl.style.display = 'none';
      return;
    }
    errorEl.style.display = 'none';
    try {
      const result = convertBase(val, from, to);
      emptyEl.style.display = 'none';
      resultEl.style.display = '';
      resultEl.textContent = `${result}`;
      detailEl.style.display = '';
      detailEl.textContent = `Base ${from} \u2192 Base ${to}  |  Input: ${val}  =  Output: ${result}`;
    } catch (e: any) {
      errorEl.textContent = 'Error: ' + (e.message || String(e));
      errorEl.style.display = '';
      resultEl.style.display = 'none';
      detailEl.style.display = 'none';
    }
  }

  convertBtn.addEventListener('click', doConvert);

  swapBtn.addEventListener('click', () => {
    const tmp = fromSelect.value;
    fromSelect.value = toSelect.value;
    toSelect.value = tmp;
    if (input.value.trim()) doConvert();
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    emptyEl.style.display = '';
    resultEl.style.display = 'none';
    detailEl.style.display = 'none';
    errorEl.style.display = 'none';
    input.focus();
  });

  copyBtn.addEventListener('click', () => {
    const text = resultEl.textContent || '';
    if (!text || resultEl.style.display === 'none') return;
    window.__belbooreTools.copyToClipboard(text, copyBtn, 1500);
  });

  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') doConvert(); });
</script>

<style>
  .bc-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .bc-tool .tool-note { margin-top: 0; }
  .bc-base-row { display: flex; align-items: flex-end; gap: var(--space-3); }
  .bc-base-row .bc-base-select { width: 110px; }
  .bc-swap-btn { flex-shrink: 0; margin-bottom: var(--space-1); }
  .bc-detail { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--text-tertiary); }
</style>
