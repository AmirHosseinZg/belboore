---
import { CalendarDays, ChevronLeft, ChevronRight } from '@lucide/astro';

interface Props {
  id: string;
  label: string;
  lang?: 'en' | 'fa';
  calendar?: 'gregorian' | 'jalali';
  value?: string;
  min?: string;
  max?: string;
  disabled?: boolean;
  helperText?: string;
  className?: string;
}

const {
  id,
  label,
  lang = 'en',
  calendar = 'gregorian',
  value = '',
  min = '',
  max = '',
  disabled = false,
  helperText = '',
  className = '',
} = Astro.props;

const dir = lang === 'fa' ? 'rtl' : 'ltr';
const helperId = helperText ? `${id}-helper` : undefined;
const placeholder = lang === 'fa' ? 'یک تاریخ انتخاب کنید' : 'Select a date';
---

<div
  class:list={['tool-calendar-field', className]}
  id={`${id}-cfw`}
  data-lang={lang}
  data-calendar={calendar}
  data-value={value}
  data-min={min}
  data-max={max}
  dir={dir}
  role="group"
  aria-label={label}
>
  <div class="tool-calendar-field__field">
    <div class="tool-calendar-field__shell">
      <label class="tool-calendar-field__label" for={id}>{label}</label>
      <input
        id={id}
        class="tool-calendar-field__input"
        type="text"
        readonly
        autocomplete="off"
        placeholder={placeholder}
        aria-describedby={helperId}
        aria-invalid="false"
        disabled={disabled}
      />
      <button
        type="button"
        class="tool-calendar-field__toggle"
        aria-label={lang === 'fa' ? 'باز کردن تقویم' : 'Open calendar'}
        aria-expanded="false"
        aria-controls={`${id}-popup`}
      >
        <CalendarDays size={18} />
      </button>
    </div>
    {helperText && <p id={helperId} class="tool-field__hint">{helperText}</p>}
  </div>

  <div class="tool-calendar-field__popup" id={`${id}-popup`} style="display: none;" role="dialog" aria-label={lang === 'fa' ? 'انتخاب تاریخ' : 'Date picker'}>
    <div class="tool-calendar-field__header">
      <button type="button" class="tool-calendar-field__nav" id={`${id}-prev`} aria-label={lang === 'fa' ? 'ماه قبل' : 'Previous month'}>
        {dir === 'rtl' ? <ChevronRight size={16} /> : <ChevronLeft size={16} />}
      </button>
      <button
        type="button"
        class="tool-calendar-field__title-btn"
        id={`${id}-my`}
        aria-label={lang === 'fa' ? 'انتخاب ماه و سال' : 'Choose month and year'}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls={`${id}-month-year-panel`}
      ></button>
      <button type="button" class="tool-calendar-field__nav" id={`${id}-next`} aria-label={lang === 'fa' ? 'ماه بعد' : 'Next month'}>
        {dir === 'rtl' ? <ChevronLeft size={16} /> : <ChevronRight size={16} />}
      </button>
    </div>
    <div class="tool-calendar-field__month-year-panel" id={`${id}-month-year-panel`} hidden>
      <div class="tool-calendar-field__year-bar">
        <button type="button" class="tool-calendar-field__year-nav" id={`${id}-year-prev`} aria-label={lang === 'fa' ? 'سال قبل' : 'Previous year'}>
          {dir === 'rtl' ? <ChevronRight size={14} /> : <ChevronLeft size={14} />}
        </button>
        <span class="tool-calendar-field__year-value" id={`${id}-year-value`} aria-live="polite"></span>
        <button type="button" class="tool-calendar-field__year-nav" id={`${id}-year-next`} aria-label={lang === 'fa' ? 'سال بعد' : 'Next year'}>
          {dir === 'rtl' ? <ChevronLeft size={14} /> : <ChevronRight size={14} />}
        </button>
      </div>
      <div class="tool-calendar-field__months" id={`${id}-months`} role="listbox" aria-label={lang === 'fa' ? 'انتخاب ماه' : 'Select month'}></div>
    </div>
    <div class="tool-calendar-field__weekdays" id={`${id}-wd`}></div>
    <div class="tool-calendar-field__grid" id={`${id}-grid`}></div>
  </div>
</div>

<style>
  .tool-calendar-field { position: relative; }
  .tool-calendar-field__field { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .tool-calendar-field__shell { position: relative; }
  .tool-calendar-field__label {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: 0;
    transform: translateY(-50%);
    z-index: 1;
    padding-inline: var(--space-2);
    background: var(--surface-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--color-tech-blue);
    pointer-events: none;
  }
  .tool-calendar-field__input {
    width: 100%;
    min-height: 46px;
    padding: var(--space-3) var(--space-4);
    padding-inline-end: calc(var(--space-10) + var(--space-2));
    border: 1.5px solid color-mix(in srgb, var(--color-tech-blue) 75%, white 25%);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-primary) 98%, transparent), color-mix(in srgb, var(--surface-secondary) 74%, transparent));
    color: var(--text-primary);
    font: inherit;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    outline: none;
    cursor: pointer;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--surface-elevated) 64%, transparent),
      var(--shadow-sm);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .tool-calendar-field__input::placeholder {
    color: var(--text-muted);
  }
  .tool-calendar-field__input:hover {
    border-color: var(--color-tech-blue);
    transform: translateY(-1px);
  }
  .tool-calendar-field__input:focus {
    border-color: var(--color-tech-blue);
    box-shadow:
      0 0 0 4px var(--color-tech-blue-subtle),
      inset 0 1px 0 color-mix(in srgb, var(--surface-elevated) 64%, transparent),
      var(--shadow-sm);
  }
  .tool-calendar-field__input:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    background: var(--surface-secondary);
  }
  .tool-calendar-field__toggle {
    position: absolute; inset-inline-end: var(--space-2); top: 50%; transform: translateY(-50%);
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; padding: 0; border: none;
    border-radius: var(--radius-md); background: var(--surface-primary);
    color: var(--color-tech-blue); cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-sm);
  }
  .tool-calendar-field__toggle:hover {
    background: var(--color-tech-blue-subtle);
    transform: translateY(-50%) scale(1.03);
    box-shadow: 0 10px 20px rgba(0, 82, 255, 0.14);
  }
  .tool-calendar-field__toggle:focus-visible {
    outline: 2px solid var(--color-tech-blue);
    outline-offset: 2px;
  }
  .tool-calendar-field__popup {
    position: absolute; z-index: 50; top: calc(100% + var(--space-2)); inset-inline-start: 0;
    min-width: 304px; width: min(332px, calc(100vw - 2rem)); max-width: calc(100vw - 2rem); background: var(--surface-primary);
    border: 1px solid color-mix(in srgb, var(--border-default) 88%, white 12%); border-radius: calc(var(--radius-xl) + 2px);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12), 0 6px 16px rgba(15, 23, 42, 0.08); padding: var(--space-4);
    background:
      radial-gradient(circle at top right, rgba(0,82,255,0.08), transparent 36%),
      linear-gradient(180deg, color-mix(in srgb, var(--surface-primary) 98%, white), color-mix(in srgb, var(--surface-secondary) 92%, white 8%));
  }
  .tool-calendar-field__header {
    display: grid; grid-template-columns: 36px minmax(0,1fr) 36px; align-items: center;
    gap: var(--space-2); margin-bottom: var(--space-3);
  }
  .tool-calendar-field__nav {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; padding: 0; border: 1px solid transparent;
    border-radius: var(--radius-md); background: color-mix(in srgb, var(--surface-primary) 78%, var(--surface-secondary));
    color: var(--text-secondary); cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }
  .tool-calendar-field__nav:hover { color: var(--color-tech-blue); background: var(--color-tech-blue-subtle); border-color: color-mix(in srgb, var(--color-tech-blue) 24%, transparent); transform: translateY(-1px); }
  .tool-calendar-field__nav:focus-visible { outline: 2px solid var(--color-tech-blue); outline-offset: 2px; }
  .tool-calendar-field__title-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 40px;
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-primary) 72%, var(--surface-secondary));
    color: var(--text-primary);
    font: inherit;
    font-size: calc(var(--text-base) + 1px);
    font-weight: var(--weight-bold);
    cursor: pointer;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--surface-elevated) 72%, transparent);
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .tool-calendar-field__title-btn:hover { background: var(--color-tech-blue-subtle); color: var(--color-tech-blue-hover); transform: translateY(-1px); }
  .tool-calendar-field__title-btn:focus-visible { outline: 2px solid var(--color-tech-blue); outline-offset: 2px; }
  .tool-calendar-field__month-year-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    padding: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--border-default) 70%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface-primary) 80%, var(--surface-secondary));
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 32%, transparent);
  }
  .tool-calendar-field__month-year-panel[hidden] { display: none; }
  .tool-calendar-field__year-bar {
    display: grid;
    grid-template-columns: 28px minmax(0,1fr) 28px;
    gap: var(--space-2);
    align-items: center;
  }
  .tool-calendar-field__year-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }
  .tool-calendar-field__year-nav:hover { color: var(--color-tech-blue); background: var(--color-tech-blue-subtle); }
  .tool-calendar-field__year-nav:focus-visible { outline: 2px solid var(--color-tech-blue); outline-offset: 2px; }
  .tool-calendar-field__year-value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface-primary) 70%, var(--surface-secondary));
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-align: center;
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 24%, transparent);
  }
  .tool-calendar-field__months {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .tool-calendar-field__month-btn {
    min-height: 34px;
    padding: var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }
  .tool-calendar-field__month-btn:hover { color: var(--text-primary); background: var(--surface-tertiary); transform: translateY(-1px); }
  .tool-calendar-field__month-btn:focus-visible { outline: 2px solid var(--color-tech-blue); outline-offset: 2px; }
  .tool-calendar-field__month-btn.is-active {
    color: var(--color-tech-blue);
    background: var(--color-tech-blue-subtle);
    border-color: color-mix(in srgb, var(--color-tech-blue) 20%, transparent);
  }
  .tool-calendar-field__weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: var(--space-2); margin-bottom: var(--space-2); }
  .tool-calendar-field__weekday { text-align: center; font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-muted); padding: var(--space-1) 0; letter-spacing: 0.01em; }
  .tool-calendar-field__grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--space-2); }
  .tool-calendar-field__day {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    width: 100%; min-height: 38px; aspect-ratio: 1; border: 1px solid transparent; border-radius: calc(var(--radius-md) + 2px);
    background: transparent; font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--text-primary);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }
  .tool-calendar-field__day:hover { background: color-mix(in srgb, var(--color-tech-blue-subtle) 72%, var(--surface-primary)); border-color: color-mix(in srgb, var(--color-tech-blue) 18%, transparent); transform: translateY(-1px); }
  .tool-calendar-field__day:focus-visible { outline: 2px solid var(--color-tech-blue); outline-offset: 2px; }
  .tool-calendar-field__day--other { color: var(--text-muted); opacity: 0.5; }
  .tool-calendar-field__day--today:not(.tool-calendar-field__day--selected) {
    border-color: color-mix(in srgb, var(--color-tech-blue) 40%, transparent);
    font-weight: var(--weight-bold);
    color: var(--color-tech-blue);
    background: color-mix(in srgb, var(--color-tech-blue-subtle) 35%, transparent);
    box-shadow: inset 0 0 0 1px var(--color-tech-blue-subtle);
  }
  .tool-calendar-field__day--today:not(.tool-calendar-field__day--selected)::after {
    content: '';
    position: absolute;
    inset-block-end: 5px;
    inset-inline-start: 50%;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: currentColor;
    transform: translateX(-50%);
  }
  .tool-calendar-field__day--selected { background: linear-gradient(135deg, var(--color-tech-blue), var(--color-electric-cyan)); color: white; font-weight: var(--weight-semibold); box-shadow: 0 10px 20px rgba(0, 82, 255, 0.18); }
  .tool-calendar-field__day--selected:hover { background: var(--color-tech-blue-hover); color: white; }
  .tool-calendar-field__day--holiday { color: var(--color-error, #ef4444); }
  .tool-calendar-field__day--past:not(.tool-calendar-field__day--selected):not(.tool-calendar-field__day--today) { color: color-mix(in srgb, var(--text-tertiary) 80%, var(--text-muted)); font-weight: var(--weight-regular); opacity: 0.7; }
  .tool-calendar-field__day--disabled { opacity: 0.35; cursor: not-allowed; background: color-mix(in srgb, var(--surface-secondary) 80%, transparent); }
  .tool-calendar-field__day--disabled:hover { background: color-mix(in srgb, var(--surface-secondary) 80%, transparent); border-color: transparent; transform: none; }
  [dir="rtl"] .tool-calendar-field__popup { inset-inline-start: auto; inset-inline-end: 0; }
  [data-theme='dark'] .tool-calendar-field__label { background: var(--surface-primary); }
  [data-theme='dark'] .tool-calendar-field__input {
    background: var(--surface-elevated);
    border-color: color-mix(in srgb, var(--color-tech-blue) 78%, rgba(255, 255, 255, 0.14));
  }
  [data-theme='dark'] .tool-calendar-field__month-year-panel { background: linear-gradient(180deg, var(--surface-elevated), var(--surface-tertiary)); }
  [data-theme='dark'] .tool-calendar-field__title-btn,
  [data-theme='dark'] .tool-calendar-field__nav { background: color-mix(in srgb, var(--surface-elevated) 92%, var(--surface-tertiary)); }
  [data-theme='dark'] .tool-calendar-field__year-value { background: color-mix(in srgb, var(--surface-elevated) 92%, var(--surface-tertiary)); }
  [data-theme='dark'] .tool-calendar-field__toggle {
    background: var(--surface-elevated);
  }
  .tool-calendar-field__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 640px) {
    .tool-calendar-field__popup { min-width: 0; width: min(100vw - 2rem, 320px); padding: var(--space-3); }
    .tool-calendar-field__months { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tool-calendar-field__grid,
    .tool-calendar-field__weekdays { gap: var(--space-1); }
    .tool-calendar-field__day { min-height: 35px; }
  }
</style>

<script is:inline>
(function(){
  const script = document.currentScript;
  const wrapper = script && script.previousElementSibling && script.previousElementSibling.classList.contains('tool-calendar-field')
    ? script.previousElementSibling
    : null;
  if(!wrapper) return;
  const input = wrapper.querySelector('.tool-calendar-field__input');
  if(!input || !input.id) return;
  const id = input.id;
  const popup = document.getElementById(id+'-popup');
  const toggle = wrapper.querySelector('.tool-calendar-field__toggle');
  const grid = document.getElementById(id+'-grid');
  const wdEl = document.getElementById(id+'-wd');
  const myEl = document.getElementById(id+'-my');
  const prevBtn = document.getElementById(id+'-prev');
  const nextBtn = document.getElementById(id+'-next');
  const monthYearPanel = document.getElementById(id+'-month-year-panel');
  const monthsEl = document.getElementById(id+'-months');
  const yearValue = document.getElementById(id+'-year-value');
  const yearPrevBtn = document.getElementById(id+'-year-prev');
  const yearNextBtn = document.getElementById(id+'-year-next');
  if(!input||!popup||!toggle||!grid||!wdEl||!myEl||!prevBtn||!nextBtn||!monthYearPanel||!monthsEl||!yearValue||!yearPrevBtn||!yearNextBtn) return;

  var WK_FA = ['ش','ی','د','س','چ','پ','ج'];
  var WK_EN = ['Su','Mo','Tu','We','Th','Fr','Sa'];
  var GM_EN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  var GM_FA = ['ژانویه','فوریه','مارس','آوریل','مه','ژوئن','ژوئیه','اوت','سپتامبر','اکتبر','نوامبر','دسامبر'];
  var JM_EN = ['Farvardin','Ordibehesht','Khordad','Tir','Mordad','Shahrivar','Mehr','Aban','Azar','Dey','Bahman','Esfand'];
  var JM_FA = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];

  function toJalali(gy,gm,gd){
    var gdm=[0,31,59,90,120,151,181,212,243,273,304,334];
    var gy2=gm>2?gy+1:gy;
    var days=355666+365*gy+Math.floor((gy2+3)/4)-Math.floor((gy2+99)/100)+Math.floor((gy2+399)/400)+gd+gdm[gm-1];
    var jy=-1595+33*Math.floor(days/12053);
    var d=days%12053;
    jy+=4*Math.floor(d/1461);
    d%=1461;
    if(d>365){jy+=Math.floor((d-1)/365);d=(d-1)%365;}
    var jm=d<186?1+Math.floor(d/31):7+Math.floor((d-186)/30);
    var jd=1+(d<186?d%31:(d-186)%30);
    return[jy,jm,jd];
  }
  function toGregorian(jy,jm,jd){
    var jy1=jy+1595;
    var days=-355668+365*jy1+Math.floor(jy1/33)*8+Math.floor(((jy1%33)+3)/4)+jd+(jm<7?(jm-1)*31:(jm-7)*30+186);
    var gy=400*Math.floor(days/146097);
    days%=146097;
    if(days>36524){gy+=100*Math.floor(--days/36524);days%=36524;if(days>=365)days++;}
    gy+=4*Math.floor(days/1461);
    days%=1461;
    if(days>365){gy+=Math.floor((days-1)/365);days=(days-1)%365;}
    var mo=[0,0,31,59,90,120,151,181,212,243,273,304,334];
    var gmm=days<31?1:days<59?2:days<90?3:days<120?4:days<151?5:days<181?6:days<212?7:days<243?8:days<273?9:days<304?10:days<334?11:12;
    var gdd=1+days-mo[gmm];
    return[gy<0?gy+1:gy,gmm,gdd];
  }
  function daysInMonth(y,m,cal){
    if(cal==='gregorian') return new Date(y,m,0).getDate();
    if(m<=6) return 31;
    if(m<=11) return 30;
    var base=y%33;
    return(base===0||base===1||base===5||base===9||base===13||base===17||base===22||base===26||base===30)?30:29;
  }
  function getFirstWeekday(y,m,cal){
    if(cal==='gregorian') return new Date(y,m-1,1).getDay();
    var g=toGregorian(y,m,1);
    return new Date(g[0],g[1]-1,g[2]).getDay();
  }

  var lang = wrapper.getAttribute('data-lang')||'en';
  var calendar = wrapper.getAttribute('data-calendar')||'gregorian';
  var internalDate = null;
  var viewYear = 2026, viewMonth = 6, isOpen = false;
  var isMonthYearOpen = false;
  var holidayCache = {};
  var minDate = parseMinMax(wrapper.getAttribute('data-min'));
  var maxDate = parseMinMax(wrapper.getAttribute('data-max'));

  function formatNumber(value){
    return lang==='fa' ? new Intl.NumberFormat('fa-IR').format(value) : String(value);
  }

  function parseMinMax(str){
    if(!str) return null;
    var p=str.split('-');
    if(p.length!==3) return null;
    return new Date(+p[0],+p[1]-1,+p[2]);
  }

  function isoStr(d){
    if(!d) return '';
    var y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),dd=String(d.getDate()).padStart(2,'0');
    return y+'-'+m+'-'+dd;
  }

  function formatDisplay(d){
    if(!d) return '';
    var gy=d.getFullYear(),gm=d.getMonth()+1,gd=d.getDate();
    if(calendar==='jalali'){
      var j=toJalali(gy,gm,gd);
      var ms=lang==='fa'?JM_FA:JM_EN;
      return formatNumber(j[2])+' '+ms[j[1]-1]+' '+formatNumber(j[0]);
    }
    var ms=lang==='fa'?GM_FA:GM_EN;
    return formatNumber(gd)+' '+ms[gm-1]+' '+formatNumber(gy);
  }

  function emitChange(){
    if(!internalDate){input.value='';wrapper.dispatchEvent(new CustomEvent('tool-calendar-change',{detail:{id:id,iso:'',gregorian:null,jalali:null,calendarMode:calendar}}));return;}
    var gy=internalDate.getFullYear(),gm=internalDate.getMonth()+1,gd=internalDate.getDate();
    var j=toJalali(gy,gm,gd);
    var detail={id:id,iso:isoStr(internalDate),gregorian:{year:gy,month:gm,day:gd},jalali:{year:j[0],month:j[1],day:j[2]},calendarMode:calendar};
    input.value=formatDisplay(internalDate);
    input.dispatchEvent(new Event('change',{bubbles:true}));
    wrapper.dispatchEvent(new CustomEvent('tool-calendar-change',{detail:detail,bubbles:true}));
  }

  function isDisabled(d){
    if(!d) return false;
    if(minDate&&d<minDate) return true;
    if(maxDate&&d>maxDate) return true;
    return false;
  }

  async function loadHolidays(jy){
    if(holidayCache[jy]) return holidayCache[jy];
    try{
      var resp=await fetch('/calendar-data/year_'+jy+'.json');
      if(!resp.ok) return null;
      var data=await resp.json();
      holidayCache[jy]=data;
      return data;
    }catch(e){return null;}
  }

  function isHoliday(jy,jm,jd){
    var data=holidayCache[jy];
    if(!data||!data.data) return false;
    var key=jy+'/'+String(jm).padStart(2,'0')+'/'+String(jd).padStart(2,'0');
    var found=data.data.find(function(e){return e.date===key||e.shamsiDate===key;});
    return found&&found.isHoliday;
  }

  function syncHeaderControls(monthNames){
    yearValue.textContent = formatNumber(viewYear);
    monthsEl.innerHTML = monthNames.map(function(name, idx){
      var monthValue = idx + 1;
      var activeClass = monthValue === viewMonth ? ' is-active' : '';
      return '<button type="button" class="tool-calendar-field__month-btn'+activeClass+'" data-month="'+monthValue+'" aria-pressed="'+(monthValue===viewMonth?'true':'false')+'">'+name+'</button>';
    }).join('');
    var monthButtons = monthsEl.querySelectorAll('.tool-calendar-field__month-btn');
    for(var i=0;i<monthButtons.length;i++){
      monthButtons[i].addEventListener('click', function(event){
        event.stopPropagation();
        viewMonth = parseInt(this.getAttribute('data-month'), 10) || viewMonth;
        setMonthYearOpen(false);
        renderCalendar();
      });
    }
  }

  function setMonthYearOpen(open){
    isMonthYearOpen = open;
    monthYearPanel.hidden = !open;
    myEl.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  function renderCalendar(){
    var days=daysInMonth(viewYear,viewMonth,calendar);
    var firstDay=getFirstWeekday(viewYear,viewMonth,calendar);
    var monthNames=calendar==='gregorian'?(lang==='fa'?GM_FA:GM_EN):(lang==='fa'?JM_FA:JM_EN);
    syncHeaderControls(monthNames);
    myEl.textContent=monthNames[viewMonth-1]+' '+formatNumber(viewYear);
    var wd=lang==='fa'?WK_FA:WK_EN;
    wdEl.innerHTML=wd.map(function(w){return'<span class="tool-calendar-field__weekday">'+w+'</span>';}).join('');
    var today=new Date();
    today.setHours(0,0,0,0);
    var tj=toJalali(today.getFullYear(),today.getMonth()+1,today.getDate());

    if(calendar==='jalali') loadHolidays(viewYear);

    var cells='';
    for(var i=0;i<firstDay;i++) cells+='<span class="tool-calendar-field__day tool-calendar-field__day--other"></span>';
    for(var d=1;d<=days;d++){
      var cls='tool-calendar-field__day';
      var cellDate;
      var label = '';
      if(calendar==='gregorian'){
        cellDate=new Date(viewYear,viewMonth-1,d);
        if(+cellDate===+today) cls+=' tool-calendar-field__day--today';
        if(viewYear===today.getFullYear()&&viewMonth===today.getMonth()+1&&d<today.getDate()) cls+=' tool-calendar-field__day--past';
        if(internalDate&&viewYear===internalDate.getFullYear()&&viewMonth===internalDate.getMonth()+1&&d===internalDate.getDate()) cls+=' tool-calendar-field__day--selected';
        if(isDisabled(cellDate)) cls+=' tool-calendar-field__day--disabled';
        label = formatNumber(d)+' '+monthNames[viewMonth-1]+' '+formatNumber(viewYear);
      }else{
        if(viewYear===tj[0]&&viewMonth===tj[1]&&d===tj[2]) cls+=' tool-calendar-field__day--today';
        if(viewYear===tj[0]&&viewMonth===tj[1]&&d<tj[2]) cls+=' tool-calendar-field__day--past';
        if(internalDate){
          var sd=toJalali(internalDate.getFullYear(),internalDate.getMonth()+1,internalDate.getDate());
          if(viewYear===sd[0]&&viewMonth===sd[1]&&d===sd[2]) cls+=' tool-calendar-field__day--selected';
        }
        if(isHoliday(viewYear,viewMonth,d)) cls+=' tool-calendar-field__day--holiday';
        var g=toGregorian(viewYear,viewMonth,d);
        cellDate=new Date(g[0],g[1]-1,g[2]);
        if(isDisabled(cellDate)) cls+=' tool-calendar-field__day--disabled';
        label = formatNumber(d)+' '+monthNames[viewMonth-1]+' '+formatNumber(viewYear);
      }
      var isSelected = cls.indexOf('tool-calendar-field__day--selected') !== -1;
      var isToday = cls.indexOf('tool-calendar-field__day--today') !== -1;
      if(isToday) label += lang === 'fa' ? ' - امروز' : ' - Today';
      if(isSelected) label += lang === 'fa' ? ' - انتخاب شده' : ' - Selected';
      cells+='<button type="button" class="'+cls+'" data-day="'+d+'" aria-label="'+label+'" aria-selected="'+(isSelected?'true':'false')+'" aria-current="'+(isToday?'date':'false')+'">'+formatNumber(d)+'</button>';
    }
    grid.innerHTML=cells;
    var btns=grid.querySelectorAll('.tool-calendar-field__day[data-day]:not(.tool-calendar-field__day--disabled)');
    for(var b=0;b<btns.length;b++){
      btns[b].addEventListener('click',function(){
        var day=parseInt(this.getAttribute('data-day'),10);
        if(calendar==='gregorian') internalDate=new Date(viewYear,viewMonth-1,day);
        else{var g=toGregorian(viewYear,viewMonth,day);internalDate=new Date(g[0],g[1]-1,g[2]);}
        emitChange();
        closePopup();
      });
    }
  }

  function openPopup(){
    isOpen=true;popup.style.display='';
    toggle.setAttribute('aria-expanded','true');
    setMonthYearOpen(false);
    if(internalDate){
      if(calendar==='gregorian'){viewYear=internalDate.getFullYear();viewMonth=internalDate.getMonth()+1;}
      else{var j=toJalali(internalDate.getFullYear(),internalDate.getMonth()+1,internalDate.getDate());viewYear=j[0];viewMonth=j[1];}
    }else{
      var now=new Date();
      if(calendar==='gregorian'){viewYear=now.getFullYear();viewMonth=now.getMonth()+1;}
      else{var j=toJalali(now.getFullYear(),now.getMonth()+1,now.getDate());viewYear=j[0];viewMonth=j[1];}
    }
    renderCalendar();
  }
  function closePopup(){isOpen=false;popup.style.display='none';toggle.setAttribute('aria-expanded','false');setMonthYearOpen(false);}
  function navigate(delta){viewMonth+=delta;if(viewMonth<1){viewMonth=12;viewYear--;}if(viewMonth>12){viewMonth=1;viewYear++;}renderCalendar();}

  popup.addEventListener('click', function(e){ e.stopPropagation(); });
  toggle.addEventListener('click',function(e){e.stopPropagation();if(isOpen)closePopup();else openPopup();});
  input.addEventListener('click',function(e){e.stopPropagation();if(isOpen)closePopup();else openPopup();});
  myEl.addEventListener('click', function(e){e.stopPropagation();setMonthYearOpen(!isMonthYearOpen);});
  input.addEventListener('keydown',function(e){
    if(e.key==='Enter'||e.key===' '){
      e.preventDefault();
      if(isOpen) closePopup();
      else openPopup();
    }
  });
  prevBtn.addEventListener('click',function(e){e.stopPropagation();navigate(-1);});
  nextBtn.addEventListener('click',function(e){e.stopPropagation();navigate(1);});
  yearPrevBtn.addEventListener('click', function(e){e.stopPropagation();viewYear--;renderCalendar();});
  yearNextBtn.addEventListener('click', function(e){e.stopPropagation();viewYear++;renderCalendar();});
  document.addEventListener('click',function(e){if(isOpen&&!wrapper.contains(e.target))closePopup();});
  window.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&isOpen){
      if(isMonthYearOpen){
        setMonthYearOpen(false);
        return;
      }
      closePopup();
    }
  });

  function setCalendarMode(mode){
    calendar=mode;
    wrapper.setAttribute('data-calendar',mode);
    if(isOpen){
      if(internalDate){
        if(mode==='gregorian'){viewYear=internalDate.getFullYear();viewMonth=internalDate.getMonth()+1;}
        else{var j=toJalali(internalDate.getFullYear(),internalDate.getMonth()+1,internalDate.getDate());viewYear=j[0];viewMonth=j[1];}
      }else{
        var now=new Date();
        if(mode==='gregorian'){viewYear=now.getFullYear();viewMonth=now.getMonth()+1;}
        else{var j=toJalali(now.getFullYear(),now.getMonth()+1,now.getDate());viewYear=j[0];viewMonth=j[1];}
      }
      renderCalendar();
    }
    emitChange();
  }

  function setDate(iso){
    if(iso){var p=iso.split('-');if(p.length===3){internalDate=new Date(+p[0],+p[1]-1,+p[2]);emitChange();}}
    else{internalDate=null;emitChange();}
  }

  function getNormalized(){
    if(!internalDate) return{id:id,iso:'',gregorian:null,jalali:null,calendarMode:calendar};
    var gy=internalDate.getFullYear(),gm=internalDate.getMonth()+1,gd=internalDate.getDate();
    var j=toJalali(gy,gm,gd);
    return{id:id,iso:isoStr(internalDate),gregorian:{year:gy,month:gm,day:gd},jalali:{year:j[0],month:j[1],day:j[2]},calendarMode:calendar};
  }

  window.__belbooreCalendars = window.__belbooreCalendars||{};
  window.__belbooreCalendars[id] = {setCalendarMode:setCalendarMode, setDate:setDate, getNormalized:getNormalized, getDate:function(){return internalDate;}};

  var initVal = wrapper.getAttribute('data-value');
  if(initVal) setDate(initVal);
})();
</script>
