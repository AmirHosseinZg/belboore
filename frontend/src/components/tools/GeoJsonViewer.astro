---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import Button from '../ui/Button.astro';
import TextArea from '../ui/TextArea.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'GeoJSON Viewer / نمایش GeoJSON',
    inputLabel: 'GeoJSON Input',
    outputLabel: 'Feature Summary',
    inputHint: 'Paste a valid GeoJSON object.',
    outputEmpty: 'Feature summary will appear here',
    loadExample: 'Load example',
    clear: 'Clear',
    view: 'View on Map',
    copy: 'Copy JSON',
    copied: 'Copied!',
    note: 'All processing happens in your browser. Your data is never uploaded.',
    error: 'Invalid GeoJSON',
    count: 'Feature count',
    types: 'Geometry types',
    noFeatures: 'No features found',
    exampleGeoJson: JSON.stringify({
      type: 'FeatureCollection',
      features: [
        { type: 'Feature', properties: { name: 'Point 1' }, geometry: { type: 'Point', coordinates: [51.389, 35.6892] } },
        { type: 'Feature', properties: { name: 'Line' }, geometry: { type: 'LineString', coordinates: [[51.38, 35.68], [51.4, 35.7], [51.42, 35.69]] } },
        { type: 'Feature', properties: { name: 'Polygon' }, geometry: { type: 'Polygon', coordinates: [[[51.35, 35.65], [51.45, 35.65], [51.45, 35.72], [51.35, 35.72], [51.35, 35.65]]] } },
      ],
    }, null, 2),
  },
  fa: {
    title: 'نمایش GeoJSON',
    inputLabel: 'ورودی GeoJSON',
    outputLabel: 'خلاصه ویژگی‌ها',
    inputHint: 'یک شیء GeoJSON معتبر را وارد کنید.',
    outputEmpty: 'خلاصه ویژگی‌ها اینجا نمایش داده می‌شود',
    loadExample: 'نمونه',
    clear: 'پاک کردن',
    view: 'نمایش روی نقشه',
    copy: 'کپی JSON',
    copied: 'کپی شد!',
    note: 'تمام پردازش‌ها در مرورگر شما انجام می‌شود. داده‌های شما آپلود نمی‌شود.',
    error: 'GeoJSON نامعتبر',
    count: 'تعداد ویژگی‌ها',
    types: 'انواع هندسه',
    noFeatures: 'ویژگی‌ای یافت نشد',
    exampleGeoJson: JSON.stringify({
      type: 'FeatureCollection',
      features: [
        { type: 'Feature', properties: { name: 'Point 1' }, geometry: { type: 'Point', coordinates: [51.389, 35.6892] } },
        { type: 'Feature', properties: { name: 'Line' }, geometry: { type: 'LineString', coordinates: [[51.38, 35.68], [51.4, 35.7], [51.42, 35.69]] } },
        { type: 'Feature', properties: { name: 'Polygon' }, geometry: { type: 'Polygon', coordinates: [[[51.35, 35.65], [51.45, 35.65], [51.45, 35.72], [51.35, 35.72], [51.35, 35.65]]] } },
      ],
    }, null, 2),
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section class="gj-tool" dir={dir} data-empty={copy.outputEmpty} data-copied={copy.copied} data-error={copy.error}>
    <div class="gj-tool__grid">
      <div class="gj-tool__panel">
        <div class="gj-tool__panel-head">
          <label class="gj-tool__label" for="gj-input">{copy.inputLabel}</label>
          <p class="gj-tool__hint">{copy.inputHint}</p>
        </div>
        <TextArea id="gj-input" className="gj-tool__textarea" placeholder={copy.exampleGeoJson} rows={12} spellcheck="false" />
        <div class="gj-tool__actions">
          <Button id="gj-example" variant="secondary">{copy.loadExample}</Button>
          <Button id="gj-clear" variant="danger">{copy.clear}</Button>
        </div>
      </div>

      <div class="gj-tool__panel">
        <div class="gj-tool__panel-head">
          <span class="gj-tool__label">{copy.outputLabel}</span>
        </div>
        <div id="gj-summary" class="gj-tool__summary tool-output tool-output--empty" role="status" aria-live="polite">{copy.outputEmpty}</div>
        <div id="gj-map" class="gj-tool__map"></div>
      </div>
    </div>

    <div class="gj-tool__toolbar">
      <ToolActionButton id="gj-run">{copy.view}</ToolActionButton>
    </div>

    <div id="gj-error" class="tool-error" style="display: none;" role="alert"></div>

    <div class="tool-note gj-tool__note">{copy.note}</div>
  </section>
</ToolWorkspace>

<script>
  const input = document.getElementById('gj-input') as HTMLTextAreaElement | null;
  const summary = document.getElementById('gj-summary')!;
  const mapContainer = document.getElementById('gj-map') as HTMLDivElement | null;
  const errorDiv = document.getElementById('gj-error') as HTMLDivElement | null;
  const runBtn = document.getElementById('gj-run') as HTMLButtonElement | null;
  const exampleBtn = document.getElementById('gj-example') as HTMLButtonElement | null;
  const clearBtn = document.getElementById('gj-clear') as HTMLButtonElement | null;

  const root = document.querySelector('.gj-tool') as HTMLElement | null;
  const isFa = root?.getAttribute('dir') === 'rtl';

  let mapInstance: any = null;

  function getData(key: string, fallback: string): string {
    return root?.dataset[key] || fallback;
  }

  async function initMap() {
    if (mapInstance) return;
    if (!mapContainer) return;

    const L = await import('leaflet');
    await import('leaflet/dist/leaflet.css');

    mapInstance = L.map(mapContainer, {
      center: [35.6892, 51.389],
      zoom: 5,
      zoomControl: true,
      attributionControl: true,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(mapInstance);
  }

  function destroyMap() {
    if (mapInstance) {
      mapInstance.remove();
      mapInstance = null;
    }
  }

  async function viewGeoJSON() {
    if (!input || !summary || !mapContainer) return;
    const val = input.value.trim();
    if (!val) {
      summary.textContent = getData('empty', '');
      summary.classList.add('tool-output--empty');
      destroyMap();
      if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
      return;
    }

    let geojson: any;
    try {
      geojson = JSON.parse(val);
    } catch (e: any) {
      if (errorDiv) { errorDiv.textContent = `${getData('error', 'Invalid GeoJSON')}: ${e?.message || 'Parse error'}`; errorDiv.style.display = ''; }
      summary.textContent = getData('empty', '');
      summary.classList.add('tool-output--empty');
      destroyMap();
      return;
    }

    if (!geojson.type || !geojson.features) {
      if (errorDiv) { errorDiv.textContent = `${getData('error', 'Invalid GeoJSON')}: Must be a FeatureCollection`; errorDiv.style.display = ''; }
      summary.textContent = getData('empty', '');
      summary.classList.add('tool-output--empty');
      destroyMap();
      return;
    }

    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }

    const features = geojson.features || [];
    const typeCounts: Record<string, number> = {};
    features.forEach((f: any) => {
      const gt = f?.geometry?.type || 'Unknown';
      typeCounts[gt] = (typeCounts[gt] || 0) + 1;
    });

    const countLabel = isFa ? 'تعداد ویژگی‌ها' : 'Feature count';
    const typesLabel = isFa ? 'انواع هندسه' : 'Geometry types';
    const typeStr = Object.entries(typeCounts).map(([t, c]) => `${t}: ${c}`).join(', ');
    summary.textContent = `${countLabel}: ${features.length}  |  ${typesLabel}: ${typeStr || (isFa ? 'هیچ' : 'None')}`;
    summary.classList.remove('tool-output--empty');

    destroyMap();
    await initMap();
    if (!mapInstance) return;

    const L = await import('leaflet');

    try {
      const geoLayer = L.geoJSON(geojson, {
        style: { color: '#0052ff', weight: 2, opacity: 0.8, fillOpacity: 0.15 },
        pointToLayer: (_feature: any, latlng: any) => {
          return L.circleMarker(latlng, { radius: 8, color: '#0052ff', fillColor: '#0052ff', fillOpacity: 0.3, weight: 2 });
        },
      }).addTo(mapInstance);
      mapInstance.fitBounds(geoLayer.getBounds(), { padding: [30, 30] });
    } catch (e: any) {
      if (errorDiv) { errorDiv.textContent = `${getData('error', 'Invalid GeoJSON')}: ${e?.message || 'Render error'}`; errorDiv.style.display = ''; }
    }
  }

  runBtn?.addEventListener('click', viewGeoJSON);

  input?.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') { event.preventDefault(); viewGeoJSON(); }
  });

  exampleBtn?.addEventListener('click', () => {
    if (input) input.value = copy.exampleGeoJson;
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    viewGeoJSON();
  });

  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    if (summary) { summary.textContent = getData('empty', ''); summary.classList.add('tool-output--empty'); }
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    destroyMap();
    input?.focus();
  });
</script>

<style>
  .gj-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .gj-tool__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); align-items: start; }
  .gj-tool__panel { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding: var(--space-3) var(--space-4); border: 1px solid transparent; border-radius: calc(var(--radius-lg) - 4px); background: var(--surface-tertiary); transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out); }
  .gj-tool__panel:focus-within { border-color: var(--color-tech-blue); box-shadow: 0 0 0 3px var(--color-tech-blue-subtle); }
  .gj-tool__panel-head { display: flex; flex-direction: column; gap: var(--space-1); }
  .gj-tool__label { color: var(--text-secondary); font-size: var(--text-xs); font-weight: var(--weight-semibold); text-transform: uppercase; letter-spacing: 0.06em; }
  .gj-tool__hint { margin: 0; color: var(--text-muted); font-size: var(--text-xs); line-height: var(--leading-snug); }
  .gj-tool__textarea { width: 100%; min-height: 240px; }
  .gj-tool__textarea :global(.ui-textarea) { min-height: 200px; font-family: var(--font-mono); font-size: var(--text-sm); }
  .gj-tool__actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .gj-tool__summary { min-height: 60px; padding: var(--space-4); font-family: var(--font-mono); font-size: var(--text-sm); line-height: 1.6; border-radius: var(--radius-md); background: color-mix(in srgb, var(--surface-primary) 60%, var(--surface-secondary)); white-space: pre-wrap; word-break: break-word; }
  .gj-tool__map { width: 100%; height: 400px; border-radius: var(--radius-lg); border: 1px solid var(--border-subtle); overflow: hidden; background: #f0f0f0; z-index: 1; }
  .gj-tool__map :global(.leaflet-container) { height: 100%; width: 100%; }
  .gj-tool__toolbar { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .gj-tool .tool-action-button { min-width: 148px; }
  .gj-tool__note { margin-top: 0; }
  @media (max-width: 768px) { .gj-tool__grid { grid-template-columns: 1fr; } .gj-tool .tool-action-button { width: 100%; min-width: 0; } .gj-tool__map { height: 300px; } }
</style>
