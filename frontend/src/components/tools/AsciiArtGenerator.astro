---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'ASCII Art Generator',
    inputLabel: 'Text',
    inputPlaceholder: 'Enter text to convert to ASCII art...',
    fontLabel: 'Font Style',
    generate: 'Generate',
    clear: 'Clear',
    copy: 'Copy',
    emptyState: 'Enter text and click Generate to create ASCII art',
    note: 'ASCII art is rendered using monospace characters. Best results with uppercase letters and numbers.',
    standard: 'Standard',
    small: 'Small',
  },
  fa: {
    title: 'تولید هنر ASCII',
    inputLabel: 'متن',
    inputPlaceholder: 'متن را برای تبدیل به هنر ASCII وارد کنید...',
    fontLabel: 'سبک فونت',
    generate: 'تولید',
    clear: 'پاک کردن',
    copy: 'کپی',
    emptyState: 'متن را وارد کنید و روی Generate کلیک کنید',
    note: 'هنر ASCII با کاراکترهای monospace نمایش داده می‌شود. بهترین نتیجه با حروف بزرگ و اعداد.',
    standard: 'Standard',
    small: 'Small',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="aa-tool">
    <Input id="aa-input" label={copy[lang].inputLabel} placeholder={copy[lang].inputPlaceholder} spellcheck={false} />
    <Select id="aa-font" label={copy[lang].fontLabel} options={[
      { value: 'standard', label: copy[lang].standard },
      { value: 'small', label: copy[lang].small },
    ]} />
    <div class="tool-toolbar">
      <ToolActionButton id="aa-generate">{copy[lang].generate}</ToolActionButton>
      <Button id="aa-clear" variant="secondary">{copy[lang].clear}</Button>
      <Button id="aa-copy" variant="outline">{copy[lang].copy}</Button>
    </div>
  <div id="aa-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>
  <div id="aa-result-card" class="aa-result-card" style="display:none">
    <div class="aa-result-header">
      <span class="aa-result-label">ASCII Art</span>
      <span id="aa-font-label" class="aa-font-label"></span>
    </div>
    <pre id="aa-result" class="aa-result-value" role="status" aria-live="polite"></pre>
  </div>
  <div id="aa-error" class="tool-error" style="display:none"></div>
  <div class="tool-note">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    {copy[lang].note}
  </div>
</div>
</ToolWorkspace>

<script>
  import { generateFiglet } from './Phase9Utils.ts';

  const input = document.getElementById('aa-input') as HTMLInputElement;
  const fontSelect = document.getElementById('aa-font') as HTMLSelectElement;
  const genBtn = document.getElementById('aa-generate') as HTMLButtonElement;
  const clearBtn = document.getElementById('aa-clear') as HTMLButtonElement;
  const copyBtn = document.getElementById('aa-copy') as HTMLButtonElement;
  const emptyEl = document.getElementById('aa-empty')!;
  const resultCard = document.getElementById('aa-result-card')!;
  const resultEl = document.getElementById('aa-result')!;
  const fontLabel = document.getElementById('aa-font-label')!;
  const errorEl = document.getElementById('aa-error')!;

  genBtn.addEventListener('click', () => {
    const text = input.value.trim();
    if (!text) {
      errorEl.textContent = 'Please enter some text';
      errorEl.style.display = '';
      emptyEl.style.display = 'none';
      resultCard.style.display = 'none';
      return;
    }
    errorEl.style.display = 'none';
    try {
      const font = fontSelect.value as 'standard' | 'small';
      const art = generateFiglet(text, font);
      if (!art) {
        errorEl.textContent = 'Could not generate ASCII art for this input';
        errorEl.style.display = '';
        resultCard.style.display = 'none';
        return;
      }
      emptyEl.style.display = 'none';
      resultCard.style.display = '';
      resultEl.textContent = art;
      fontLabel.textContent = font.charAt(0).toUpperCase() + font.slice(1) + ' font';
    } catch (e: any) {
      errorEl.textContent = 'Error: ' + (e.message || String(e));
      errorEl.style.display = '';
      resultCard.style.display = 'none';
    }
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    emptyEl.style.display = '';
    resultCard.style.display = 'none';
    errorEl.style.display = 'none';
    input.focus();
  });

  copyBtn.addEventListener('click', () => {
    const text = resultEl.textContent || '';
    if (!text || resultCard.style.display === 'none') return;
    window.__belbooreTools.copyToClipboard(text, copyBtn, 1500);
  });

  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') genBtn.click(); });
</script>

<style>
  .aa-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .aa-tool .tool-note { margin-top: 0; }
  .aa-result-card {
    background: var(--surface-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .aa-result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-primary);
  }
  .aa-result-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .aa-font-label {
    font-size: var(--text-xs);
    color: var(--color-tech-blue);
    font-weight: var(--weight-medium);
  }
  .aa-result-value {
    margin: 0;
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.1;
    white-space: pre;
    overflow-x: auto;
  }
</style>
