---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import PasswordInput from '../ui/PasswordInput.astro';
import Button from '../ui/Button.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Password Strength Analyser',
    passwordLabel: 'Password to analyse',
    passwordPlaceholder: 'Type or paste a password...',
    resultEmpty: 'Enter a password to analyse its strength',
    score: 'Score',
    strength: 'Strength',
    crackTime: 'Estimated crack time',
    feedback: 'Suggestions',
    clear: 'Clear',
    note: 'Your password stays in your browser. Nothing is sent anywhere.',
    instant: 'Instant',
    seconds: 'Seconds',
    hours: 'Hours',
    years: 'Years',
    centuries: 'Centuries',
    length: 'Length',
    variety: 'Character variety',
    chars: 'characters',
    veryWeak: 'Very Weak',
    weak: 'Weak',
    fair: 'Fair',
    strong: 'Strong',
    veryStrong: 'Very Strong',
  },
  fa: {
    title: 'تحلیل قدرت رمز عبور',
    passwordLabel: 'رمز عبور برای تحلیل',
    passwordPlaceholder: 'رمز عبور را تایپ یا جای‌گذاری کنید...',
    resultEmpty: 'برای تحلیل قدرت، رمز عبور را وارد کنید',
    score: 'امتیاز',
    strength: 'قدرت',
    crackTime: 'زمان تخمینی شکستن',
    feedback: 'پیشنهادات',
    clear: 'پاک کردن',
    note: 'رمز عبور شما در مرورگر باقی می‌ماند. هیچ چیز به جایی ارسال نمی‌شود.',
    instant: 'فوری',
    seconds: 'ثانیه',
    hours: 'ساعت',
    years: 'سال',
    centuries: 'قرن',
    length: 'طول',
    variety: 'تنوع کاراکتر',
    chars: 'کاراکتر',
    veryWeak: 'خیلی ضعیف',
    weak: 'ضعیف',
    fair: 'متوسط',
    strong: 'قوی',
    veryStrong: 'خیلی قوی',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="psa-tool">
    <PasswordInput id="psa-input" label={copy[lang].passwordLabel} placeholder={copy[lang].passwordPlaceholder} spellcheck={false} />

    <div class="tool-toolbar">
      <Button id="psa-clear" variant="ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        {copy[lang].clear}
      </Button>
    </div>

    <div id="psa-empty" class="tool-output tool-output--empty">{copy[lang].resultEmpty}</div>

    <div id="psa-result" class="psa-result" style="display:none">
      <div class="psa-meter-section">
        <div class="psa-score-bar">
          <div id="psa-fill" class="psa-score-fill" style="width:0%"></div>
        </div>
        <div class="psa-score-info">
          <span id="psa-score-text">{copy[lang].score}: 0/100</span>
          <span id="psa-label-text" class="psa-label">{copy[lang].weak}</span>
        </div>
      </div>

      <div class="psa-details">
        <div class="psa-detail-row">
          <span class="psa-detail-label">{copy[lang].length}</span>
          <span id="psa-length" class="psa-detail-value">0 {copy[lang].chars}</span>
        </div>
        <div class="psa-detail-row">
          <span class="psa-detail-label">{copy[lang].variety}</span>
          <span id="psa-variety" class="psa-detail-value">-</span>
        </div>
        <div class="psa-detail-row">
          <span class="psa-detail-label">{copy[lang].crackTime}</span>
          <span id="psa-crack" class="psa-detail-value">-</span>
        </div>
      </div>

      <div id="psa-feedback" class="psa-feedback"></div>
    </div>

    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { scorePassword } from './Phase8Utils.ts';

  const input = document.getElementById('psa-input') as HTMLInputElement;
  const clearBtn = document.getElementById('psa-clear') as HTMLButtonElement;
  const emptyEl = document.getElementById('psa-empty')!;
  const resultEl = document.getElementById('psa-result')!;
  const fillEl = document.getElementById('psa-fill')!;
  const scoreText = document.getElementById('psa-score-text')!;
  const labelText = document.getElementById('psa-label-text')!;
  const lengthEl = document.getElementById('psa-length')!;
  const varietyEl = document.getElementById('psa-variety')!;
  const crackEl = document.getElementById('psa-crack')!;
  const feedbackEl = document.getElementById('psa-feedback')!;

  let debounceTimer: ReturnType<typeof setTimeout>;

  function analyse() {
    const val = input.value;
    if (!val) {
      emptyEl.style.display = '';
      resultEl.style.display = 'none';
      return;
    }
    emptyEl.style.display = 'none';
    resultEl.style.display = '';

    const result = scorePassword(val);

    fillEl.style.width = result.score + '%';
    fillEl.style.background = result.color;

    scoreText.textContent = 'Score: ' + result.score + '/100';
    labelText.textContent = result.label;
    labelText.style.color = result.color;

    lengthEl.textContent = val.length + ' characters';
    const upper = /[A-Z]/.test(val);
    const lower = /[a-z]/.test(val);
    const digit = /[0-9]/.test(val);
    const symbol = /[^A-Za-z0-9]/.test(val);
    const parts: string[] = [];
    if (upper) parts.push('A-Z');
    if (lower) parts.push('a-z');
    if (digit) parts.push('0-9');
    if (symbol) parts.push('!@#$');
    varietyEl.textContent = parts.length + ' types (' + parts.join(', ') + ')' || 'None';

    crackEl.textContent = result.timeToCrack;

    feedbackEl.innerHTML = '';
    result.feedback.forEach(function (msg) {
      const item = document.createElement('div');
      item.className = 'psa-feedback-item';
      item.textContent = '• ' + msg;
      feedbackEl.appendChild(item);
    });
  }

  input.addEventListener('input', function () {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(analyse, 250);
    analyse();
  });

  clearBtn.addEventListener('click', function () {
    input.value = '';
    emptyEl.style.display = '';
    resultEl.style.display = 'none';
    input.focus();
  });

  input.addEventListener('focus', analyse);
</script>

<style>
  .psa-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .psa-tool .tool-note {
    margin-top: 0;
  }
  .psa-meter-section {
    margin-bottom: var(--space-5);
  }
  .psa-score-bar {
    height: 10px;
    background: var(--surface-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-2);
  }
  .psa-score-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.3s ease, background 0.3s ease;
  }
  .psa-score-info {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .psa-label {
    font-weight: var(--weight-bold);
  }

  .psa-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .psa-detail-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    background: var(--surface-tertiary);
    border-radius: var(--radius-md);
  }
  .psa-detail-label {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-weight: var(--weight-medium);
  }
  .psa-detail-value {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .psa-feedback {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .psa-feedback-item {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding: var(--space-1) 0;
  }

  @media (max-width: 480px) {
    .psa-details {
      grid-template-columns: 1fr;
    }
  }
</style>
