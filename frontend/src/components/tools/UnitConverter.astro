---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Input from '../ui/Input.astro';
import Select from '../ui/Select.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';
import { UNIT_DATA, convertUnit, formatUnitNum } from './Phase10Utils.ts';

const CATEGORIES = Object.keys(UNIT_DATA).map(k => ({ value: k, label: k.charAt(0).toUpperCase() + k.slice(1) }));

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Unit Converter',
    categoryLabel: 'Category',
    fromLabel: 'From',
    toLabel: 'To',
    convert: 'Convert',
    swap: 'Swap',
    clear: 'Clear',
    copy: 'Copy',
    result: 'Result',
    selectUnit: 'Select unit',
    emptyState: 'Enter a value and select units',
    note: 'Convert between units of length, weight, temperature, area, volume, speed, time, data, pressure, energy, power, and angle.',
  },
  fa: {
    title: 'مبدل واحد',
    categoryLabel: 'دسته',
    fromLabel: 'از',
    toLabel: 'به',
    convert: 'تبدیل',
    swap: 'جابجایی',
    clear: 'پاک کردن',
    copy: 'کپی',
    result: 'نتیجه',
    selectUnit: 'واحد را انتخاب کنید',
    emptyState: 'مقدار را وارد کنید و واحدها را انتخاب کنید',
    note: 'تبدیل بین واحدهای طول، وزن، دما، مساحت، حجم، سرعت، زمان، داده، فشار، انرژی، قدرت و زاویه.',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="uc-tool">
    <Select id="uc-category" label={copy[lang].categoryLabel} options={CATEGORIES} />

    <div class="uc-convert-row">
      <div class="uc-side">
        <Select id="uc-from-unit" label={copy[lang].fromLabel} options={[{ value: '', label: copy[lang].selectUnit }]} selectClassName="uc-unit-select" />
        <Input id="uc-from-val" label={copy[lang].fromLabel} type="number" placeholder="1" inputClassName="uc-val-input" />
      </div>
      <Button id="uc-swap" variant="outline" className="uc-swap-btn" title={copy[lang].swap}>&harr;</Button>
      <div class="uc-side">
        <Select id="uc-to-unit" label={copy[lang].toLabel} options={[{ value: '', label: copy[lang].selectUnit }]} selectClassName="uc-unit-select" />
        <div class="uc-to-val-shell">
          <label class="uc-to-label">{copy[lang].toLabel}</label>
          <div id="uc-to-result" class="uc-to-val" role="status" aria-live="polite">&mdash;</div>
        </div>
      </div>
    </div>

    <div class="tool-toolbar">
      <ToolActionButton id="uc-convert">{copy[lang].convert}</ToolActionButton>
      <Button id="uc-clear" variant="secondary">{copy[lang].clear}</Button>
    </div>

    <div id="uc-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyState}</div>

    <div id="uc-result-card" class="uc-result-card" style="display:none">
      <div class="uc-result-header">
        <span class="uc-result-label">{copy[lang].result}</span>
        <span id="uc-result-badge" class="uc-result-badge"></span>
      </div>
      <div id="uc-result-body" class="uc-result-body">
        <div class="uc-result-row">
          <span id="uc-result-from" class="uc-result-from"></span>
          <span class="uc-result-arrow">&rarr;</span>
          <span id="uc-result-to" class="uc-result-to"></span>
        </div>
      </div>
      <div class="uc-result-actions">
        <Button id="uc-copy" variant="outline">{copy[lang].copy}</Button>
      </div>
    </div>

    <div id="uc-error" class="tool-error" style="display:none"></div>

    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { UNIT_DATA, convertUnit, formatUnitNum } from './Phase10Utils.ts';

  const catSelect = document.getElementById('uc-category') as HTMLSelectElement;
  const fromUnit = document.getElementById('uc-from-unit') as HTMLSelectElement;
  const toUnit = document.getElementById('uc-to-unit') as HTMLSelectElement;
  const fromVal = document.getElementById('uc-from-val') as HTMLInputElement;
  const toResult = document.getElementById('uc-to-result')!;
  const swapBtn = document.getElementById('uc-swap') as HTMLButtonElement;
  const convertBtn = document.getElementById('uc-convert') as HTMLButtonElement;
  const clearBtn = document.getElementById('uc-clear') as HTMLButtonElement;
  const emptyEl = document.getElementById('uc-empty')!;
  const resultCard = document.getElementById('uc-result-card')!;
  const resultBadge = document.getElementById('uc-result-badge')!;
  const resultFrom = document.getElementById('uc-result-from')!;
  const resultTo = document.getElementById('uc-result-to')!;
  const copyBtn = document.getElementById('uc-copy') as HTMLButtonElement;
  const errorEl = document.getElementById('uc-error')!;

  function populateUnits(cat: string) {
    const list = UNIT_DATA[cat];
    if (!list) return;
    const fromIdx = Math.min(fromUnit.selectedIndex, list.length - 1);
    const toIdx = Math.min(toUnit.selectedIndex > 0 ? toUnit.selectedIndex : 1, list.length - 1);
    let html = '';
    for (const u of list) {
      html += `<option value="${u.key}">${u.name}</option>`;
    }
    fromUnit.innerHTML = html;
    toUnit.innerHTML = html;
    if (fromIdx < list.length) fromUnit.selectedIndex = fromIdx;
    if (toIdx < list.length) toUnit.selectedIndex = toIdx;
    fromVal.placeholder = list[0]?.name || '';
  }

  catSelect.addEventListener('change', () => {
    populateUnits(catSelect.value);
    doConvert();
  });

  function doConvert() {
    const val = parseFloat(fromVal.value);
    const fromKey = fromUnit.value;
    const toKey = toUnit.value;
    const cat = catSelect.value;

    if (isNaN(val) || !fromKey || !toKey) {
      toResult.textContent = '\u2014';
      resultCard.style.display = 'none';
      emptyEl.style.display = '';
      return;
    }
    emptyEl.style.display = 'none';
    errorEl.style.display = 'none';

    try {
      const result = convertUnit(val, fromKey, toKey, cat);
      toResult.textContent = formatUnitNum(result);

      const fromName = fromUnit.options[fromUnit.selectedIndex]?.text || fromKey;
      const toName = toUnit.options[toUnit.selectedIndex]?.text || toKey;
      resultFrom.textContent = `${formatUnitNum(val)} ${fromName}`;
      resultTo.textContent = `${formatUnitNum(result)} ${toName}`;
      resultBadge.textContent = cat.charAt(0).toUpperCase() + cat.slice(1);
      resultCard.style.display = '';
    } catch (e: any) {
      errorEl.textContent = e.message || 'Conversion error';
      errorEl.style.display = '';
      resultCard.style.display = 'none';
    }
  }

  convertBtn.addEventListener('click', doConvert);
  fromVal.addEventListener('input', doConvert);
  fromUnit.addEventListener('change', doConvert);
  toUnit.addEventListener('change', doConvert);

  swapBtn.addEventListener('click', () => {
    const tmp = fromUnit.value;
    const tmpIdx = fromUnit.selectedIndex;
    fromUnit.value = toUnit.value;
    fromUnit.selectedIndex = toUnit.selectedIndex;
    toUnit.value = tmp;
    toUnit.selectedIndex = tmpIdx;
    if (fromVal.value.trim()) doConvert();
  });

  clearBtn.addEventListener('click', () => {
    fromVal.value = '';
    toResult.textContent = '\u2014';
    emptyEl.style.display = '';
    resultCard.style.display = 'none';
    errorEl.style.display = 'none';
    fromVal.focus();
  });

  copyBtn.addEventListener('click', () => {
    const text = `${resultFrom.textContent} = ${resultTo.textContent}`;
    if (!text || resultCard.style.display === 'none') return;
    window.__belbooreTools.copyToClipboard(text, copyBtn, 1500);
  });

  populateUnits(catSelect.value);
</script>

<style>
  .uc-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .uc-tool .tool-note { margin-top: 0; }
  .uc-convert-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-3); align-items: start; }
  .uc-side { display: flex; flex-direction: column; gap: var(--space-3); }
  .uc-swap-btn { margin-top: 28px; flex-shrink: 0; min-width: 40px; padding: var(--space-2) !important; }
  .uc-to-val-shell { position: relative; }
  .uc-to-label {
    position: absolute; inset-inline-start: var(--space-4); top: 0;
    transform: translateY(-50%); z-index: 1;
    padding-inline: var(--space-2); background: var(--surface-primary);
    font-size: var(--text-xs); font-weight: var(--weight-medium);
    line-height: 1; color: var(--color-tech-blue); pointer-events: none;
  }
  .uc-to-val {
    width: 100%; min-height: 46px; display: flex; align-items: center;
    padding: var(--space-3) var(--space-4);
    border: 1.5px solid color-mix(in srgb, var(--color-tech-blue) 75%, white 25%);
    border-radius: var(--radius-md); background: var(--surface-primary);
    color: var(--text-primary); font: inherit; font-size: var(--text-base);
    line-height: var(--leading-snug); word-break: break-all;
  }
  [data-theme='dark'] .uc-to-label { background: var(--surface-primary); }
  [data-theme='dark'] .uc-to-val { background: var(--surface-elevated); border-color: color-mix(in srgb, var(--color-tech-blue) 78%, rgba(255,255,255,0.14)); }

  .uc-result-card {
    background: var(--surface-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .uc-result-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-primary);
  }
  .uc-result-label {
    font-size: var(--text-xs); font-weight: var(--weight-semibold);
    color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em;
  }
  .uc-result-badge { font-size: var(--text-xs); font-weight: var(--weight-medium); color: var(--color-tech-blue); }
  .uc-result-body { padding: var(--space-4); }
  .uc-result-row { display: flex; align-items: center; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }
  .uc-result-from { font-size: var(--text-sm); color: var(--text-secondary); font-family: var(--font-mono); }
  .uc-result-arrow { color: var(--text-muted); font-size: var(--text-lg); }
  .uc-result-to { font-size: var(--text-lg); font-weight: var(--weight-bold); color: var(--color-tech-blue); font-family: var(--font-mono); }
  .uc-result-actions { display: flex; justify-content: center; padding: 0 var(--space-4) var(--space-3); }

  @media (max-width: 640px) {
    .uc-convert-row { grid-template-columns: 1fr; }
    .uc-swap-btn { margin-top: 0; justify-self: center; transform: rotate(90deg); }
  }
</style>
