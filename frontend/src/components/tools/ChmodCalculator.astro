---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Chmod Calculator',
    ownerLabel: 'Owner',
    groupLabel: 'Group',
    othersLabel: 'Others',
    read: 'r',
    write: 'w',
    execute: 'x',
    octalLabel: 'Octal',
    symbolicLabel: 'Symbolic',
    commandLabel: 'chmod command',
    commandHint: 'chmod <octal> file',
    emptyResult: 'Toggle permissions above to calculate',
    presetsLabel: 'Presets',
    note: 'Calculations are done in real-time in your browser.',
  },
  fa: {
    title: 'محاسبه Chmod',
    ownerLabel: 'مالک',
    groupLabel: 'گروه',
    othersLabel: 'دیگران',
    read: 'خ',
    write: 'ن',
    execute: 'اج',
    octalLabel: 'مقدار Octal',
    symbolicLabel: 'نمادین',
    commandLabel: 'دستور chmod',
    commandHint: 'chmod <octal> file',
    emptyResult: 'برای محاسبه مجوزها را تغییر دهید',
    presetsLabel: 'پیش‌تنظیمات',
    note: 'محاسبات به صورت لحظه‌ای در مرورگر شما انجام می‌شود.',
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section class="cc-tool" dir={dir} data-empty={copy.emptyResult}>
    <div class="cc-tool__presets">
      <span class="cc-tool__presets-label">{copy.presetsLabel}</span>
      <Button id="cc-preset-644" variant="secondary">644</Button>
      <Button id="cc-preset-755" variant="secondary">755</Button>
      <Button id="cc-preset-600" variant="secondary">600</Button>
      <Button id="cc-preset-700" variant="secondary">700</Button>
      <Button id="cc-preset-777" variant="secondary">777</Button>
    </div>

    <div class="cc-tool__grid">
      <div class="cc-tool__group">
        <h4 class="cc-tool__group-title">{copy.ownerLabel}</h4>
        <div class="cc-tool__checkboxes">
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-ur" checked /> {copy.read}</label>
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-uw" checked /> {copy.write}</label>
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-ux" checked /> {copy.execute}</label>
        </div>
      </div>
      <div class="cc-tool__group">
        <h4 class="cc-tool__group-title">{copy.groupLabel}</h4>
        <div class="cc-tool__checkboxes">
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-gr" checked /> {copy.read}</label>
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-gw" /> {copy.write}</label>
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-gx" checked /> {copy.execute}</label>
        </div>
      </div>
      <div class="cc-tool__group">
        <h4 class="cc-tool__group-title">{copy.othersLabel}</h4>
        <div class="cc-tool__checkboxes">
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-or" checked /> {copy.read}</label>
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-ow" /> {copy.write}</label>
          <label class="cc-tool__checkbox"><input type="checkbox" id="cc-ox" checked /> {copy.execute}</label>
        </div>
      </div>
    </div>

    <div class="cc-tool__octal-row">
      <Input id="cc-octal" label={copy.octalLabel} inputClassName="cc-tool__octal-input" placeholder="755" className="cc-tool__octal-field" />
    </div>

    <div class="cc-tool__results">
      <div class="cc-tool__result">
        <span class="cc-tool__result-label">{copy.symbolicLabel}</span>
        <span id="cc-symbolic" class="cc-tool__result-value">rwxr-xr-x</span>
      </div>
      <div class="cc-tool__result">
        <span class="cc-tool__result-label">{copy.commandLabel}</span>
        <span id="cc-command" class="cc-tool__result-value cc-tool__result-value--mono">chmod 755 file</span>
      </div>
    </div>

    <div id="cc-error" class="tool-error" style="display: none;" role="alert"></div>

    <div class="tool-note cc-tool__note">{copy.note}</div>
  </section>
</ToolWorkspace>

<script>
  const ur = document.getElementById('cc-ur') as HTMLInputElement | null;
  const uw = document.getElementById('cc-uw') as HTMLInputElement | null;
  const ux = document.getElementById('cc-ux') as HTMLInputElement | null;
  const gr = document.getElementById('cc-gr') as HTMLInputElement | null;
  const gw = document.getElementById('cc-gw') as HTMLInputElement | null;
  const gx = document.getElementById('cc-gx') as HTMLInputElement | null;
  const or = document.getElementById('cc-or') as HTMLInputElement | null;
  const ow = document.getElementById('cc-ow') as HTMLInputElement | null;
  const ox = document.getElementById('cc-ox') as HTMLInputElement | null;
  const octalInput = document.getElementById('cc-octal') as HTMLInputElement | null;
  const symbolicSpan = document.getElementById('cc-symbolic')!;
  const commandSpan = document.getElementById('cc-command')!;
  const errorDiv = document.getElementById('cc-error') as HTMLDivElement | null;

  const checkboxes = [ur, uw, ux, gr, gw, gx, or, ow, ox];
  const presetBtns = document.querySelectorAll<HTMLButtonElement>('[id^="cc-preset-"]');

  function getOctal(): number {
    const u = (ur?.checked ? 4 : 0) + (uw?.checked ? 2 : 0) + (ux?.checked ? 1 : 0);
    const g = (gr?.checked ? 4 : 0) + (gw?.checked ? 2 : 0) + (gx?.checked ? 1 : 0);
    const o = (or?.checked ? 4 : 0) + (ow?.checked ? 2 : 0) + (ox?.checked ? 1 : 0);
    return u * 100 + g * 10 + o;
  }

  function getSymbolic(): string {
    const r = (v: boolean) => v ? 'r' : '-';
    const w = (v: boolean) => v ? 'w' : '-';
    const x = (v: boolean) => v ? 'x' : '-';
    return r(ur?.checked ?? false) + w(uw?.checked ?? false) + x(ux?.checked ?? false) +
           r(gr?.checked ?? false) + w(gw?.checked ?? false) + x(gx?.checked ?? false) +
           r(or?.checked ?? false) + w(ow?.checked ?? false) + x(ox?.checked ?? false);
  }

  function updateResults() {
    try {
      const octal = getOctal();
      const sym = getSymbolic();
      symbolicSpan.textContent = sym;
      commandSpan.textContent = `chmod ${octal} file`;
      if (octalInput) octalInput.value = String(octal);
      if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    } catch (e: any) {
      if (errorDiv) { errorDiv.textContent = e?.message || 'Calculation error'; errorDiv.style.display = ''; }
    }
  }

  function setFromOctal(val: string) {
    const num = parseInt(val, 10);
    if (isNaN(num) || num < 0 || num > 777 || !/^[0-7]{3}$/.test(val)) {
      if (errorDiv) { errorDiv.textContent = 'Invalid octal value. Use digits 0-7 only (e.g. 755).'; errorDiv.style.display = ''; }
      return;
    }
    if (errorDiv) { errorDiv.style.display = 'none'; errorDiv.textContent = ''; }
    const o = Math.floor(num / 100);
    const g = Math.floor((num % 100) / 10);
    const u = num % 10;
    if (ur) ur.checked = !!(o & 4);
    if (uw) uw.checked = !!(o & 2);
    if (ux) ux.checked = !!(o & 1);
    if (gr) gr.checked = !!(g & 4);
    if (gw) gw.checked = !!(g & 2);
    if (gx) gx.checked = !!(g & 1);
    if (or) or.checked = !!(u & 4);
    if (ow) ow.checked = !!(u & 2);
    if (ox) ox.checked = !!(u & 1);
    updateResults();
  }

  checkboxes.forEach(cb => {
    if (cb) cb.addEventListener('change', updateResults);
  });

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.textContent?.trim() || '755';
      setFromOctal(val);
    });
  });

  octalInput?.addEventListener('input', () => {
    setFromOctal(octalInput.value);
  });

  updateResults();
</script>

<style>
  .cc-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .cc-tool__presets { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .cc-tool__presets-label { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; margin-right: var(--space-2); }
  .cc-tool__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); }
  .cc-tool__group { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4); background: var(--surface-tertiary); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .cc-tool__group-title { margin: 0; font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--text-secondary); }
  .cc-tool__checkboxes { display: flex; flex-direction: column; gap: var(--space-2); }
  .cc-tool__checkbox { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--text-secondary); cursor: pointer; }
  .cc-tool__checkbox input { accent-color: var(--color-tech-blue); width: 18px; height: 18px; }
  .cc-tool__octal-row { max-width: 200px; }
  .cc-tool__octal-field { max-width: 200px; }
  .cc-tool__octal-input { text-align: center; font-family: var(--font-mono); font-size: var(--text-lg); font-weight: var(--weight-bold); }
  .cc-tool__results { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4); background: var(--surface-tertiary); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .cc-tool__result { display: flex; align-items: center; gap: var(--space-3); }
  .cc-tool__result-label { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; min-width: 80px; }
  .cc-tool__result-value { font-size: var(--text-lg); font-weight: var(--weight-bold); color: var(--color-tech-blue); font-family: var(--font-mono); }
  .cc-tool__result-value--mono { font-size: var(--text-sm); color: var(--text-primary); }
  .cc-tool__note { margin-top: 0; }
  @media (max-width: 768px) { .cc-tool__grid { grid-template-columns: 1fr; } .cc-tool__presets { justify-content: center; } }
</style>
