---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import { Copy, Trash2, FileJson } from '@lucide/astro';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import ToolActionButton from './ToolActionButton.astro';
import Button from '../ui/Button.astro';
import TextArea from '../ui/TextArea.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'JSON Minify',
    inputLabel: 'Input JSON',
    inputHint: 'Paste your JSON to minify it.',
    placeholder: '{\n  "example": "data"\n}',
    outputLabel: 'Minified Output',
    outputHint: 'Whitespace-free JSON output.',
    minify: 'Minify',
    copy: 'Copy result',
    clear: 'Clear input',
    empty: 'Minified JSON will appear here',
    fixErrors: 'Fix the errors above and try again',
    invalidJson: 'Invalid JSON',
    validJson: 'Valid JSON',
    inputSize: 'Input size',
    outputSize: 'Output size',
    saved: 'Saved',
    bytes: 'bytes',
    chars: 'chars',
    note: 'All processing happens in your browser. Your data is never uploaded.',
    copied: 'Copied!',
    loadExample: 'Load example',
  },
  fa: {
    title: 'فشرده‌سازی JSON',
    inputLabel: 'ورودی JSON',
    inputHint: 'JSON خود را برای فشرده‌سازی وارد کنید.',
    placeholder: '{\n  "example": "data"\n}',
    outputLabel: 'خروجی فشرده',
    outputHint: 'خروجی JSON بدون فاصله.',
    minify: 'فشرده‌سازی',
    copy: 'کپی نتیجه',
    clear: 'پاک کردن ورودی',
    empty: 'JSON فشرده اینجا نمایش داده می‌شود',
    fixErrors: 'خطاهای بالا را برطرف کنید و دوباره تلاش کنید',
    invalidJson: 'JSON نامعتبر',
    validJson: 'JSON معتبر',
    inputSize: 'حجم ورودی',
    outputSize: 'حجم خروجی',
    saved: 'ذخیره',
    bytes: 'بایت',
    chars: 'کاراکتر',
    note: 'تمام پردازش‌ها در مرورگر شما انجام می‌شود. داده‌های شما آپلود نمی‌شود.',
    copied: 'کپی شد!',
    loadExample: 'نمونه',
  },
}[lang];
---

<ToolWorkspace title={copy.title}>
  <ToolPrimitives />
  <ToolUtils />

  <section
    class="json-minify-tool"
    dir={dir}
    data-empty={copy.empty}
    data-fix-errors={copy.fixErrors}
    data-invalid-json={copy.invalidJson}
    data-copied={copy.copied}
    data-input-size={copy.inputSize}
    data-output-size={copy.outputSize}
    data-saved={copy.saved}
    data-bytes={copy.bytes}
    data-chars={copy.chars}
  >
    <div class="json-minify-tool__grid">
      <div class="json-minify-tool__panel">
        <div class="json-minify-tool__panel-head">
          <label class="json-minify-tool__label" for="json-minify-input">{copy.inputLabel}</label>
          <p class="json-minify-tool__hint">{copy.inputHint}</p>
        </div>
        <div class="json-minify-tool__textarea-shell">
          <TextArea
            id="json-minify-input"
            className="json-minify-tool__textarea"
            placeholder={copy.placeholder}
            rows={12}
            spellcheck="false"
          />
        </div>
      </div>

      <div class="json-minify-tool__panel">
        <div class="json-minify-tool__panel-head">
          <label class="json-minify-tool__label" for="json-minify-output">{copy.outputLabel}</label>
          <p class="json-minify-tool__hint">{copy.outputHint}</p>
        </div>
        <div class="json-minify-tool__textarea-shell">
          <textarea
            id="json-minify-output"
            class="json-minify-tool__textarea json-minify-tool__textarea--output"
            rows={12}
            readonly
            spellcheck="false"
            placeholder={copy.empty}
          ></textarea>
        </div>
      </div>
    </div>

    <div class="json-minify-tool__toolbar">
      <ToolActionButton id="json-minify-run">
        {copy.minify}
      </ToolActionButton>
      <Button id="json-minify-copy" variant="outline" className="json-minify-tool__icon-btn" aria-label={copy.copy} title={copy.copy}>
        <Copy size={17} />
      </Button>
      <Button id="json-minify-clear" variant="danger" className="json-minify-tool__icon-btn" aria-label={copy.clear} title={copy.clear}>
        <Trash2 size={17} />
      </Button>
      <Button id="json-minify-example" variant="secondary" className="json-minify-tool__icon-btn" aria-label={copy.loadExample} title={copy.loadExample}>
        <FileJson size={17} />
        <span class="json-minify-tool__btn-text">{copy.loadExample}</span>
      </Button>
    </div>

    <div id="json-minify-error" class="tool-error" style="display: none;" role="alert"></div>

    <div id="json-minify-stats" class="json-minify-tool__stats" style="display: none;" role="status" aria-live="polite"></div>

    <div class="tool-note json-minify-tool__note">
      {copy.note}
    </div>
  </section>
</ToolWorkspace>

<script>
  const root = document.querySelector('.json-minify-tool') as HTMLElement | null;
  const input = document.getElementById('json-minify-input') as HTMLTextAreaElement | null;
  const output = document.getElementById('json-minify-output') as HTMLTextAreaElement | null;
  const errorDiv = document.getElementById('json-minify-error') as HTMLDivElement | null;
  const statsDiv = document.getElementById('json-minify-stats') as HTMLDivElement | null;
  const runButton = document.getElementById('json-minify-run') as HTMLButtonElement | null;
  const copyButton = document.getElementById('json-minify-copy') as HTMLButtonElement | null;
  const clearButton = document.getElementById('json-minify-clear') as HTMLButtonElement | null;
  const exampleButton = document.getElementById('json-minify-example') as HTMLButtonElement | null;

  const SAMPLE = JSON.stringify({
    name: "Belboore",
    version: 1.0,
    features: ["json", "tools", "open-source"],
    active: true,
    metadata: null
  }, null, 2);

  function getData(key: string, fallback: string): string {
    return root?.dataset[key] || fallback;
  }

  function runMinify() {
    if (!input || !output) return;
    const val = input.value.trim();
    if (!val) {
      output.value = '';
      output.placeholder = getData('empty', 'Minified JSON will appear here');
      if (errorDiv) window.__belbooreTools.clearErrorBox(errorDiv);
      if (statsDiv) statsDiv.style.display = 'none';
      return;
    }
    try {
      const parsed = JSON.parse(val);
      const minified = JSON.stringify(parsed);
      output.value = minified;
      output.placeholder = '';
      if (errorDiv) window.__belbooreTools.clearErrorBox(errorDiv);
      const inputBytes = new TextEncoder().encode(val).length;
      const outputBytes = new TextEncoder().encode(minified).length;
      const savedBytes = inputBytes - outputBytes;
      const inputChars = val.length;
      const outputChars = minified.length;
      const savedChars = inputChars - outputChars;
      if (statsDiv) {
        statsDiv.style.display = '';
        statsDiv.innerHTML = `
          <span>${getData('input-size', 'Input size')}: <strong>${inputBytes}</strong> ${getData('bytes', 'bytes')} (${inputChars} ${getData('chars', 'chars')})</span>
          <span class="json-minify-tool__stats-arrow">→</span>
          <span>${getData('output-size', 'Output size')}: <strong>${outputBytes}</strong> ${getData('bytes', 'bytes')} (${outputChars} ${getData('chars', 'chars')})</span>
          <span class="json-minify-tool__stats-saved">${getData('saved', 'Saved')}: <strong>${Math.max(0, savedBytes)}</strong> ${getData('bytes', 'bytes')} (${Math.max(0, savedChars)} ${getData('chars', 'chars')})</span>
        `;
      }
    } catch (e: any) {
      output.value = '';
      output.placeholder = getData('fix-errors', 'Fix the errors above and try again');
      if (errorDiv) window.__belbooreTools.setErrorBox(errorDiv, e?.message || getData('invalid-json', 'Invalid JSON'));
      if (statsDiv) statsDiv.style.display = 'none';
    }
  }

  runButton?.addEventListener('click', runMinify);

  copyButton?.addEventListener('click', () => {
    if (!output) return;
    const text = output.value;
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      copyButton.classList.add('is-copied');
      window.setTimeout(() => copyButton.classList.remove('is-copied'), 1200);
    }).catch(() => {});
  });

  clearButton?.addEventListener('click', () => {
    if (!input || !output) return;
    input.value = '';
    output.value = '';
    output.placeholder = getData('empty', 'Minified JSON will appear here');
    if (errorDiv) window.__belbooreTools.clearErrorBox(errorDiv);
    if (statsDiv) statsDiv.style.display = 'none';
    input.focus();
  });

  exampleButton?.addEventListener('click', () => {
    if (!input) return;
    input.value = SAMPLE;
    input.focus();
    runMinify();
  });

  input?.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
      event.preventDefault();
      runMinify();
    }
  });

  window.__belbooreTools.setCopyBtn('json-minify-copy', () => output?.value || '');
</script>

<style>
  .json-minify-tool {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .json-minify-tool__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .json-minify-tool__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid transparent;
    border-radius: calc(var(--radius-lg) - 4px);
    background: var(--surface-tertiary);
    transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .json-minify-tool__panel:focus-within {
    border-color: var(--color-tech-blue);
    box-shadow: 0 0 0 3px var(--color-tech-blue-subtle);
  }

  .json-minify-tool__panel-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .json-minify-tool__label {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .json-minify-tool__hint {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .json-minify-tool__textarea-shell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .json-minify-tool__textarea {
    width: 100%;
    min-height: 240px;
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--text-primary);
    background: var(--surface-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    resize: vertical;
    outline: none;
    transition: border-color var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .json-minify-tool__textarea:focus {
    border-color: var(--color-tech-blue);
    box-shadow: 0 0 0 3px var(--color-tech-blue-subtle);
  }

  .json-minify-tool__textarea::placeholder {
    color: var(--text-muted);
  }

  .json-minify-tool__textarea--output {
    background: var(--surface-secondary);
    resize: none;
  }

  .json-minify-tool__textarea--output:focus {
    border-color: var(--border-subtle);
    box-shadow: none;
  }

  .json-minify-tool__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .json-minify-tool .tool-action-button {
    min-width: 148px;
    margin-inline-end: auto;
  }

  .json-minify-tool__icon-btn.ui-button {
    width: 42px;
    min-width: 42px;
    min-height: 42px;
    padding: 0;
    gap: 0;
  }

  .json-minify-tool__btn-text {
    display: none;
  }

  .json-minify-tool__icn-btn {
    width: 42px;
    min-width: 42px;
    min-height: 42px;
    padding: 0;
    gap: 0;
  }

  .json-minify-tool__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .json-minify-tool__stats-arrow {
    color: var(--text-muted);
  }

  .json-minify-tool__stats-saved {
    margin-inline-start: auto;
    color: var(--color-success);
    font-weight: var(--weight-medium);
  }

  .json-minify-tool__note {
    margin-top: 0;
  }

  @media (max-width: 768px) {
    .json-minify-tool__grid {
      grid-template-columns: 1fr;
    }

    .json-minify-tool .tool-action-button {
      width: 100%;
      min-width: 0;
    }
  }
</style>
