---
import type { Lang } from '../../i18n/utils';
import { languages } from '../../i18n/utils';
import ToolWorkspace from './ToolWorkspace.astro';
import ToolPrimitives from './ToolPrimitives.astro';
import ToolUtils from './ToolUtils.astro';
import Button from '../ui/Button.astro';
import ToolActionButton from './ToolActionButton.astro';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const dir = languages[lang].dir;

const copy = {
  en: {
    title: 'Merge PDF',
    dropTitle: 'Drop PDF files here',
    dropHint: 'or click to select files',
    browse: 'Browse PDFs',
    fileList: 'Files to Merge',
    emptyList: 'No files added yet. Add PDF files to begin merging.',
    merge: 'Merge PDFs',
    merging: 'Merging...',
    clear: 'Clear All',
    download: 'Download Merged PDF',
    totalPages: 'Total Pages',
    totalSize: 'Total Size',
    moveUp: 'Move Up',
    moveDown: 'Move Down',
    remove: 'Remove',
    fileTooLarge: 'File is too large. Maximum size is 50 MB per file.',
    invalidFile: 'Please select valid PDF files.',
    mergeSuccess: 'PDFs merged successfully!',
    mergeFailed: 'Merge failed. The files may be corrupted or password-protected.',
    maxFiles: 'Maximum 20 files can be merged at once.',
    note: 'All PDF processing happens in your browser using PDF-Lib. No files are uploaded. Your documents stay private on your device.',
  },
  fa: {
    title: 'ادغام PDF',
    dropTitle: 'فایل‌های PDF را اینجا رها کنید',
    dropHint: 'یا کلیک کنید تا فایل انتخاب شود',
    browse: 'انتخاب PDF',
    fileList: 'فایل‌های مورد ادغام',
    emptyList: 'هنوز فایلی اضافه نشده است. برای شروع ادغام، فایل‌های PDF را اضافه کنید.',
    merge: 'ادغام PDFها',
    merging: 'در حال ادغام...',
    clear: 'پاک کردن همه',
    download: 'دانلود PDF ادغام شده',
    totalPages: 'مجموع صفحات',
    totalSize: 'حجم کل',
    moveUp: 'انتقال به بالا',
    moveDown: 'انتقال به پایین',
    remove: 'حذف',
    fileTooLarge: 'حجم فایل زیاد است. حداکثر حجم ۵۰ مگابایت برای هر فایل.',
    invalidFile: 'لطفاً فایل‌های PDF معتبر انتخاب کنید.',
    mergeSuccess: 'PDFها با موفقیت ادغام شدند!',
    mergeFailed: 'ادغام ناموفق بود. فایل‌ها ممکن است خراب یا محافظت شده با رمز عبور باشند.',
    maxFiles: 'حداکثر ۲۰ فایل را می‌توان همزمان ادغام کرد.',
    note: 'تمام پردازش PDF در مرورگر شما با استفاده از PDF-Lib انجام می‌شود. هیچ فایلی آپلود نمی‌شود. اسناد شما روی دستگاه شما خصوصی می‌مانند.',
  },
};
---

<ToolWorkspace title={copy[lang].title}>
  <ToolPrimitives />
  <ToolUtils />

  <div class="mpdf-tool">
    <div class="mpdf-layout">
      <div class="mpdf-sidebar">
        <div class="mpdf-dropzone" id="mpdf-dropzone" role="button" tabindex="0" aria-label="Upload PDF files">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="12" y1="18" x2="12" y2="12"/>
            <line x1="9" y1="15" x2="15" y2="15"/>
          </svg>
          <span class="mpdf-drop-title">{copy[lang].dropTitle}</span>
          <span class="mpdf-drop-hint">{copy[lang].dropHint}</span>
          <span class="mpdf-drop-action">{copy[lang].browse}</span>
        </div>
        <input id="mpdf-input" type="file" accept="application/pdf" multiple class="mpdf-input" aria-hidden="true" />
        <div id="mpdf-error" class="tool-error" style="display:none" role="alert"></div>
      </div>
      <div class="mpdf-main">
        <div id="mpdf-empty" class="tool-output tool-output--empty" role="status">{copy[lang].emptyList}</div>
        <div id="mpdf-list-area" class="mpdf-list-area" style="display:none">
          <div class="mpdf-section-title-row">
            <span class="mpdf-section-title">{copy[lang].fileList}</span>
            <span id="mpdf-stats" class="mpdf-stats"></span>
          </div>
          <ul id="mpdf-file-list" class="mpdf-file-list"></ul>
          <div class="tool-toolbar">
            <ToolActionButton id="mpdf-merge">{copy[lang].merge}</ToolActionButton>
            <Button id="mpdf-clear" variant="secondary">{copy[lang].clear}</Button>
          </div>
        </div>
        <div id="mpdf-result-area" class="mpdf-result-area" style="display:none">
          <div class="mpdf-section-title-row">
            <span class="mpdf-section-title">{copy[lang].mergeSuccess}</span>
            <span id="mpdf-result-pages" class="mpdf-stats"></span>
          </div>
          <div class="tool-toolbar">
            <Button id="mpdf-download" variant="primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {copy[lang].download}
            </Button>
          </div>
        </div>
      </div>
    </div>
    <div class="tool-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      {copy[lang].note}
    </div>
  </div>
</ToolWorkspace>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { formatFileSize, downloadBlob } from './mediaUtils.ts';

  const MAX_FILE_SIZE = 50 * 1024 * 1024;
  const MAX_FILES = 20;

  const input = document.getElementById('mpdf-input') as HTMLInputElement;
  const dropzone = document.getElementById('mpdf-dropzone')!;
  const errorEl = document.getElementById('mpdf-error')!;
  const emptyEl = document.getElementById('mpdf-empty')!;
  const listArea = document.getElementById('mpdf-list-area')!;
  const fileList = document.getElementById('mpdf-file-list')!;
  const statsEl = document.getElementById('mpdf-stats')!;
  const mergeBtn = document.getElementById('mpdf-merge')!;
  const clearBtn = document.getElementById('mpdf-clear')!;
  const resultArea = document.getElementById('mpdf-result-area')!;
  const resultPages = document.getElementById('mpdf-result-pages')!;
  const downloadBtn = document.getElementById('mpdf-download')!;

  interface PdfFile {
    id: string;
    file: File;
    pageCount: number;
  }

  let files: PdfFile[] = [];
  let mergedPdfBytes: Uint8Array | null = null;
  let idCounter = 0;

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.style.display = '';
  }

  function clearError() {
    errorEl.textContent = '';
    errorEl.style.display = 'none';
  }

  function genId(): string { return 'pdf-' + (++idCounter); }

  function addFiles(fileList: FileList) {
    clearError();
    const newFiles: File[] = [];
    for (let i = 0; i < fileList.length; i++) {
      const f = fileList[i];
      if (f.size > MAX_FILE_SIZE) {
        showError(copyFileTooLarge(f.name));
        continue;
      }
      if (f.type !== 'application/pdf' && !f.name.toLowerCase().endsWith('.pdf')) {
        showError(f.name + ': ' + copyInvalidFile());
        continue;
      }
      newFiles.push(f);
    }
    if (files.length + newFiles.length > MAX_FILES) {
      showError(copyMaxFiles());
      return;
    }
    if (newFiles.length === 0) return;
    let loaded = 0;
    newFiles.forEach(f => {
      getPdfPageCount(f).then(count => {
        files.push({ id: genId(), file: f, pageCount: count });
        loaded++;
        if (loaded === newFiles.length) {
          renderFileList();
          updateVisibility();
        }
      }).catch(() => {
        showError(f.name + ': ' + copyInvalidFile());
        loaded++;
        if (loaded === newFiles.length) {
          renderFileList();
          updateVisibility();
        }
      });
    });
  }

  function getPdfPageCount(file: File): Promise<number> {
    return file.arrayBuffer().then(buf => {
      return PDFDocument.load(buf, { ignoreEncryption: true }).then(doc => doc.getPageCount());
    });
  }

  async function loadPdfPageCounts() {
    for (const pf of files) {
      try {
        const buf = await pf.file.arrayBuffer();
        const doc = await PDFDocument.load(buf, { ignoreEncryption: true });
        pf.pageCount = doc.getPageCount();
      } catch { pf.pageCount = 0; }
    }
  }

  function renderFileList() {
    fileList.innerHTML = files.map((pf, idx) =>
      '<li class="mpdf-file-item" data-id="' + pf.id + '">' +
        '<div class="mpdf-file-info">' +
          '<svg class="mpdf-file-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' +
          '<div class="mpdf-file-text">' +
            '<span class="mpdf-file-name">' + esc(pf.file.name) + '</span>' +
            '<span class="mpdf-file-meta">' + pf.pageCount + ' page' + (pf.pageCount !== 1 ? 's' : '') + ' \u00b7 ' + formatFileSize(pf.file.size) + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="mpdf-file-actions">' +
          '<button type="button" class="mpdf-file-btn" data-action="up" ' + (idx === 0 ? 'disabled' : '') + ' aria-label="' + copyMoveUp() + '">\u2191</button>' +
          '<button type="button" class="mpdf-file-btn" data-action="down" ' + (idx === files.length - 1 ? 'disabled' : '') + ' aria-label="' + copyMoveDown() + '">\u2193</button>' +
          '<button type="button" class="mpdf-file-btn mpdf-file-btn--remove" data-action="remove" aria-label="' + copyRemove() + '">\u2715</button>' +
        '</div>' +
      '</li>'
    ).join('');

    const totalPages = files.reduce((s, pf) => s + pf.pageCount, 0);
    const totalSize = files.reduce((s, pf) => s + pf.file.size, 0);
    statsEl.textContent = files.length + ' file' + (files.length !== 1 ? 's' : '') + ' \u00b7 ' + totalPages + ' page' + (totalPages !== 1 ? 's' : '') + ' \u00b7 ' + formatFileSize(totalSize);

    fileList.querySelectorAll('.mpdf-file-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const li = (e.target as HTMLElement).closest('.mpdf-file-item') as HTMLLIElement;
        if (!li) return;
        const id = li.dataset.id;
        const action = (e.target as HTMLElement).dataset.action;
        if (!id || !action) return;
        const idx = files.findIndex(pf => pf.id === id);
        if (idx === -1) return;
        if (action === 'up' && idx > 0) {
          [files[idx - 1], files[idx]] = [files[idx], files[idx - 1]];
          renderFileList();
        } else if (action === 'down' && idx < files.length - 1) {
          [files[idx], files[idx + 1]] = [files[idx + 1], files[idx]];
          renderFileList();
        } else if (action === 'remove') {
          files.splice(idx, 1);
          renderFileList();
          updateVisibility();
        }
        hideResult();
      });
    });
  }

  function updateVisibility() {
    if (files.length === 0) {
      emptyEl.style.display = '';
      listArea.style.display = 'none';
    } else {
      emptyEl.style.display = 'none';
      listArea.style.display = '';
    }
  }

  function hideResult() {
    resultArea.style.display = 'none';
    mergedPdfBytes = null;
  }

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  input.addEventListener('change', () => {
    if (input.files?.length) addFiles(input.files);
    input.value = '';
  });

  dropzone.addEventListener('click', () => input.click());
  dropzone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') input.click(); });
  ['dragenter', 'dragover'].forEach(ev => {
    dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.add('is-dragover'); });
  });
  ['dragleave', 'drop'].forEach(ev => {
    dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.remove('is-dragover'); });
  });
  dropzone.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer;
    if (dt?.files?.length) addFiles(dt.files);
  });

  clearBtn.addEventListener('click', () => {
    files = [];
    mergedPdfBytes = null;
    renderFileList();
    updateVisibility();
    hideResult();
    clearError();
  });

  mergeBtn.addEventListener('click', async () => {
    if (files.length === 0) return;
    clearError();
    mergeBtn.textContent = copyMerging();
    (mergeBtn as HTMLButtonElement).disabled = true;
    hideResult();

    try {
      const mergedPdf = await PDFDocument.create();
      for (const pf of files) {
        const buf = await pf.file.arrayBuffer();
        const srcDoc = await PDFDocument.load(buf, { ignoreEncryption: true });
        const pageIndices = srcDoc.getPageIndices();
        const copiedPages = await mergedPdf.copyPages(srcDoc, pageIndices);
        copiedPages.forEach(page => mergedPdf.addPage(page));
      }
      mergedPdfBytes = await mergedPdf.save();
      resultPages.textContent = mergedPdf.getPageCount() + ' page' + (mergedPdf.getPageCount() !== 1 ? 's' : '');
      resultArea.style.display = '';
    } catch {
      showError(copyMergeFailed());
    }
    mergeBtn.textContent = copyMerge();
    (mergeBtn as HTMLButtonElement).disabled = false;
  });

  downloadBtn.addEventListener('click', () => {
    if (!mergedPdfBytes) return;
    const blob = new Blob([mergedPdfBytes], { type: 'application/pdf' });
    downloadBlob(blob, 'merged.pdf');
  });

  function copyFileTooLarge(name: string): string { return name + ': ' + copyInvalidFile(); }
  function copyInvalidFile(): string { return 'Please select valid PDF files.'; }
  function copyMaxFiles(): string { return 'Maximum 20 files can be merged at once.'; }
  function copyMoveUp(): string { return 'Move Up'; }
  function copyMoveDown(): string { return 'Move Down'; }
  function copyRemove(): string { return 'Remove'; }
  function copyMerge(): string { return 'Merge PDFs'; }
  function copyMerging(): string { return 'Merging...'; }
  function copyMergeFailed(): string { return 'Merge failed. The files may be corrupted or password-protected.'; }
</script>

<style>
  .mpdf-tool { display: flex; flex-direction: column; gap: var(--space-5); }
  .mpdf-tool .tool-note { margin-top: 0; }
  .mpdf-layout { display: grid; grid-template-columns: 1fr 1.5fr; gap: var(--space-6); align-items: start; }
  .mpdf-sidebar, .mpdf-main { display: flex; flex-direction: column; gap: var(--space-4); }
  .mpdf-input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .mpdf-dropzone { display: flex; flex-direction: column; gap: var(--space-2); align-items: center; justify-content: center; min-height: 200px; width: 100%; padding: var(--space-6); border-radius: var(--radius-lg); border: 2px dashed var(--border-default); background: var(--surface-secondary); color: var(--text-secondary); cursor: pointer; transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out); text-align: center; }
  .mpdf-dropzone:hover, .mpdf-dropzone.is-dragover { border-color: var(--color-tech-blue); background: var(--color-tech-blue-subtle); }
  .mpdf-dropzone:focus-visible { outline: 2px solid var(--color-tech-blue); outline-offset: 3px; }
  .mpdf-drop-title { font-weight: var(--weight-semibold); color: var(--text-primary); }
  .mpdf-drop-hint { font-size: var(--text-sm); color: var(--text-muted); }
  .mpdf-drop-action { margin-top: var(--space-1); padding: var(--space-2) var(--space-4); border-radius: var(--radius-md); background: var(--surface-primary); border: 1px solid var(--border-default); font-size: var(--text-sm); color: var(--text-primary); }
  .mpdf-section-title-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .mpdf-section-title { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; }
  .mpdf-stats { font-size: var(--text-xs); font-weight: var(--weight-semibold); color: var(--text-tertiary); background: var(--surface-tertiary); padding: var(--space-1) var(--space-3); border-radius: var(--radius-full); }
  .mpdf-file-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .mpdf-file-item { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-primary); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); transition: border-color var(--duration-fast) var(--ease-out); }
  .mpdf-file-item:hover { border-color: var(--border-default); }
  .mpdf-file-info { display: flex; align-items: center; gap: var(--space-3); min-width: 0; flex: 1; }
  .mpdf-file-icon { flex-shrink: 0; color: var(--color-tech-blue); }
  .mpdf-file-text { display: flex; flex-direction: column; gap: var(--space-0); min-width: 0; }
  .mpdf-file-name { font-size: var(--text-sm); font-weight: var(--weight-medium); color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mpdf-file-meta { font-size: var(--text-xs); color: var(--text-tertiary); }
  .mpdf-file-actions { display: flex; gap: var(--space-1); flex-shrink: 0; }
  .mpdf-file-btn { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); background: var(--surface-primary); color: var(--text-secondary); cursor: pointer; font-size: var(--text-sm); transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out); padding: 0; line-height: 1; }
  .mpdf-file-btn:hover:not(:disabled) { border-color: var(--border-default); background: var(--surface-secondary); }
  .mpdf-file-btn:disabled { opacity: 0.4; cursor: default; }
  .mpdf-file-btn--remove:hover:not(:disabled) { border-color: var(--color-error-border); color: var(--color-error); background: var(--color-error-subtle); }
  .mpdf-result-area { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-4); background: var(--color-success-subtle); border: 1px solid var(--color-success-border); border-radius: var(--radius-md); }
  @media (max-width: 768px) { .mpdf-layout { grid-template-columns: 1fr; } }
</style>
