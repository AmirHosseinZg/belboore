---
interface Props {
  id: string;
  label: string;
  hint?: string;
  placeholder?: string;
  type?: string;
  inputmode?: string;
  autocomplete?: string;
  value?: string | number;
  name?: string;
  className?: string;
  inputClassName?: string;
  readonly?: boolean;
  disabled?: boolean;
  spellcheck?: boolean;
}

const {
  id,
  label,
  hint,
  placeholder = '',
  type = 'text',
  inputmode = 'text',
  autocomplete = 'off',
  value,
  name,
  className = '',
  inputClassName = '',
  readonly = false,
  disabled = false,
  spellcheck,
  ...rest
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
---

<div class:list={['ui-input-field', className]}>
  <div class="ui-input-field__shell">
    <label class="ui-input-field__label" for={id}>{label}</label>
    <input
      id={id}
      name={name}
      class:list={['ui-input-field__control', inputClassName]}
      type={type}
      inputmode={inputmode}
      autocomplete={autocomplete}
      placeholder={placeholder}
      value={value}
      aria-describedby={hintId}
      readonly={readonly}
      disabled={disabled}
      spellcheck={spellcheck}
      {...rest}
    />
  </div>
  {hint && <p id={hintId} class="ui-input-field__hint">{hint}</p>}
</div>

<style>
  .ui-input-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .ui-input-field__shell {
    position: relative;
  }

  .ui-input-field__label {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: 0;
    transform: translateY(-50%);
    z-index: 1;
    padding-inline: var(--space-2);
    background: var(--surface-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--color-tech-blue);
    pointer-events: none;
  }

  .ui-input-field__control {
    width: 100%;
    min-height: 46px;
    padding: var(--space-3) var(--space-4);
    border: 1.5px solid color-mix(in srgb, var(--color-tech-blue) 75%, white 25%);
    border-radius: var(--radius-md);
    background: var(--surface-primary);
    color: var(--text-primary);
    font: inherit;
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    outline: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .ui-input-field__control::placeholder {
    color: var(--text-muted);
  }

  .ui-input-field__control:hover {
    border-color: var(--color-tech-blue);
  }

  .ui-input-field__control:focus {
    border-color: var(--color-tech-blue);
    box-shadow: 0 0 0 4px var(--color-tech-blue-subtle);
  }

  .ui-input-field__control:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    background: var(--surface-secondary);
  }

  .ui-input-field__hint {
    margin: 0;
    padding-inline: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    line-height: var(--leading-snug);
  }

  [data-theme='dark'] .ui-input-field__label {
    background: var(--surface-primary);
  }

  [data-theme='dark'] .ui-input-field__control {
    background: var(--surface-elevated);
    border-color: color-mix(in srgb, var(--color-tech-blue) 78%, rgba(255, 255, 255, 0.14));
  }
</style>
