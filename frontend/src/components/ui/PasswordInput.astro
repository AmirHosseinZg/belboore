---
import Input from './Input.astro';

interface Props {
  id: string;
  label: string;
  placeholder?: string;
  inputClassName?: string;
  className?: string;
  disabled?: boolean;
  autocomplete?: string;
  spellcheck?: boolean;
}

const {
  id,
  label,
  placeholder = '',
  inputClassName = '',
  className = '',
  disabled = false,
  autocomplete = 'off',
  spellcheck,
} = Astro.props;
---

<div class:list={['password-input', className]} data-pw-id={id}>
  <div class="password-input__shell">
    <Input
      id={id}
      label={label}
      type="password"
      placeholder={placeholder}
      inputClassName={inputClassName}
      disabled={disabled}
      autocomplete={autocomplete}
      spellcheck={spellcheck}
    />
    <button
      id={`${id}-toggle`}
      class="password-input__toggle"
      type="button"
      aria-label="Toggle password visibility"
      tabindex="-1"
    >
      <svg class="password-input__eye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      <svg class="password-input__eye-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
    </button>
  </div>
</div>

<style>
  .password-input__shell {
    position: relative;
  }
  .password-input__toggle {
    position: absolute;
    inset-inline-end: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: var(--space-2);
    color: var(--text-tertiary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }
  .password-input__toggle:hover {
    color: var(--text-primary);
    background: var(--surface-tertiary);
  }
</style>

<script>
  document.querySelectorAll('.password-input[data-pw-id]').forEach(wrapper => {
    const id = wrapper.getAttribute('data-pw-id');
    if (!id) return;
    const input = document.getElementById(id) as HTMLInputElement;
    const toggle = document.getElementById(`${id}-toggle`);
    if (!input || !toggle) return;

    toggle.addEventListener('click', () => {
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      const eye = toggle.querySelector('.password-input__eye') as HTMLElement;
      const eyeOff = toggle.querySelector('.password-input__eye-off') as HTMLElement;
      if (eye && eyeOff) {
        eye.style.display = isPassword ? 'none' : '';
        eyeOff.style.display = isPassword ? '' : 'none';
      }
    });
  });
</script>
