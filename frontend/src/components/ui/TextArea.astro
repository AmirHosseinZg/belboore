---
interface Props {
  id?: string;
  name?: string;
  label?: string;
  hint?: string;
  placeholder?: string;
  rows?: number;
  value?: string;
  readonly?: boolean;
  className?: string;
  fieldClassName?: string;
}

const {
  id,
  name,
  label,
  hint,
  placeholder = '',
  rows = 6,
  value = '',
  readonly = false,
  className = '',
  fieldClassName = '',
  ...rest
} = Astro.props;

const hintId = hint && id ? `${id}-hint` : undefined;
---

{label || hint ? (
  <div class:list={['ui-textarea-field', fieldClassName]}>
    <div class="ui-textarea-field__shell">
      {label && <label class="ui-textarea-field__label" for={id}>{label}</label>}
      <textarea
        id={id}
        name={name}
        class:list={['ui-textarea', className]}
        placeholder={placeholder}
        rows={rows}
        readonly={readonly}
        aria-describedby={hintId}
        dir="auto"
        {...rest}
      >{value}</textarea>
    </div>
    {hint && <p id={hintId} class="ui-textarea-field__hint">{hint}</p>}
  </div>
) : (
  <textarea
    id={id}
    name={name}
    class:list={['ui-textarea', className]}
    placeholder={placeholder}
    rows={rows}
    readonly={readonly}
    dir="auto"
    {...rest}
  >{value}</textarea>
)}

<style>
  .ui-textarea-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .ui-textarea-field__shell {
    position: relative;
  }

  .ui-textarea-field__label {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: 0;
    transform: translateY(-50%);
    z-index: 1;
    padding-inline: var(--space-2);
    background: var(--surface-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--color-tech-blue);
    pointer-events: none;
  }

  .ui-textarea {
    width: 100%;
    min-height: 160px;
    padding: var(--space-4);
    font-family: inherit;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--text-primary);
    background: var(--surface-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    outline: none;
    resize: vertical;
    unicode-bidi: plaintext;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .ui-textarea::placeholder {
    color: var(--text-muted);
  }

  .ui-textarea:focus {
    border-color: var(--color-tech-blue);
    box-shadow: 0 0 0 3px var(--color-tech-blue-subtle);
  }

  .ui-textarea-field__hint {
    margin: 0;
    padding-inline: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    line-height: var(--leading-snug);
  }

  [data-theme='dark'] .ui-textarea-field__label {
    background: var(--surface-primary);
  }

  [data-theme='dark'] .ui-textarea {
    background: var(--surface-elevated);
    border-color: var(--border-default);
  }
</style>
