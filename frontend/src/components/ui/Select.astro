---
import { ChevronDown } from '@lucide/astro';

interface SelectOption {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name?: string;
  options: SelectOption[];
  selectedValue?: string;
  label?: string;
  hint?: string;
  className?: string;
  selectClassName?: string;
  disabled?: boolean;
}

const {
  id,
  name,
  options = [],
  selectedValue,
  label,
  hint,
  className = '',
  selectClassName = '',
  disabled = false,
  ...rest
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
---

<div class:list={['ui-select-field', className]}>
  <div class="ui-select-field__shell">
    {label && <label class="ui-select-field__label" for={id}>{label}</label>}
    <select
      id={id}
      name={name}
      class:list={['ui-select-field__control', selectClassName]}
      aria-describedby={hintId}
      disabled={disabled}
      {...rest}
    >
      {options.map((option) => (
        <option value={option.value} selected={option.value === selectedValue}>
          {option.label}
        </option>
      ))}
    </select>
    <span class="ui-select-field__arrow" aria-hidden="true">
      <ChevronDown size={18} />
    </span>
  </div>
  {hint && <p id={hintId} class="ui-select-field__hint">{hint}</p>}
</div>

<style>
  .ui-select-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .ui-select-field__shell {
    position: relative;
  }

  .ui-select-field__label {
    position: absolute;
    inset-inline-start: var(--space-4);
    top: 0;
    transform: translateY(-50%);
    z-index: 1;
    padding-inline: var(--space-2);
    background: var(--surface-primary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1;
    color: var(--color-tech-blue);
    pointer-events: none;
  }

  .ui-select-field__control {
    appearance: none;
    width: 100%;
    min-height: 46px;
    padding: var(--space-3) calc(var(--space-8) + var(--space-2)) var(--space-3) var(--space-4);
    color: var(--text-primary);
    font: inherit;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-primary) 98%, transparent), color-mix(in srgb, var(--surface-secondary) 74%, transparent));
    border: 1.5px solid color-mix(in srgb, var(--color-tech-blue) 75%, white 25%);
    border-radius: var(--radius-md);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--surface-elevated) 64%, transparent),
      var(--shadow-sm);
    outline: none;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .ui-select-field__control:hover {
    border-color: var(--color-tech-blue);
    transform: translateY(-1px);
  }

  .ui-select-field__control:focus {
    border-color: var(--color-tech-blue);
    box-shadow:
      0 0 0 4px var(--color-tech-blue-subtle),
      inset 0 1px 0 color-mix(in srgb, var(--surface-elevated) 64%, transparent),
      var(--shadow-sm);
  }

  .ui-select-field__control:disabled {
    opacity: 0.65;
    cursor: not-allowed;
    background: var(--surface-secondary);
  }

  .ui-select-field__arrow {
    position: absolute;
    inset-inline-end: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-tech-blue);
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ui-select-field__hint {
    margin: 0;
    padding-inline: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    line-height: var(--leading-snug);
  }

  [data-theme='dark'] .ui-select-field__label {
    background: var(--surface-primary);
  }

  [data-theme='dark'] .ui-select-field__control {
    background:
      linear-gradient(180deg, var(--surface-elevated), var(--surface-tertiary));
    border-color: color-mix(in srgb, var(--color-tech-blue) 78%, rgba(255, 255, 255, 0.14));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      var(--shadow-sm);
  }
</style>
